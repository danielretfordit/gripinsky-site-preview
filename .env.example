# Скопируйте в .env (локально) или в /etc/gripinsky/env (сервер, права 0600) и заполните.
# Файл .env в git не попадает. Значения секретов не пересылать в чат и почту.

# --- Оформление заказа ---
# demo: заявка в CRM без оплаты; getcourse: заказ и оплата в GetCourse; robokassa: прямая оплата Robokassa
CHECKOUT_MODE=demo

# --- GetCourse (секреты) ---
GETCOURSE_ACCOUNT=
GETCOURSE_API_KEY=

# --- Robokassa (секреты) ---
ROBOKASSA_LOGIN=
ROBOKASSA_PASS1=
ROBOKASSA_PASS2=
# Обязательно явно: true для тестовых платежей, false для боевых. Без значения прямая оплата не включится.
ROBOKASSA_IS_TEST=true
ROBOKASSA_HASH=sha256
# База заказов Robokassa (на сервере /var/lib/gripinsky/orders.db)
ORDERS_DB=./var/orders.db

# --- Bitrix24 (секрет: адрес вебхука содержит ключ) ---
B24_WEBHOOK_URL=

# --- Сервер ---
# true за nginx: IP клиента из X-Real-IP (ограничение частоты запросов)
TRUST_PROXY=false
# Ключ для /api/admin/status (состояние интеграций без значений секретов)
ADMIN_STATUS_TOKEN=

# --- Админка Keystatic в режиме GitHub (сервер) ---
KEYSTATIC_STORAGE=local
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Публичные (попадают в браузер) ---
PUBLIC_YM_ID=97121693
PUBLIC_ANALYTICS=false
PUBLIC_INDEXABLE=false
# true только для промежуточной публикации на GitHub Pages: плашка «демо», черновики /design остаются
PUBLIC_STATIC_PREVIEW=false
