    "@keystatic/core": "0.6.9",
    "@nanostores/preact": "1.1.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "nanostores": "1.5.4",
    "preact": "10.29.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
