---
import '../styles/global.css';
import SiteCart from '../islands/SiteCart';
import Checkout from '../islands/Checkout';
import { getCatalog } from '../lib/catalog';
import { STATIC_PREVIEW } from '../lib/deployment';
import { Font } from 'astro:assets';
import { PUBLIC_INDEXABLE } from 'astro:env/client';
import { getEntry } from 'astro:content';
import { getPageSeo } from '../lib/page-seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Analytics from '../components/Analytics.astro';
import ConsultSection from '../components/ConsultSection.astro';
import { canonicalUrl, absUrl, breadcrumbLd, organizationLd, ogHref, OG_W, OG_H, YANDEX_VERIFICATION, type Crumb } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Картинка для соцсетей 1200×630: ogHref('course-…') из lib/seo */
  ogImage?: string;
  ogType?: 'website' | 'article';
  breadcrumbs?: Crumb[];
  jsonLd?: object[];
  noindex?: boolean;
  /** Блок консультации перед подвалом */
  consult?: boolean;
  consultContext?: string;
}

const { title, description, ogImage, ogType = 'website', breadcrumbs, jsonLd = [], noindex = false, consult = true, consultContext = '' } = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;
const cartCatalog = await getCatalog();
const routeSeo = await getPageSeo(Astro.url.pathname);
const resolvedTitle = routeSeo?.title || title;
const resolvedDescription = routeSeo?.description || description;
const canonical = routeSeo?.canonical || canonicalUrl(Astro.url.pathname);
const robots = !PUBLIC_INDEXABLE || noindex || routeSeo?.noindex ? 'noindex, nofollow' : 'index, follow';
const og = absUrl(routeSeo?.ogImage || ogImage || ogHref('default'));
const ld = [organizationLd(site), ...(breadcrumbs?.length ? [breadcrumbLd(breadcrumbs)] : []), ...jsonLd];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="yandex-verification" content={YANDEX_VERIFICATION} />
    <meta name="theme-color" content="#111313" />
    <meta name="color-scheme" content="dark" />
    {/* Ширина окна без полосы прокрутки для полей страницы (--site-gutter). На телефоне совпадает с 100vw. */}
    {/* До отрисовки: ширина окна без полосы прокрутки и пометка встроенного браузера (Telegram, VK, WebView) на <html> */}
    <script is:inline>(function(){var d=document.documentElement,s=function(){d.style.setProperty('--page-w',d.clientWidth+'px')};s();if(window.ResizeObserver)new ResizeObserver(s).observe(d);else addEventListener('resize',s);var u=navigator.userAgent,k='TelegramWebviewProxy'in window||/Telegram/i.test(u)?'telegram':/VKClient|VKAndroidApp|vk_app/i.test(u)?'vk':/Instagram|FBAN|FBAV/i.test(u)?'social':/; wv\)/.test(u)?'webview':'';if(k)d.classList.add('is-inapp','is-inapp-'+k)})();</script>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Академия 3D GRIPINSKY" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_W)} />
    <meta property="og:image:height" content={String(OG_H)} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body class:list={{ 'site-home': Astro.url.pathname === '/' }}>
    <a class="skip-link" href="#main">К содержанию</a>
    {STATIC_PREVIEW && <div class="border-b border-line bg-surface px-5 py-2 text-center t-small text-ink-2" role="note">Промежуточная версия сайта. Заявки и оплата пока не подключены.</div>}
    <Header consult={consult} />
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
      {consult && <ConsultSection context={consultContext} />}
    </main>
    <slot name="after-main" />
    <Footer consult={consult} />
    <SiteCart client:load cat={cartCatalog} discountGuide={["/design/visualization/professions", "/courses-page/visualization", "/courses-page/gamedev"].includes(Astro.url.pathname)} />
    <Checkout client:load cat={cartCatalog} telegramBot={site.telegramBot} />
    <CookieBanner />
    <Analytics />
    <script>
      // Телефон: пока открыта клавиатура (фокус в поле), нижние панели прячутся и не закрывают поле и кнопку
      const fields = 'input:not([type=checkbox]):not([type=radio]):not([type=hidden]), textarea, select';
      if (matchMedia('(pointer: coarse)').matches) {
        document.addEventListener('focusin', (e) => { if ((e.target as Element).matches?.(fields)) document.documentElement.classList.add('is-typing'); });
        document.addEventListener('focusout', () => setTimeout(() => { if (!document.activeElement?.matches?.(fields)) document.documentElement.classList.remove('is-typing'); }, 80));
      }
    </script>
  </body>
</html>
