---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { PUBLIC_INDEXABLE } from 'astro:env/client';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Analytics from '../components/Analytics.astro';
import ConsultSection from '../components/ConsultSection.astro';
import { canonicalUrl, absUrl, breadcrumbLd, organizationLd, type Crumb } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Абсолютный или корневой путь к картинке для соцсетей */
  ogImage?: string;
  breadcrumbs?: Crumb[];
  jsonLd?: object[];
  noindex?: boolean;
  /** Блок консультации перед подвалом */
  consult?: boolean;
  consultContext?: string;
}

const { title, description, ogImage, breadcrumbs, jsonLd = [], noindex = false, consult = true, consultContext = '' } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
const robots = !PUBLIC_INDEXABLE || noindex ? 'noindex, nofollow' : 'index, follow';
const og = absUrl(ogImage ?? '/og-default.jpg');
const ld = [organizationLd, ...(breadcrumbs?.length ? [breadcrumbLd(breadcrumbs)] : []), ...jsonLd];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0D2023" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Академия 3D GRIPINSKY" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-inter-tight" preload />
    <Font cssVariable="--font-caveat" />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
      {consult && <ConsultSection context={consultContext} />}
    </main>
    <slot name="after-main" />
    <Footer />
    <CookieBanner />
    <Analytics />
  </body>
</html>
