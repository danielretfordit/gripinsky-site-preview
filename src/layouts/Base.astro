---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { PUBLIC_INDEXABLE } from 'astro:env/client';
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Analytics from '../components/Analytics.astro';
import ConsultSection from '../components/ConsultSection.astro';
import { canonicalUrl, absUrl, breadcrumbLd, organizationLd, ogHref, OG_W, OG_H, YANDEX_VERIFICATION, type Crumb } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Картинка для соцсетей 1200×630: ogHref('course-…') из lib/seo */
  ogImage?: string;
  ogType?: 'website' | 'article';
  breadcrumbs?: Crumb[];
  jsonLd?: object[];
  noindex?: boolean;
  /** Блок консультации перед подвалом */
  consult?: boolean;
  consultContext?: string;
}

const { title, description, ogImage, ogType = 'website', breadcrumbs, jsonLd = [], noindex = false, consult = true, consultContext = '' } = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;
const canonical = canonicalUrl(Astro.url.pathname);
const robots = !PUBLIC_INDEXABLE || noindex ? 'noindex, nofollow' : 'index, follow';
const og = absUrl(ogImage ?? ogHref('default'));
const ld = [organizationLd(site), ...(breadcrumbs?.length ? [breadcrumbLd(breadcrumbs)] : []), ...jsonLd];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="yandex-verification" content={YANDEX_VERIFICATION} />
    <meta name="theme-color" content="#0E1112" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Академия 3D GRIPINSKY" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_W)} />
    <meta property="og:image:height" content={String(OG_H)} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-onest" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>
    <Header consult={consult} />
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
      {consult && <ConsultSection context={consultContext} />}
    </main>
    <slot name="after-main" />
    <Footer consult={consult} />
    <CookieBanner />
    <Analytics />
  </body>
</html>
