---
import { Image } from 'astro:assets';
import { isListed } from '../lib/categories';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { heroCoverIds } from '../lib/hero-covers';
import HeroWork from '../components/HeroWork.astro';
import HeroActions from '../components/HeroActions.astro';
import TrustBlock from '../components/TrustBlock.astro';
import StatsRibbon from '../components/StatsRibbon.astro';
import WorksShowcase from '../components/WorksShowcase.astro';
import AiFeature from '../components/AiFeature.astro';
import CommunityFeature from '../components/CommunityFeature.astro';
import Faq from '../components/Faq.astro';
import Quiz from '../islands/Quiz';
import { getCatalog } from '../lib/catalog';
import { faqLd } from '../lib/views';
import { websiteLd } from '../lib/seo';
import { workViews } from '../lib/works';
import { rub, plural } from '../lib/format';

// Программы: иконка, подпись и значение фильтра каталога (/courses?soft=…)
const SOFTWARE = {
  '3dsmax': { name: '3ds Max', tag: '3DS MAX' },
  corona: { name: 'Corona', tag: 'CORONA RENDERER' },
  vray: { name: 'V-Ray', tag: 'V-RAY' },
  forestpack: { name: 'Forest Pack', tag: 'FOREST PACK' },
  photoshop: { name: 'Photoshop', tag: 'ADOBE PHOTOSHOP' },
  blender: { name: 'Blender', tag: 'BLENDER' },
  zbrush: { name: 'ZBrush', tag: 'ZBRUSH' },
  unreal: { name: 'Unreal Engine', tag: 'UNREAL ENGINE' },
  maya: { name: 'Maya', tag: 'MAYA' },
  substance: { name: 'Substance Painter', tag: 'SUBSTANCE PAINTER' },
} as const;
type SoftId = keyof typeof SOFTWARE;
// Счётчик и ссылка должны совпадать с вкладкой «Курсы» каталога: отдельные курсы + готовая База.
const listed = await getCollection('courses', (c) => isListed(c.data) && (c.data.type === 'course' || c.id === 'baza'));
const softCount = (id: SoftId) => listed.filter((c) => c.data.software.includes(SOFTWARE[id].tag)).length;
const softHref = (id: SoftId) => `/courses?type=course&soft=${encodeURIComponent(SOFTWARE[id].tag.toLowerCase())}#catalog-filters`;
const programs = (Object.keys(SOFTWARE) as SoftId[])
  .map((id) => ({ id, name: SOFTWARE[id].name, count: softCount(id), href: softHref(id) }))
  .filter((program) => program.count > 0);

const site = (await getEntry('settings', 'site'))!.data;
const s = site.stats;
const cat = await getCatalog();
const homeFaqIds = ['s-chego-nachat', 'risovat', 'vremya', 'oplata', 'vozvrat'];
const faq = await faqLd('home', homeFaqIds);
const wv = await workViews();
// Первый кадр повторяет референс; дальше автоматически сменяются другие опубликованные работы учеников.
const heroSlides = wv.pick(heroCoverIds);
const hero = heroSlides[0] ?? wv.work('bolshunova-ostrov-1') ?? wv.pick(['tveritin-druzhba', 'rossoshansky-gostinaya'])[0];
const wide = wv.work('tveritin-druzhba');
const trio = wv.pick(['kamola-kuhnya', 'korotovskaya-shale', 'shesterikova-loft']);

const dirViz = wv.work('bolshunova-banya-1') ?? wv.work('bolshunova-ostrov-1') ?? wv.work('rossoshansky-gostinaya');
const dirGame = wv.work('gitsuk-korabl') ?? wv.work('bagirov-korabl');
const ai = (await getEntry('courses', 'ai'))!.data;
const stats = [
  { value: s.graduates, label: 'выпускников' },
  { value: s.years, label: 'учим по своей системе' },
  { value: s.videos, label: 'видеоуроков' },
  { value: s.rating, label: 'на Яндекс Картах', href: site.yandexMaps },
  { value: s.subscribers, label: 'подписчиков на YouTube', href: site.youtube },
];
---
<Base
  title="Онлайн-курсы 3D-графики и визуализации с нуля | Академия 3D GRIPINSKY"
  description={`Онлайн-курсы 3D-визуализации интерьеров и экстерьеров, моделирования и 3D для игр с нуля. ${s.graduates} выпускников, портфолио за время учёбы, бесплатные уроки и рассрочка.`}
  jsonLd={[websiteLd, faq]}
  consultContext="Главная"
>
  {hero && (
    <HeroWork work={hero} slides={heroSlides.length ? heroSlides : [hero]} kicker="Онлайн-школа 3D-графики" id="home-title">
      <h1 slot="title" id="home-title" class="t-hero">Курсы <span class="whitespace-nowrap">3D-графики</span> <span class="t-accent block">с нуля до заказов</span></h1>
      <p slot="lead" class="t-lead m-0 max-w-[540px]">Визуализация интерьеров и экстерьеров, 3D для игр и нейросети в работе. В своём темпе, без опыта и умения рисовать.</p>
      <Fragment slot="cta">
        <HeroActions primaryHref="#directions" primaryLabel="Выбрать направление" secondaryHref="#quiz" secondaryLabel="Подобрать курс за 1 минуту" />
      </Fragment>
    </HeroWork>
  )}

  <StatsRibbon stats={stats} />

  <section id="directions" class="wrap section" aria-labelledby="dir-title">
    <div id="programs" class="head">
      <p class="t-overline m-0">Направления и программы</p>
      <h2 id="dir-title" class="t-h2" tabindex="-1">Выберите <span class="t-accent">курс</span></h2>
      <p class="directions-intro text-ink-2">Начните с направления, если выбираете профессию. Или сразу найдите курсы по программе, если уже знаете, что нужно.</p>
    </div>

    <div role="tablist" aria-label="Способ выбора курса" class="program-tabs" data-pick-tabs>
      <button type="button" role="tab" id="pick-tab-dir" aria-controls="pick-dir" aria-selected="true" tabindex="0"
        class="program-tab">По направлению</button>
      <button type="button" role="tab" id="pick-tab-soft" aria-controls="pick-soft" aria-selected="false" tabindex="-1"
        class="program-tab">По программе</button>
    </div>

    <div role="tabpanel" id="pick-dir" aria-labelledby="pick-tab-dir" class="grid gap-x-[var(--gap-grid)] gap-y-12 md:grid-cols-2">
      {[
        { w: dirViz, href: '/courses-page/visualization', title: '3D-визуализация', text: 'Фотореалистичные интерьеры и экстерьеры в 3ds Max и Corona.', meta: '3 профессии', cta: 'Выбрать профессию' },
        { w: dirGame, href: '/courses-page/gamedev', title: '3D для игр', text: 'Предметы, локации и персонажи в Blender, ZBrush и Unreal Engine.', meta: '6 профессий', cta: 'Выбрать профессию' },
      ].map((d, index) => (
        <article class="content-card zoom relative flex flex-col gap-5">
          <a href={d.href} class="absolute inset-0 z-20" aria-label={d.title}><span class="sr-only">{d.title}</span></a>
          {d.w && (
            <div class="media-frame media-frame--card relative">
              <Image src={d.w.image} alt={d.w.alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" style={`object-position:${d.w.focus}`} />
              <span class="direction-number">0{index + 1} / НАПРАВЛЕНИЕ</span>
              <span class="direction-arrow" aria-hidden="true">↗</span>
            </div>
          )}
          <div class="content-card__body flex flex-1 flex-col gap-3">
            <p class="t-meta direction-meta">{d.meta}</p>
            <h3 class="t-h3 text-ink">{d.title}</h3>
            <p class="m-0 max-w-[520px] text-ink-2">{d.text}</p>
            <p class="direction-cta m-0 mt-auto border-t border-line pt-4 text-right">
              <span class="font-semibold text-ink" data-cta>{d.cta} <b aria-hidden="true">→</b></span>
            </p>
          </div>
        </article>
      ))}
    </div>

    <div role="tabpanel" id="pick-soft" aria-labelledby="pick-tab-soft" hidden>
      <div class="program-index-head">
        <p class="t-overline">{programs.length} программ / один каталог</p>
        <p>Выберите знакомую программу и перейдите к курсам по ней.</p>
      </div>
      <ol class="program-index" style={`--program-rows:${Math.ceil(programs.length / 2)}`} aria-label="Курсы по программе">
        {programs.map((program, index) => (
          <li class:list={{ 'program-index-last-left': index === Math.ceil(programs.length / 2) - 1 }}>
            <a href={program.href}>
              <span class="program-index-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <strong class="program-index-name">{program.name}</strong>
              <span class="program-index-count">{program.count} {plural(program.count, ['курс', 'курса', 'курсов'])}</span>
              <span class="program-index-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div class="direction-links">
      <a href="/courses" class="program-catalog-link">Смотреть каталог курсов <span aria-hidden="true">↗</span></a>
      <a href="/vizualization3_mini" class="program-catalog-link">Посмотреть пробный урок <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="quiz" class="wrap section quiz-experience" aria-label="Тест: подбор курса">
    <Quiz client:load cat={cat} variant="home" startOpen telegramBot={site.telegramBot} gamesHref="/courses-page/gamedev" vizHref="/courses-page/visualization" />
  </section>

  <section id="ai" class="wrap subsection" aria-labelledby="ai-title">
    <AiFeature price={rub(ai.price)} />
  </section>

  <WorksShowcase wide={wide} trio={trio} id="hw-title" class="subsection home-works">
    <Fragment slot="head">
      <div>
        <p class="t-overline m-0">Результаты</p>
        <h2 id="hw-title" class="t-h2">Работы <span class="t-accent">учеников</span></h2>
      </div>
      <div class="max-w-[420px]">
        <p class="m-0 text-ink-2">Всё сделано во время учёбы. {wv.galleryCount} {plural(wv.galleryCount, ['работа', 'работы', 'работ'])} в галерее, у {wv.kings} {plural(wv.kings, ['ученика', 'учеников', 'учеников'])} «Царь горы» на 3DDD.</p>
        <a href="/gallery" class="link tap self-start">Смотреть галерею →</a>
      </div>
    </Fragment>
  </WorksShowcase>

  <TrustBlock />

  <section id="club" class="wrap subsection" aria-labelledby="club-title">
    <CommunityFeature />
  </section>

  <Faq page="home" title="Вопросы" ids={homeFaqIds} compact spacing="section" />
</Base>

<style>
  .program-tabs {
    display: flex;
    width: max-content;
    max-width: 100%;
    gap: clamp(20px, 3vw, 40px);
    margin-bottom: 32px;
    border-bottom: 1px solid var(--color-line);
  }
  .program-tab {
    position: relative;
    min-height: 54px;
    padding: 0 0 14px;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-size: var(--type-body);
    font-weight: 650;
    white-space: nowrap;
    cursor: pointer;
  }
  .program-tab:hover, .program-tab[aria-selected="true"] { color: var(--color-ink); }
  .program-tab[aria-selected="true"]::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--color-lime);
    content: '';
  }
  .program-index-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 24px;
  }
  .program-index-head p { margin: 0; }
  .program-index-head > p:last-child { max-width: 440px; color: var(--color-ink-2); font-size: var(--type-small); line-height: 1.45; }
  .program-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(var(--program-rows), auto);
    grid-auto-flow: column;
    column-gap: var(--gap-grid);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .program-index li { min-width: 0; border-top: 1px solid var(--color-line); }
  .program-index li.program-index-last-left, .program-index li:last-child { border-bottom: 1px solid var(--color-line); }
  .program-index a {
    position: relative;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto 18px;
    align-items: center;
    gap: 16px;
    min-height: 96px;
    padding: 12px 8px 12px 0;
    text-decoration: none;
    transition: background-color .18s ease;
  }
  .program-index a::before {
    position: absolute;
    top: 14px;
    bottom: 14px;
    left: 0;
    width: 2px;
    background: var(--color-lime);
    content: '';
    opacity: 0;
    transition: opacity .18s ease;
  }
  .program-index a:hover, .program-index a:focus-visible { background: var(--color-surface); }
  .program-index a:hover::before, .program-index a:focus-visible::before { opacity: 1; }
  .program-index-number, .program-index-count { color: var(--color-muted); font: 500 var(--type-meta)/1.4 var(--font-mono); white-space: nowrap; }
  .program-index-number { padding-left: 8px; }
  .program-index-name {
    color: var(--color-ink);
    font-size: var(--type-card-title);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -.035em;
    overflow-wrap: anywhere;
    transition: transform .18s ease;
  }
  .program-index a:hover .program-index-name, .program-index a:focus-visible .program-index-name { transform: translateX(4px); }
  .program-index-arrow { color: var(--color-muted); font-size: 20px; line-height: 1; transition: color .18s ease, transform .18s ease; }
  .program-index a:hover .program-index-arrow, .program-index a:focus-visible .program-index-arrow { color: var(--color-ink); transform: translate(2px, -2px); }
  .program-catalog-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    margin-top: 28px;
    border-bottom: 1px solid var(--color-line-strong);
    color: var(--color-ink);
    font-weight: 650;
    text-decoration: none;
  }
  .program-catalog-link:hover { border-color: var(--color-ink); }
  .program-catalog-link span { font-size: 20px; font-weight: 400; }
  @media (max-width: 1023px) {
    .program-index { display: block; }
    .program-index li.program-index-last-left { border-bottom: 0; }
    .program-index a { min-height: 82px; }
  }
  @media (max-width: 560px) {
    .program-tabs { width: 100%; gap: 20px; }
    .program-tab { flex: 1; font-size: var(--type-small); }
    .program-index-head { display: block; }
    .program-index-head > p:last-child { margin-top: 8px; }
    .program-index a { grid-template-columns: 20px minmax(0, 1fr) 18px; grid-template-rows: auto auto; gap: 2px 10px; min-height: 76px; }
    .program-index-number, .program-index-arrow { grid-row: 1 / 3; }
    .program-index-name { grid-column: 2; grid-row: 1; align-self: end; }
    .program-index-count { grid-column: 2; grid-row: 2; align-self: start; }
    .program-index-arrow { grid-column: 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .program-index a, .program-index a::before, .program-index-name, .program-index-arrow { transition: none; }
  }
</style>

<style is:global>
  /* Вся главная собрана по ритму утверждённого варианта 03. */
  .site-home {
    --home-measure: 1360px;
    --home-gutter: max(24px, calc((100vw - var(--home-measure)) / 2));
    --home-section-gap: clamp(68px, 7.5vw, 108px);
  }
  .site-home main { background: var(--color-bg); }
  .site-home main > :is(#directions, #quiz, #ai, .home-works, .founder-manifesto, #club, #faq) {
    width: min(calc(100% - 2 * var(--home-gutter)), var(--home-measure));
    margin-inline: auto;
  }
  .site-home main > :is(#directions, #quiz, #ai, .founder-manifesto, #club, #faq) {
    padding-inline: 0;
  }
  .site-home .stats-ribbon { padding-inline: 0; }
  .site-home main > :is(#directions, #quiz, .home-works, .founder-manifesto, #faq) {
    position: relative;
    margin-top: var(--home-section-gap);
    padding-top: clamp(34px, 3.7vw, 52px);
    border-top: 1px solid var(--color-line);
  }
  .site-home main > :is(#directions, #quiz, .home-works, .founder-manifesto, #faq)::before {
    display: none;
  }
  .site-home main > #directions { margin-top: 0; padding-top: var(--home-section-gap); border-top: 0; }
  .site-home main > #directions::before { display: none; }
  .site-home .stats-ribbon {
    width: min(calc(100% - 2 * var(--home-gutter)), var(--home-measure));
    margin: clamp(22px, 2.4vw, 34px) auto 0;
    padding-top: 0;
  }
  .site-home .stats-ribbon__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(16px, 3vw, 42px);
    padding: clamp(16px, 1.7vw, 24px) 0 19px;
    border: 0;
    border-top: 1px solid var(--color-line);
    background: none;
    overflow: visible;
  }
  .site-home .stats-ribbon__list::before { position: absolute; right: 0; bottom: 0; left: 0; height: 1px; background: var(--color-line); content: ""; }
  .site-home .stats-ribbon__list::after { position: absolute; bottom: -1px; left: 0; width: 42px; height: 2px; background: var(--color-lime); content: ""; }
  .site-home .stats-ribbon__item { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding: 0; border: 0; }
  .site-home .stats-ribbon__item dt { order: 2; max-width: 20ch; color: var(--color-muted); font-size: var(--type-small); line-height: 1.35; }
  .site-home .stats-ribbon__item dd { order: 1; }
  .site-home .stats-ribbon__item a { color: inherit; }

  .site-home #directions .head,
  .site-home .home-reviews > .head {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: end;
    gap: 0;
    margin-bottom: clamp(26px, 3.5vw, 42px);
  }
  .site-home #directions .head > :last-child,
  .site-home .home-reviews > .head > :last-child { grid-column: 2; grid-row: 1 / span 2; margin-left: clamp(18px, 2.5vw, 36px); max-width: none; line-height: 1.6; }
  .site-home #directions .head h2,
  .site-home .home-reviews .head h2 { margin-top: 18px; font-size: clamp(34px, 4vw, 54px); line-height: 1.03; letter-spacing: -.057em; }
  .site-home #directions .head h2 { grid-column: 1; grid-row: 2; }
  .site-home #directions .head h2 span,
  .site-home .home-reviews .head h2 span { display: block; color: var(--color-heading-muted); }
  .site-home .directions-intro { max-width: 440px; }
  .site-home .directions-intro,
  .site-home #directions .head > p:first-child::before,
  .site-home .home-reviews .head > div > p:first-child::before,
  .site-home #ai .ai-feature__eyebrow::before,
  .site-home #club .community-feature__eyebrow::before,
  .site-home .ai-feature__dot,
  .site-home .community-feature__eyebrow span,
  .site-home .eyebrow i { display: none; }
  .site-home #directions .head > :last-child { display: none; }
  .site-home #directions .program-tabs { height:49px; margin-bottom: 28px; }
  .site-home #directions .program-tabs button { height:48px; min-height:0; padding:0 0 12px; box-sizing:border-box; font-size:13px; line-height:19.5px; }
  .site-home #directions #pick-dir { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 2.2vw, 32px); align-items: stretch; }
  .site-home #directions #pick-dir > article { display: flex; flex-direction: column; overflow: hidden; gap: 0; border: 1px solid var(--color-line); background: var(--color-surface); }
  .site-home #directions #pick-dir > article .media-frame { height: auto; aspect-ratio: var(--media-ratio-card); border-radius: 2px; }
  .site-home #directions #pick-dir > article .media-frame::after { position: absolute; inset: 42% 0 0; background: linear-gradient(transparent, rgb(0 0 0 / .43)); content: ""; }
  .site-home #directions .direction-number { position: absolute; z-index: 1; bottom: 16px; left: 16px; color: var(--color-ink); font: var(--type-meta) var(--font-mono); letter-spacing: .1em; }
  .site-home #directions .direction-arrow { position: absolute; z-index: 2; right: 16px; bottom: 16px; display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid rgb(241 241 235 / .65); color: var(--color-ink); font-size: 22px; }
  .site-home #directions #pick-dir > article > div:last-child { display: flex; flex: 1; flex-direction: column; padding: clamp(24px, 3vw, 40px); }
  .site-home #directions .direction-meta { margin: 0; line-height: 1.6; }
  .site-home #directions #pick-dir h3 { margin: 18px 0 12px; }
  .site-home #directions #pick-dir h3 a { position: relative; z-index: 3; }
  .site-home #directions .direction-cta { margin-top: auto; padding-top: 22px; border-top-color: var(--color-line); }
  .site-home #directions .direction-links { display: flex; flex-wrap: nowrap; gap: 12px 28px; margin-top: 28px; }
  .site-home #directions .program-catalog-link { min-height:30px; margin-top:0; padding-bottom:5px; border-bottom:1px solid var(--color-line-strong); font-size:14px; line-height:1.5; white-space:nowrap; }
  .site-home #directions .program-catalog-link span { font-size:16px; }

  .site-home #ai { margin-top: var(--home-section-gap); padding-top: 0; }
  .site-home #ai .ai-feature { position: relative; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); align-items: center; gap: clamp(28px, 5vw, 74px); padding: clamp(36px, 4.4vw, 64px); border: 1px solid var(--color-line); background: var(--color-surface); }
  .site-home #ai .ai-feature::before { position: absolute; top: -1px; left: 0; width: 42px; height: 2px; background: var(--color-lime); content: ""; }
  .site-home #ai .ai-feature__copy { gap: 0; padding: 0; }
