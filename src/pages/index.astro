---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroWork from '../components/HeroWork.astro';
import PathStrip from '../components/PathStrip.astro';
import WorksShowcase from '../components/WorksShowcase.astro';
import Faq from '../components/Faq.astro';
import Quiz from '../islands/Quiz';
import { getCatalog } from '../lib/catalog';
import { faqLd } from '../lib/views';
import { websiteLd } from '../lib/seo';
import { workViews } from '../lib/works';
import { rub, sp, plural } from '../lib/format';

const SOFT = import.meta.glob<{ default: ImageMetadata }>('../assets/software/*.png', { eager: true });
const soft = (n: string) => SOFT[`../assets/software/${n}.png`].default;
// Программы: иконка, подпись и значение фильтра каталога (/courses?soft=…)
const SOFTWARE = {
  '3dsmax': { name: '3ds Max', tag: '3DS MAX' },
  corona: { name: 'Corona', tag: 'CORONA RENDERER' },
  vray: { name: 'V-Ray', tag: 'V-RAY' },
  forestpack: { name: 'Forest Pack', tag: 'FOREST PACK' },
  photoshop: { name: 'Photoshop', tag: 'ADOBE PHOTOSHOP' },
  blender: { name: 'Blender', tag: 'BLENDER' },
  zbrush: { name: 'ZBrush', tag: 'ZBRUSH' },
  unreal: { name: 'Unreal Engine', tag: 'UNREAL ENGINE' },
  maya: { name: 'Maya', tag: 'MAYA' },
  substance: { name: 'Substance Painter', tag: 'SUBSTANCE PAINTER' },
} as const;
type SoftId = keyof typeof SOFTWARE;
const listed = await getCollection('courses', (c) => c.data.status === 'active' && ['course', 'package', 'free'].includes(c.data.type));
const softCount = (id: SoftId) => listed.filter((c) => c.data.software.includes(SOFTWARE[id].tag)).length;
const softHref = (id: SoftId) => `/courses?soft=${encodeURIComponent(SOFTWARE[id].tag.toLowerCase())}`;

const site = (await getEntry('settings', 'site'))!.data;
const s = site.stats;
const cat = await getCatalog();
const faq = await faqLd('home');
const wv = await workViews();
const hero = wv.work('bolshunova-ostrov-1') ?? wv.pick(['tveritin-druzhba', 'rossoshansky-gostinaya'])[0];
const wide = wv.work('tveritin-druzhba');
const trio = wv.pick(['kamola-kuhnya', 'korotovskaya-shale', 'shesterikova-loft']);
const dirViz = wv.work('bolshunova-banya-1') ?? wv.work('rossoshansky-gostinaya');
const dirGame = wv.work('gitsuk-korabl') ?? wv.work('bagirov-korabl');
const reviews = (await getCollection('reviews')).sort((a, b) => a.data.order - b.data.order);
const gameMin = (await getEntry('courses', 'gamedevlevel1'))!.data.price;
const courseCount = (await getCollection('courses', (c) => c.data.status === 'active' && ['course', 'package'].includes(c.data.type))).length;
const ai = (await getEntry('courses', 'ai'))!.data;
const why = [
  { t: 'Учим думать, а не копировать', d: 'Системный подход вместо набора мастер-классов. Понимаете, почему так, а не просто за какой кнопкой.' },
  { t: 'Проверка работ педагогами', d: 'В форматах с поддержкой домашние задания проверяют педагоги и отвечают на вопросы в чате полгода.' },
  { t: 'Пакет под вашу цель', d: 'База, затем профессия и только те доп. курсы, которые нужны именно вам.' },
  { t: 'Стримы GRIPINSKY TV', d: 'Каждую среду в 18:30 разбираем работы в прямом эфире, вручаем «Рендер дня» и встречаемся с работодателями.' },
  { t: 'Экосистема, а не просто уроки', d: 'Индивидуальные занятия, наставничество, конкурсы и помощь с портфолио.' },
  { t: 'Тёплое комьюнити', d: 'Студенты остаются с нами годами, а лучшие выпускники становятся педагогами.' },
];
const pay = ['Банковская карта РФ', 'СБП', 'Рассрочка через банк', 'Оплата частями', 'Карта иностранного банка', 'Счёт для юрлиц и ИП'];
// Полоса шагов: путь в 3D-визуализации с ценами «от …» (цены из каталога)
const profMin = Math.min(...Object.values(cat.professions).flatMap((p) => p.courses.map((c) => c.price)));
const steps = [
  { n: '01', title: 'База', sub: '3ds Max, Corona и ИИ в 3D, доступ на год', price: `от ${rub(cat.base.price)}`, href: '/courses-page/visualization#base' },
  { n: '02', title: 'Профессия', sub: 'Интерьеры, экстерьеры или модели для стоков', price: `от ${rub(profMin)}`, href: '/courses-page/visualization#profession' },
  { n: '03', title: 'Пакет', sub: 'База и профессия вместе, подарок к профессии', price: `от ${rub(cat.base.price + profMin)}`, href: '/courses-page/visualization#package' },
];
const stats = [
  { value: s.graduates, label: 'выпускников' },
  { value: s.rating, label: 'на Яндекс Картах', href: site.yandexMaps },
  { value: s.years, label: 'учим по своей системе' },
];
const dirSoft: Record<'viz' | 'game', SoftId[]> = { viz: ['3dsmax', 'corona', 'photoshop'], game: ['blender', 'zbrush', 'unreal'] };
---
<Base
  title="Онлайн-курсы 3D-графики и визуализации с нуля | Академия 3D GRIPINSKY"
  description={`Онлайн-курсы 3D-визуализации интерьеров и экстерьеров, моделирования и 3D для игр с нуля. ${s.graduates} выпускников, портфолио за время учёбы, бесплатные уроки и рассрочка.`}
  jsonLd={[websiteLd, faq]}
  consultContext="Главная"
>
  {hero && (
    <HeroWork work={hero} kicker="Онлайн-школа 3D-графики" id="home-title">
      <h1 slot="title" id="home-title" class="t-hero">Курсы <span class="whitespace-nowrap">3D-графики</span> <span class="t-accent block">с нуля до заказов</span></h1>
      <p slot="lead" class="t-lead m-0 max-w-[540px] !text-ink">Визуализация интерьеров и экстерьеров, 3D для игр и нейросети в работе. В своём темпе, без опыта и умения рисовать.</p>
      <Fragment slot="cta">
        <a href="#directions" class="btn btn-primary btn-lg">Выбрать направление</a>
        <a href="#quiz" class="link tap">Подобрать курс за 1 минуту →</a>
      </Fragment>
    </HeroWork>
  )}

  <PathStrip label="Путь в 3D-визуализации" steps={steps} stats={stats} />

  <section id="directions" class="wrap section" aria-labelledby="dir-title">
    <div class="head">
      <p class="t-overline m-0">Направления и программы</p>
      <h2 id="dir-title" class="t-h2" tabindex="-1">Выберите <span class="t-accent">курс</span></h2>
      <p class="text-ink-2">Начните с направления, если выбираете профессию. Или сразу найдите курсы по программе, если уже знаете, что нужно.</p>
    </div>

    <div role="tablist" aria-label="Способ выбора курса" class="mb-8 grid max-w-full grid-cols-2 gap-1 rounded-[6px] border border-line p-1 sm:inline-grid" data-pick-tabs>
      <button type="button" role="tab" id="pick-tab-dir" aria-controls="pick-dir" aria-selected="true" tabindex="0"
        class="min-h-11 whitespace-nowrap rounded-[4px] border-0 bg-transparent px-3 text-[15px] font-semibold text-ink aria-selected:bg-ink aria-selected:text-bg sm:px-5 sm:text-[16px]">По направлению</button>
      <button type="button" role="tab" id="pick-tab-soft" aria-controls="pick-soft" aria-selected="false" tabindex="-1"
        class="min-h-11 whitespace-nowrap rounded-[4px] border-0 bg-transparent px-3 text-[15px] font-semibold text-ink aria-selected:bg-ink aria-selected:text-bg sm:px-5 sm:text-[16px]">По программе</button>
    </div>

    <div role="tabpanel" id="pick-dir" aria-labelledby="pick-tab-dir" class="grid gap-x-[var(--gap-grid)] gap-y-12 md:grid-cols-2">
      {[
        { w: dirViz, href: '/courses-page/visualization', title: '3D-визуализация', text: 'Фотореалистичные интерьеры и экстерьеры в 3ds Max и Corona для дизайнеров и застройщиков.', meta: ['3 профессии', '230 уроков в базе'], price: `База от ${rub(cat.base.price)}`, monthly: Math.ceil(cat.base.price / cat.installmentMonths), soft: dirSoft.viz, cta: 'Выбрать профессию →' },
        { w: dirGame, href: '/courses-page/gamedev', title: '3D для игр', text: 'Предметы, локации и персонажи в Blender, ZBrush и Unreal Engine.', meta: ['5 профессий', 'от пропса до персонажа'], price: `Курсы от ${rub(gameMin)}`, monthly: Math.ceil(gameMin / cat.installmentMonths), soft: dirSoft.game, cta: 'Смотреть курсы →' },
      ].map((d) => (
        <article class="zoom relative flex flex-col gap-5">
          {d.w && (
            <div class="relative aspect-[16/10] overflow-hidden rounded-[4px]">
              <Image src={d.w.image} alt={d.w.alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" style={`object-position:${d.w.focus}`} />
              <span class="badge-on-image absolute bottom-3 left-3">{d.w.author}</span>
            </div>
          )}
          <div class="flex flex-1 flex-col gap-3">
            <p class="t-meta">{d.meta.map((m) => <span>{m}</span>)}</p>
            <h3 class="t-h2 !text-[clamp(26px,2.6vw,36px)]"><a href={d.href} class="text-ink after:absolute after:inset-0 hover:text-white">{d.title}</a></h3>
            <p class="m-0 max-w-[520px] text-ink-2">{d.text}</p>
            <ul class="m-0 flex list-none flex-wrap gap-2 p-0" aria-label="Программы">
              {d.soft.map((id) => <li class="chip !normal-case !text-[12px]"><Image src={soft(id)} alt="" width={16} height={16} class="h-4 w-4 rounded-full" />{SOFTWARE[id].name}</li>)}
            </ul>
            <p class="m-0 mt-auto flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-line pt-4">
              <span><b class="text-[18px]">{d.price}</b> <span class="text-muted">или {sp(d.monthly)}&nbsp;₽/мес</span></span>
              <span class="font-semibold text-ink" data-cta>{d.cta}</span>
            </p>
          </div>
        </article>
      ))}
    </div>

    <div role="tabpanel" id="pick-soft" aria-labelledby="pick-tab-soft" hidden>
      <ul class="m-0 grid list-none grid-cols-2 gap-[var(--gap-grid)] p-0 sm:grid-cols-3 md:grid-cols-5">
        {(Object.keys(SOFTWARE) as SoftId[]).filter((id) => softCount(id) > 0).map((id) => (
          <li>
            <a href={softHref(id)} class="soft-tile">
              <Image src={soft(id)} alt="" width={40} height={40} loading="eager" class="h-10 w-10 rounded-full" />
              <b class="text-[16px] text-ink">{SOFTWARE[id].name}</b>
              <span class="t-mono text-[13px] text-muted">{softCount(id)} {plural(softCount(id), ['курс', 'курса', 'курсов'])}</span>
              <span class="mt-auto text-[14px] font-semibold text-ink">Смотреть →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <a href="/courses" class="btn btn-secondary btn-block mt-10">Все {courseCount} курсов и пакетов</a>
  </section>

  <WorksShowcase wide={wide} trio={trio} id="hw-title">
    <Fragment slot="head">
      <div class="flex flex-col gap-3">
        <p class="t-overline m-0">Результаты</p>
        <h2 id="hw-title" class="t-h2">Работы <span class="t-accent">учеников</span></h2>
      </div>
      <div class="flex max-w-[420px] flex-col gap-2">
        <p class="m-0 text-muted">Всё сделано во время учёбы. {wv.galleryCount} работ в галерее, у {wv.kings} учеников «Царь горы» на 3DDD.</p>
        <a href="/gallery" class="link tap self-start">Смотреть галерею →</a>
      </div>
    </Fragment>
  </WorksShowcase>

  <section id="quiz" class="wrap section" aria-label="Тест: подбор курса">
    <Quiz client:load cat={cat} variant="home" startOpen telegramBot={site.telegramBot} gamesHref="/courses-page/gamedev" vizHref="/courses-page/visualization" />
  </section>

  <section id="why" class="wrap section" aria-labelledby="why-title">
    <div class="head">
      <p class="t-overline m-0">Почему GRIPINSKY</p>
      <h2 id="why-title" class="t-h2">Почему не бесплатный <span class="t-accent">YouTube</span></h2>
    </div>
    <dl class="m-0 grid grid-cols-2 gap-x-[var(--gap-grid)] gap-y-8 border-y border-line py-8 md:grid-cols-4">
      {[['1 год', 'доступа ко всем урокам курса'], ['6 месяцев', 'проверки работ в форматах с поддержкой'], ['Свой темп', 'без расписания и дедлайнов'], [s.videos, `видеоуроков в ${courseCount} курсах`]].map(([a, b]) => (
        <div class="flex flex-col-reverse justify-end gap-2"><dt class="t-small text-muted">{b}</dt><dd class="t-num m-0">{a}</dd></div>
      ))}
    </dl>
    <ul class="m-0 mt-12 grid list-none gap-x-[var(--gap-grid)] gap-y-10 p-0 sm:grid-cols-2 md:grid-cols-3">
      {why.map((w, i) => (
        <li class="flex flex-col gap-2 border-t border-line pt-5"><span class="t-mono text-[13px] text-muted" aria-hidden="true">0{i + 1}</span><h3 class="t-title">{w.t}</h3><p class="t-small m-0 text-muted">{w.d}</p></li>
      ))}
    </ul>
  </section>

  <section id="ai" class="wrap section" aria-labelledby="ai-title">
    <div class="grid gap-10 md:grid-cols-[6fr_5fr] md:gap-16">
      <div class="flex flex-col gap-4">
        <p class="t-overline m-0">Новый курс</p>
        <h2 id="ai-title" class="t-h2">ИИ в 3D: <span class="t-accent">работайте в разы быстрее</span></h2>
        <p class="t-quote m-0">ИИ не заменит 3D-художника. Его заменит художник с ИИ</p>
        <p class="m-0 text-ink-2">Нейросети во всём пайплайне: референсы, 3D-модель по фото, ретопология, текстуры и сцена. Рутину отдаёте ИИ, качество доводите сами. Курс входит в «Базу 3D-визуализатора».</p>
        <div class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-3"><a href="/ai" class="btn btn-secondary btn-lg">Смотреть курс</a><span class="text-ink-2">от <b class="text-ink">{rub(ai.price)}</b></span></div>
      </div>
      <ul class="m-0 flex list-none flex-col p-0">
        {[['4 вида', '3D-модель', 'Нейросеть собирает модель по референсам, вы чистите сетку.'], ['1 промпт', 'окружение', 'Модель на сером фоне превращается в готовую сцену.'], ['1 рендер', '4 ракурса', 'Разные ракурсы в том же окружении для портфолио.']].map(([a, b, c]) => (
          <li class="flex flex-col gap-1 border-t border-line py-5 last:border-b"><span class="text-[20px] font-bold">{a} <span class="text-muted">и</span> {b}</span><span class="t-small text-muted">{c}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="hr-title">
    <div class="head md:!flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-3">
        <p class="t-overline m-0">Отзывы</p>
        <h2 id="hr-title" class="t-h2">Что говорят <span class="t-accent">ученики</span></h2>
      </div>
      <a href="/otzyvy" class="link tap self-start md:self-auto">Все отзывы и истории →</a>
    </div>
    <div class="grid gap-x-[var(--gap-grid)] gap-y-10 md:grid-cols-3">
      {reviews.map((r) => (
        <figure class="m-0 flex flex-col gap-5 border-t border-line pt-6">
          <blockquote class="m-0 text-[17px] leading-relaxed">{r.data.text}</blockquote>
          <figcaption class="mt-auto"><b>{r.data.author}</b><span class="t-overline block normal-case">{r.data.role}</span></figcaption>
        </figure>
      ))}
    </div>
    <div id="about" class="mt-16 grid gap-6 border-t border-line pt-8 md:grid-cols-[1fr_2fr_auto] md:items-start md:gap-12">
      <h3 class="t-title">Евгений Грипинский и&nbsp;команда педагогов</h3>
      <div class="flex flex-col gap-3">
        <p class="t-quote m-0">«Основная цель занятий: научить вас думать, а не повторять действия»</p>
        <p class="m-0 text-muted">20 лет назад Евгений создал обучающую систему. Её основа: системный подход к знаниям, высокие стандарты качества и адресная поддержка каждого студента.</p>
      </div>
      <a href="https://gripinsky.ru/teachers" class="link tap whitespace-nowrap">Все педагоги →</a>
    </div>
  </section>

  <Faq page="home" title="Вопросы" />

  <section class="wrap section" aria-labelledby="start-title">
    <div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[1fr_auto] md:items-end md:gap-16">
      <div class="flex flex-col gap-5">
        <h2 id="start-title" class="t-h2">Начните путь в 3D <span class="t-accent">сегодня</span></h2>
        <ul class="t-meta list-none p-0" aria-label="Способы оплаты">{pay.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/courses-page/visualization" class="btn btn-primary btn-lg">3D-визуализация</a>
        <a href="/courses-page/gamedev" class="btn btn-secondary btn-lg">3D для игр</a>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="seo-title">
    <div class="max-w-[860px] text-[15px] leading-relaxed text-muted">
      <h2 id="seo-title" class="t-title mb-3 text-ink">Академия 3D GRIPINSKY: онлайн-школа 3D-графики</h2>
      <p>Онлайн-курсы 3D-моделирования и визуализации для новичков и практикующих специалистов. Учим с нуля профессиям 3D-визуализатора интерьеров и экстерьеров и 3D-художника для игр: от первых шагов в 3ds Max и Blender до портфолио, с которым берут в студии и на коммерческие проекты.</p>
      <p>В каталоге курсы 3ds Max, Corona и V-Ray, Blender, ZBrush, Maya, Substance Painter и Unreal Engine, а также курс по нейросетям для 3D. В форматах с поддержкой работы проверяют педагоги, а на стримах GRIPINSKY TV мы разбираем работы учеников. Обучение онлайн, в своём темпе, с рассрочкой.</p>
    </div>
  </section>
</Base>

<script>
  // Переключатель «По направлению / По программе»; #programs в адресе сразу открывает программы
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-pick-tabs] [role="tab"]')];
  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
    if (focus) tab.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); select(tabs[(i + 1) % tabs.length], true); }
    });
  });
  if (location.hash === '#programs') select(tabs[1]);
</script>
