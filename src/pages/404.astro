---
import Base from '../layouts/Base.astro';
---
<Base title="Страница не найдена | Академия 3D GRIPINSKY" description="Такой страницы нет." noindex consult={false}>
  <section class="wrap section flex flex-col items-start gap-5">
    <span class="t-overline">Ошибка 404</span>
    <h1 class="t-display">Такой страницы <span class="t-accent">нет</span></h1>
    <p class="t-lead max-w-[640px]">Возможно, она переехала, пока мы обновляли сайт. Начните с главной, каталога или напишите нам.</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary btn-lg">На главную</a>
      <a href="/courses" class="btn btn-secondary btn-lg">Все курсы</a>
      <a href="https://t.me/Academy3D_bot" class="btn btn-secondary btn-lg">Написать в Telegram</a>
    </div>
  </section>
</Base>
