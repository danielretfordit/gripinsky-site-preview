---
import { getCollection } from 'astro:content';
import BlogPost from '../../components/BlogPost.astro';
import { isLegacyPost } from '../../lib/blog';

// Новые статьи. Статьи с Tilda собираются по старым адресам в src/pages/tpost/[slug].astro
export async function getStaticPaths() {
  return (await getCollection('blog', (p) => !p.data.draft && !isLegacyPost(p))).map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
---
<BlogPost post={post} />
