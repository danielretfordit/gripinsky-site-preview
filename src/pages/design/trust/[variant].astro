---
import Base from '../../../layouts/Base.astro';
import WhyGripinsky from '../../../components/WhyGripinsky.astro';
import FounderFeature from '../../../components/FounderFeature.astro';
import { getCollection } from 'astro:content';
export function getStaticPaths(){return ['journal','portrait','chapters'].map(variant=>({params:{variant}}));}
const variant=Astro.params.variant!;
const variants=[{id:'journal',title:'01 / Журнал',text:'Один разворот: шесть принципов, крупный портрет основателя и голоса учеников в нижней части.'},{id:'portrait',title:'02 / Портрет и метод',text:'Евгений и подход академии стоят рядом. Отзывы под ними соединяют принципы с опытом учеников.'},{id:'chapters',title:'03 / Три главы',text:'Последовательная история с общей нумерацией: подход, основатель, подтверждение. Больше воздуха и спокойнее ритм.'}];
const selected=variants.find(v=>v.id===variant)!;
const collection=await getCollection('reviews');
const reviews=['natalya-approach','darya-client','bitum-community'].map(id=>collection.find(r=>r.id===id)).filter(Boolean);
---
<Base title={`${selected.title} | Общий блок GRIPINSKY`} description="Варианты оформления подхода академии, основателя и отзывов" noindex consult={false}>
<header class="wrap concept-head"><p class="t-overline">Дизайн-концепции / Главная</p><h1 class="t-h2">Подход. Человек. Результат.</h1><p class="t-lead text-ink-2">{selected.text}</p><nav class="variants" aria-label="Варианты оформления">{variants.map(v=><a class:list={['btn btn-secondary',v.id===variant&&'selected']} href={`/design/trust/${v.id}`} aria-current={v.id===variant?'page':undefined}>{v.title}</a>)}</nav><a href="/#why" class="link t-small">Текущая главная →</a></header>
<div class:list={['trust',`trust--${variant}`]}>
 <div class="trust-top"><span class="t-overline">GRIPINSKY / Подход к обучению</span><span class="t-meta">Метод / Основатель / Опыт учеников</span></div>
 <div class="trust-body"><div class="method"><span class="chapter t-overline">01 / Во что мы верим</span><WhyGripinsky/></div><div class="person"><span class="chapter t-overline">02 / Кто за этим стоит</span><FounderFeature refined={variant !== "chapters"}/></div></div>
 <section class="voices" aria-labelledby="voices-title"><div class="voices-head"><div><p class="t-overline">03 / Подтверждают ученики и заказчики</p><h2 id="voices-title" class="t-h2">Подход виден<br/><span class="text-heading-muted">в их опыте.</span></h2></div><a href="/otzyvy" class="link t-small">Все отзывы →</a></div><div class="review-grid">{reviews.map(r=><figure><blockquote class="t-body">«{r!.data.text}»</blockquote><figcaption class="t-small"><b>{r!.data.author}</b><span class="text-muted">{r!.data.role}</span></figcaption></figure>)}</div></section>
</div>
</Base>
<style>
.concept-head{padding-top:24px;padding-bottom:40px}.concept-head>p{max-width:800px}.variants{display:flex;flex-wrap:wrap;gap:12px;margin:24px 0}.selected{border-color:var(--color-ink);background:var(--color-surface)}.trust{max-width:1360px;margin:0 auto 80px;padding:40px;background:var(--color-surface);border-top:1px solid var(--color-line-strong)}.trust-top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;padding-bottom:28px;border-bottom:1px solid var(--color-line)}.chapter{display:none}.method :global(.why-gripinsky){width:100%;margin:40px 0 0;padding:0;border:0;gap:40px}.person :global(.founder){width:100%;margin-top:48px;padding:0}.person :global(.founder__copy){padding:32px 32px 32px 0}.voices{margin-top:48px;padding-top:32px;border-top:1px solid var(--color-line)}.voices-head{display:flex;align-items:end;justify-content:space-between;gap:24px}.voices-head h2{margin:18px 0 0}.review-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin-top:32px}.review-grid figure{margin:0;border-top:1px solid var(--color-line);padding-top:20px;display:flex;flex-direction:column}.review-grid blockquote{margin:0 0 24px;color:var(--color-ink-2)}.review-grid figcaption{margin-top:auto;display:flex;flex-direction:column;gap:6px}.trust--journal .method :global(.why-gripinsky){grid-template-columns:1fr 2fr}.trust--journal .method :global(ol){display:grid;grid-template-columns:1fr 1fr;gap:0 28px}.trust--journal .person :global(.founder__composition){grid-template-columns:1fr 1fr}.trust--portrait .trust-body{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px}.trust--portrait .method{grid-column:2;grid-row:1}.trust--portrait .person{grid-column:1;grid-row:1}.trust--portrait .method :global(.why-gripinsky){display:block}.trust--portrait .method :global(ol){margin-top:24px}.trust--portrait .person :global(.founder){margin-top:40px}.trust--portrait .person :global(.founder__composition){display:flex;flex-direction:column-reverse;border:0}.trust--portrait .person :global(.founder__portrait){height:380px;min-height:0}.trust--portrait .person :global(.founder__portrait img){width:100%;height:100%;object-fit:cover;object-position:50% 22%}.trust--portrait .person :global(.founder__copy){min-height:0;padding:32px 0}.trust--chapters{background:var(--color-bg);padding-inline:0}.trust--chapters .chapter{display:block;margin-top:40px}.trust--chapters .method :global(.why-gripinsky){margin-top:20px}.trust--chapters .person{border-top:1px solid var(--color-line);margin-top:40px}.trust--chapters .person :global(.founder){margin-top:20px}.trust--chapters .method :global(ol){display:grid;grid-template-columns:1fr 1fr;gap:0 28px}
@media(max-width:1439px){.trust{margin-inline:24px}.trust--chapters{padding-inline:16px}}
@media(max-width:1023px){.trust{padding:28px}.trust--journal .method :global(.why-gripinsky){grid-template-columns:1fr}.trust--portrait .trust-body{gap:28px}.trust--chapters .method :global(.why-gripinsky){grid-template-columns:1fr}.review-grid{gap:20px}}
@media(max-width:767px){.trust{margin-inline:20px;padding:24px}.trust--chapters{padding-inline:0}.trust-body,.trust--portrait .trust-body{display:block}.trust--journal .method :global(ol),.trust--chapters .method :global(ol){display:block}.method :global(.why-gripinsky){grid-template-columns:1fr;gap:24px}.person :global(.founder__composition),.trust--journal .person :global(.founder__composition){grid-template-columns:1fr}.person :global(.founder__copy){padding:24px 0;min-height:0}.review-grid{grid-template-columns:1fr;gap:28px}.voices-head{display:block}.voices-head>a{display:inline-block;margin-top:20px}.trust-top>span:last-child{display:none}.trust--portrait .person :global(.founder__portrait){height:320px}}
</style>
