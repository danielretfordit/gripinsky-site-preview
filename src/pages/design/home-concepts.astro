  /* 03: Architectural system. Image below the headline, precise rows. */
  html[data-concept="c"] .site-head { border-bottom-color:#59605d; }
  html[data-concept="c"] .concept-hero { display:flex; flex-direction:column; min-height:0; padding-top:65px; }
