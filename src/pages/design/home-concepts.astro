  /* New visual directions: each palette and type system is intentionally independent. */
  html[data-concept="a"] {
    --c-bg:#F3EEE5; --c-surface:#E8DFD2; --c-ink:#28221D; --c-soft:#51483F; --c-muted:#81766B;
    --c-line:rgba(40,34,29,.19); --c-accent:#A84F38; --c-display:'Playfair Display Variable', Georgia, serif;
    --c-body:'Inter Variable', Arial, sans-serif; --c-meta:'Inter Variable', Arial, sans-serif; --media-radius:0px;
  }
