---
import { Image } from 'astro:assets';
import '../../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/golos-text';
import '@fontsource-variable/playfair-display';
import logo from '../../assets/brand/logo.png';
import { getCollection, getEntry, render } from 'astro:content';
import { workViews, workCaption } from '../../lib/works';
import { canonicalUrl, absUrl, ogHref } from '../../lib/seo';
import { getCatalog } from '../../lib/catalog';
import { plural, rub } from '../../lib/format';

const wv = await workViews();
const hero = wv.work('bolshunova-ostrov-1');
const viz = wv.work('bolshunova-banya-1');
const game = wv.work('gitsuk-korabl');
const wide = wv.work('tveritin-druzhba');
const gallery = wv.pick(['bugaeva-interior', 'gushchina-house', 'meshkov-lake-house']);
const site = (await getEntry('settings', 'site'))!.data;
const catalog = await getCatalog();
const gameMin = (await getEntry('courses', 'gamedevlevel1'))!.data.price;
const ai = (await getEntry('courses', 'ai'))!.data;
const reviews = await getCollection('reviews');
const proof = [
  { id: 'natalya-approach', claim: 'Учим думать', number: '01' },
  { id: 'darya-client', claim: 'Сильные работы', number: '02' },
  { id: 'bitum-community', claim: 'Сообщество рядом', number: '03' },
].map((item) => ({ ...item, review: reviews.find((r) => r.id === item.id) })).filter((item) => item.review);
const faqIds = ['s-chego-nachat', 'risovat', 'vremya', 'oplata', 'vozvrat'];
const faqEntries = await getCollection('faq', (entry) => entry.data.pages.includes('home') && faqIds.includes(entry.id));
const faqItems = await Promise.all(faqEntries
  .sort((a, b) => faqIds.indexOf(a.id) - faqIds.indexOf(b.id))
  .map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const stats = [
  [site.stats.graduates, 'выпускников'],
  [site.stats.years, 'учим по своей системе'],
  [site.stats.videos, 'видеоуроков'],
  [site.stats.rating, 'на Яндекс Картах'],
  [site.stats.subscribers, 'подписчиков на YouTube'],
];
---
<!doctype html>
<html lang="ru" data-concept="a">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Три концепции главной | GRIPINSKY</title>
    <meta name="description" content="Три визуальные концепции главной страницы Академии 3D GRIPINSKY." />
    <link rel="canonical" href={canonicalUrl(Astro.url.pathname)} />
    <meta property="og:image" content={absUrl(ogHref('default'))} />
  </head>
  <body>
    <div class="concept-switcher" aria-label="Сравнение вариантов дизайна">
      <div class="concept-switcher__inner">
        <a class="concept-switcher__back" href="/">← Текущая главная</a>
        <div class="concept-switcher__buttons" role="group" aria-label="Вариант дизайна">
          <button type="button" data-switch="a" aria-pressed="true"><span>01</span> Бумага</button>
          <button type="button" data-switch="b" aria-pressed="false"><span>02</span> Кобальт</button>
          <button type="button" data-switch="c" aria-pressed="false"><span>03</span> Графит+</button>
        </div>
        <p class="concept-switcher__note" data-concept-note>Бумага · терракота · Playfair Display + Inter</p>
      </div>
    </div>

    <div class="concept-site">
      <header class="site-head">
        <a href="/" aria-label="GRIPINSKY, главная"><Image src={logo} alt="GRIPINSKY" width={196} height={26} densities={[1,2,3]} /></a>
        <nav aria-label="Разделы сайта"><a href="#directions">Направления</a><a href="#works">Работы учеников</a><a href="#club">Сообщество</a></nav>
        <a class="head-link" href="#consult">Бесплатная консультация <span aria-hidden="true">↗</span></a>
      </header>

      <main>
        <section class="concept-hero" aria-labelledby="concept-title">
          {hero && <div class="hero-media"><Image src={hero.image} alt={hero.alt} widths={[640,960,1440,1920]} sizes="100vw" loading="eager" fetchpriority="high" /><span class="image-credit">{workCaption(hero)}</span></div>}
          <div class="hero-copy">
            <p class="overline"><span class="signal"></span> Онлайн-школа 3D-графики</p>
            <h1 id="concept-title">Курсы <span class="hero-title__inline">3D-графики</span> <span>с нуля до заказов</span></h1>
            <p class="hero-lead">Визуализация интерьеров и экстерьеров, 3D для игр и нейросети в работе. В своём темпе, без опыта и умения рисовать.</p>
            <div class="hero-actions"><a class="action-primary" href="#directions">Выбрать направление <span aria-hidden="true">↗</span></a><a class="action-text" href="#quiz">Подобрать курс за 1 минуту →</a></div>
          </div>
          <span class="hero-index" aria-hidden="true">01 / GRIPINSKY</span>
        </section>

        <section class="concept-stats" aria-label="Академия в цифрах">
          {stats.map(([value, label]) => <div><strong>{value}</strong><span>{label}</span></div>)}
        </section>

        <section id="directions" class="concept-section directions" aria-labelledby="directions-title">
          <div class="section-head"><p class="overline">Направления и программы</p><h2 id="directions-title">Выберите <span>курс</span></h2><p>Начните с направления, если выбираете профессию. Или сразу найдите курсы по программе, если уже знаете, что нужно.</p></div>
          <div class="direction-list">
            <a class="direction" href="/courses-page/visualization">
              {viz && <div class="direction__image"><Image src={viz.image} alt={viz.alt} widths={[480,800,1200]} sizes="(min-width: 768px) 50vw, 100vw" /></div>}
              <div class="direction__copy"><span class="small-label">3 профессии · 230 уроков в базе</span><h3>3D-визуализация</h3><p>Фотореалистичные интерьеры и экстерьеры в 3ds Max и Corona для дизайнеров и застройщиков.</p><span class="direction__link">База от {rub(catalog.base.price)} · Выбрать профессию →</span></div>
            </a>
            <a class="direction" data-direction="gamedev" href="/courses-page/gamedev">
              {game && <div class="direction__image"><Image src={game.image} alt={game.alt} widths={[480,800,1200]} sizes="(min-width: 768px) 50vw, 100vw" /></div>}
              <div class="direction__copy"><span class="small-label">5 профессий · от пропса до персонажа</span><h3>3D для игр</h3><p>Предметы, локации и персонажи в Blender, ZBrush и Unreal Engine.</p><span class="direction__link">Курсы от {rub(gameMin)} · Смотреть курсы →</span></div>
            </a>
          </div>
          <a class="section-out" href="/courses">Смотреть каталог курсов ↗</a>
        </section>

        <section id="quiz" class="concept-section quiz" aria-labelledby="quiz-title">
          <div class="section-head"><p class="overline">Тест на 1 минуту</p><h2 id="quiz-title">Подберём <span>ваш старт</span></h2><p>Ответьте на 5 вопросов, и мы определим ваш уровень, подскажем курсы и сразу посчитаем пакет.</p></div>
          <div class="quiz-preview"><span class="small-label">Вопрос 1 из 5</span><p>Что вам интереснее создавать?</p><div><span>Интерьеры, дома и предметы</span><span>Игровые миры: предметы, локации, персонажей</span><span>Пока не знаю</span></div></div>
        </section>

        <section id="ai" class="concept-section ai-feature" aria-labelledby="ai-title">
          <div class="ai-feature__copy"><p class="overline">Новый курс / ИИ в 3D</p><h2 id="ai-title">ИИ <span>ИЛИ УМРИ</span></h2><p class="ai-feature__claim">ИИ не заменит 3D-художника. Его заменит художник с ИИ</p><p>Нейросети во всём пайплайне: референсы, 3D-модель по фото, ретопология, текстуры и сцена. Рутину отдаёте ИИ, качество доводите сами. Курс входит в «Базу 3D-визуализатора».</p><div class="ai-feature__action"><a class="action-primary" href="/ai">Смотреть курс ↗</a><span>от {rub(ai.price)}</span></div></div>
          <div class="ai-feature__mark" aria-hidden="true">ИИ<span>3D × AI<br />ЧЕЛОВЕК РЕШАЕТ</span></div>
        </section>

        <section id="works" class="concept-section works" aria-labelledby="works-title">
          <div class="section-head"><p class="overline">Результаты</p><h2 id="works-title">Работы <span>учеников</span></h2><p>Всё сделано во время учёбы. {wv.galleryCount} {plural(wv.galleryCount, ['работа', 'работы', 'работ'])} в галерее, у {wv.kings} {plural(wv.kings, ['ученика', 'учеников', 'учеников'])} «Царь горы» на 3DDD.</p></div>
          {wide && <figure class="works__wide"><Image src={wide.image} alt={wide.alt} widths={[640,960,1440]} sizes="100vw" /><figcaption>{workCaption(wide)}</figcaption></figure>}
          <div class="works__trio">{gallery.map((w) => <figure><Image src={w.image} alt={w.alt} widths={[400,640,800]} sizes="(min-width: 768px) 33vw, 100vw" /><figcaption>{workCaption(w)}</figcaption></figure>)}</div>
          <a class="section-out" href="/gallery">Смотреть галерею →</a>
        </section>

        <section id="founder" class="concept-section founder" aria-labelledby="founder-title">
          <div class="founder__copy"><p class="overline">Основатель академии</p><h2 id="founder-title">Евгений <span>Грипинский</span></h2><p>Преподаёт 3D с 2007 года. От индивидуальных занятий до академии, где учат понимать задачу и находить собственное решение.</p><blockquote>«Основная цель занятий: научить вас думать, а не повторять действия»</blockquote></div>
          <img class="founder__photo" src="/images/evgeny-gripinsky-color.webp" alt="Евгений Грипинский" width="764" height="1036" loading="lazy" />
        </section>

        <section class="concept-section proof" aria-labelledby="proof-title">
          <div class="section-head"><p class="overline">Подтверждают ученики и заказчики</p><h2 id="proof-title">Не обещания. <span>Их опыт.</span></h2><a class="section-out" href="/otzyvy">Все отзывы и истории →</a></div>
          <div class="proof__grid">{proof.map(({ number, claim, review }) => <figure><div class="proof__tag"><span>{number}</span>{claim}</div><blockquote>«{review!.data.text}»</blockquote><figcaption><strong>{review!.data.author}</strong><span>{review!.data.role}</span></figcaption></figure>)}</div>
        </section>

        <section id="club" class="concept-section club" aria-labelledby="club-title">
          <div class="club__copy"><p class="overline">Сообщество академии</p><h2 id="club-title">Растём в 3D <span>вместе</span></h2><p>Учёба продолжается и за пределами уроков: встречаемся на эфирах, разбираем работы и следим за успехами друг друга.</p><a class="action-text" href="/club">Узнать о сообществе ↗</a></div>
          <div class="club__items"><p><span>01</span><strong>GRIPINSKY TV</strong><small>Прямые эфиры по средам: разборы работ учеников и встречи с профессионалами индустрии.</small></p><p><span>02</span><strong>«Рендер дня»</strong><small>Показываем работы учеников и отмечаем лучшие на стримах академии.</small></p><p><span>03</span><strong>Люди рядом</strong><small>Выпускники, ученики и педагоги остаются на связи и делятся опытом.</small></p></div>
        </section>

        <section id="faq" class="concept-section faq" aria-labelledby="faq-title"><div class="section-head"><p class="overline">Ответы</p><h2 id="faq-title">Вопросы</h2></div><div>{faqItems.map(({ entry, Content }) => <details><summary>{entry.data.question}</summary><div class="faq-answer"><Content /></div></details>)}</div></section>

        <section id="consult" class="concept-section consult"><p class="overline">Консультация</p><h2>Поможем выбрать <span>за 15 минут</span></h2><p>Бесплатная консультация: подберём старт, профессию и формат обучения. Перезвоним или напишем в течение дня.</p><p>Удобнее сразу в мессенджере? Напишите в Telegram или ВКонтакте.</p><a class="action-primary" href="/#consult">Записаться на консультацию ↗</a></section>
      </main>

      <footer class="site-foot"><Image src={logo} alt="GRIPINSKY" width={196} height={26} /><span>Академия 3D-графики</span><a href="/">Вернуться на текущий сайт ↗</a></footer>
    </div>

    <script>
      const notes: Record<string, string> = {
        a: 'Бумага · терракота · Playfair Display + Inter',
        b: 'Кобальт · солнечный жёлтый · Inter',
        c: 'Графит · мягкий лимон · Golos Text + JetBrains Mono',
      };
      const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-switch]')];
      const note = document.querySelector<HTMLElement>('[data-concept-note]');
      const select = (variant: string, push = true) => {
        if (!notes[variant]) variant = 'a';
        document.documentElement.dataset.concept = variant;
        buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.switch === variant)));
        if (note) note.textContent = notes[variant];
        if (push) history.replaceState(null, '', `${location.pathname}?v=${variant}${location.hash}`);
      };
      select(new URLSearchParams(location.search).get('v') || 'a', false);
      buttons.forEach((button) => button.addEventListener('click', () => select(button.dataset.switch || 'a')));
    </script>
  </body>
</html>

<style is:global>
  :root { --c-bg:#0e1112; --c-surface:#161a1b; --c-ink:#ecece6; --c-soft:#c3c7c1; --c-muted:#8c9391; --c-line:rgba(236,236,230,.16); --c-accent:#f8f61a; }
  html { scroll-behavior:smooth; background:var(--c-bg); }
  body { margin:0; padding:0; color:var(--c-ink); background:var(--c-bg); font-family:var(--font-onest),Arial,sans-serif; }
  body *,body *::before,body *::after { box-sizing:border-box; }
  .concept-switcher { position:sticky; top:0; z-index:100; border-bottom:1px solid #3c4342; background:#202525; box-shadow:0 8px 30px #0005; }
  .concept-switcher__inner { display:flex; align-items:center; gap:24px; max-width:1440px; min-height:70px; margin:auto; padding:10px 28px; }
  .concept-switcher__back { flex:none; color:var(--c-soft); font-size:13px; text-decoration:none; }
  .concept-switcher__buttons { display:flex; gap:4px; margin:auto; padding:4px; border:1px solid #3c4342; border-radius:5px; }
  .concept-switcher__buttons button { min-height:35px; padding:6px 13px; border:0; border-radius:3px; background:transparent; color:var(--c-soft); cursor:pointer; font:600 13px var(--c-body),sans-serif; white-space:nowrap; }
  .concept-switcher__buttons button span { margin-right:7px; color:var(--c-muted); font:11px var(--c-meta),monospace; }
  .concept-switcher__buttons button[aria-pressed="true"] { background:var(--c-ink); color:var(--c-bg); }
  .concept-switcher__buttons button[aria-pressed="true"] span { color:#59605d; }
  .concept-switcher__note { max-width:260px; margin:0; color:var(--c-muted); font-size:12px; line-height:1.3; }
  .concept-site { overflow:hidden; }
  .site-head,.concept-section,.concept-stats,.site-foot { width:min(100% - 64px, 1360px); margin-inline:auto; }
  .site-head { display:flex; align-items:center; gap:32px; min-height:86px; border-bottom:1px solid var(--c-line); }
  .site-head img,.site-foot img { display:block; width:196px; height:auto; }
  .site-head nav { display:flex; gap:28px; margin-left:auto; }
  .site-head a,.site-foot a { color:var(--c-ink); text-decoration:none; }
  .site-head nav a { font-size:14px; font-weight:550; }
  .head-link { margin-left:24px; padding-bottom:5px; border-bottom:1px solid var(--c-muted); font-size:14px; font-weight:650; white-space:nowrap; }
  .head-link span { margin-left:14px; }
  .overline,.small-label,.image-credit,.hero-index { margin:0; color:var(--c-muted); font:500 11px/1.45 var(--c-meta),monospace; letter-spacing:.09em; text-transform:uppercase; }
  .overline { display:flex; align-items:center; gap:11px; }
  .signal { display:inline-block; width:7px; height:7px; background:var(--c-accent); }
  .concept-hero { position:relative; display:grid; grid-template-columns:1fr 1fr; min-height:690px; width:min(100% - 64px,1360px); margin:auto; }
  .hero-media { position:relative; min-width:0; min-height:600px; overflow:hidden; }
  .hero-media img { width:100%; height:100%; object-fit:cover; object-position:43% center; }
  .image-credit { position:absolute; right:20px; bottom:20px; left:20px; padding:8px 10px; color:#fff; background:#0e1112b8; width:max-content; max-width:calc(100% - 40px); }
  .hero-copy { display:flex; flex-direction:column; align-items:flex-start; justify-content:center; padding:70px 7% 88px 0; }
  .hero-copy h1 { max-width:810px; margin:40px 0 28px; font-size:clamp(56px,6.2vw,98px); font-weight:800; letter-spacing:-.075em; line-height:.94; }
  .hero-copy h1 span,.section-head h2 span,.founder h2 span,.club h2 span,.consult h2 span { display:block; color:var(--c-muted); }
  .hero-lead { max-width:540px; margin:0; color:var(--c-soft); font-size:19px; line-height:1.5; }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:22px; margin-top:38px; }
  .action-primary { display:inline-flex; justify-content:space-between; align-items:center; gap:30px; min-height:58px; padding:14px 22px; border-radius:4px; color:#0e1112; background:var(--c-accent); font-weight:750; text-decoration:none; }
  .action-primary:hover { background:#ffff64; }
  .action-text { color:var(--c-ink); font-weight:650; text-decoration:none; border-bottom:1px solid var(--c-muted); padding-block:10px; }
  .hero-index { position:absolute; left:0; bottom:25px; }
  .concept-stats { display:flex; align-items:baseline; justify-content:space-between; gap:24px; padding:35px 0; border-top:1px solid var(--c-line); border-bottom:1px solid var(--c-line); }
  .concept-stats div { display:flex; flex-direction:column; gap:4px; min-width:0; }
  .concept-stats strong { font-size:clamp(22px,2.3vw,35px); letter-spacing:-.05em; white-space:nowrap; }
  .concept-stats span { color:var(--c-muted); font-size:12px; white-space:nowrap; }
  .concept-section { padding-block:112px 18px; scroll-margin-top:88px; }
  .section-head { display:grid; grid-template-columns:1fr 1fr; gap:18px 7%; align-items:end; margin-bottom:44px; }
  .section-head .overline { grid-column:1 / -1; }
  .section-head h2,.founder h2,.club h2,.consult h2 { margin:0; font-size:clamp(38px,4.5vw,64px); line-height:1; letter-spacing:-.06em; text-transform:uppercase; }
  .section-head > p:last-child { margin:0; max-width:480px; color:var(--c-soft); font-size:17px; line-height:1.5; }
  .direction-list { display:grid; grid-template-columns:1fr 1fr; gap:24px; }
  .direction { display:block; min-width:0; color:inherit; text-decoration:none; }
  .direction__image { height:clamp(300px,33vw,470px); overflow:hidden; border-radius:4px; }
  .direction__image img { width:100%; height:100%; object-fit:cover; transition:transform .5s ease; }
  .direction:hover img { transform:scale(1.025); }
  .direction__copy { display:grid; grid-template-columns:1fr auto; align-items:end; gap:12px 20px; padding:22px 0; border-bottom:1px solid var(--c-line); }
  .direction__copy .small-label,.direction__copy p { grid-column:1/-1; }
  .direction__copy h3 { margin:0; font-size:clamp(26px,2.4vw,34px); letter-spacing:-.04em; }
  .direction__copy p { max-width:520px; margin:0; color:var(--c-soft); font-size:16px; line-height:1.5; }
  .direction__link { font-size:14px; font-weight:700; white-space:nowrap; }
  .section-out { display:inline-block; margin-top:34px; padding-bottom:6px; border-bottom:1px solid var(--c-muted); color:var(--c-ink); font-weight:650; text-decoration:none; }
  .quiz { display:grid; grid-template-columns:1fr 1fr; gap:7%; align-items:start; }
  .quiz .section-head { display:block; margin:0; }
  .quiz .section-head h2 { margin-block:20px; }
  .quiz-preview { border-top:1px solid var(--c-line); padding-top:20px; }
  .quiz-preview > p { margin:20px 0; font-size:26px; font-weight:700; }
  .quiz-preview > div { display:grid; gap:7px; }
  .quiz-preview > div span { padding:13px 15px; border:1px solid var(--c-line); border-radius:4px; color:var(--c-soft); }
  .quiz-preview a { display:inline-block; margin-top:20px; color:var(--c-ink); font-weight:700; text-decoration:none; }
  .ai-feature { display:grid; grid-template-columns:1fr .8fr; gap:8%; align-items:center; margin-top:95px; padding-top:76px; padding-bottom:76px; border-top:1px solid var(--c-line); border-bottom:1px solid var(--c-line); }
  .ai-feature h2 { margin:25px 0; font-size:clamp(58px,8vw,118px); line-height:.9; letter-spacing:-.08em; text-transform:uppercase; }
  .ai-feature h2 span { display:block; color:var(--c-muted); }
  .ai-feature__copy > p:not(.overline) { max-width:570px; color:var(--c-soft); font-size:17px; line-height:1.5; }
  .ai-feature__copy .ai-feature__claim { color:var(--c-ink) !important; font-size:24px !important; font-weight:600; }
  .ai-feature .action-primary { margin-top:20px; }
  .ai-feature__mark { position:relative; display:flex; align-items:center; justify-content:center; height:450px; border:1px solid var(--c-line); color:transparent; -webkit-text-stroke:1px var(--c-muted); font-size:clamp(180px,22vw,330px); font-weight:800; letter-spacing:-.14em; line-height:1; }
