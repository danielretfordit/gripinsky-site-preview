---
import { Image } from 'astro:assets';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import logo from '../../assets/brand/logo.png';
import WhyGripinsky from '../../components/WhyGripinsky.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { isListed } from '../../lib/categories';
import { workViews, workCaption } from '../../lib/works';
import { canonicalUrl } from '../../lib/seo';
import { plural, rub } from '../../lib/format';

const requestedVariant = Astro.url.searchParams.get('v');
const initialVariant = ['light', 'dark', 'third'].includes(requestedVariant ?? '') ? requestedVariant! : 'dark';
const wv = await workViews();
const hero = wv.work('bugaeva-interior') ?? wv.work('tveritin-druzhba') ?? wv.work('bolshunova-ostrov-1');
const featureWork = wv.work('tveritin-druzhba');
const gallery = wv.pick(['bugaeva-interior', 'gushchina-house', 'meshkov-lake-house']);
const viz = wv.work('bolshunova-banya-1') ?? wv.work('rossoshansky-gostinaya') ?? gallery[0];
const game = wv.work('gitsuk-korabl') ?? wv.work('bagirov-korabl');
const site = (await getEntry('settings', 'site'))!.data;
const SOFTWARE = {
  '3dsmax': { name: '3ds Max', tag: '3DS MAX' },
  corona: { name: 'Corona', tag: 'CORONA RENDERER' },
  vray: { name: 'V-Ray', tag: 'V-RAY' },
  forestpack: { name: 'Forest Pack', tag: 'FOREST PACK' },
  photoshop: { name: 'Photoshop', tag: 'ADOBE PHOTOSHOP' },
  blender: { name: 'Blender', tag: 'BLENDER' },
  zbrush: { name: 'ZBrush', tag: 'ZBRUSH' },
  unreal: { name: 'Unreal Engine', tag: 'UNREAL ENGINE' },
  maya: { name: 'Maya', tag: 'MAYA' },
  substance: { name: 'Substance Painter', tag: 'SUBSTANCE PAINTER' },
} as const;
const listedCourses = await getCollection('courses', (entry) => isListed(entry.data) && (entry.data.type === 'course' || entry.id === 'baza'));
const programs = Object.entries(SOFTWARE).map(([id, program], index) => {
  const count = listedCourses.filter((course) => course.data.software.includes(program.tag)).length;
  return { id, ...program, count, number: String(index + 1).padStart(2, '0'), href: `/courses?type=course&soft=${encodeURIComponent(program.tag.toLowerCase())}#catalog-filters` };
}).filter((program) => program.count > 0);
const ai = (await getEntry('courses', 'ai'))!.data;
const reviews = await getCollection('reviews');
const proof = [
  { id: 'natalya-approach', claim: 'Учим думать', number: '01' },
  { id: 'darya-client', claim: 'Сильные работы', number: '02' },
  { id: 'bitum-community', claim: 'Сообщество рядом', number: '03' },
].map((item) => ({ ...item, review: reviews.find((entry) => entry.id === item.id) })).filter((item) => item.review);
const faqIds = ['s-chego-nachat', 'risovat', 'vremya', 'oplata', 'vozvrat'];
const faqEntries = await getCollection('faq', (entry) => entry.data.pages.includes('home') && faqIds.includes(entry.id));
const faqItems = await Promise.all(faqEntries
  .sort((a, b) => faqIds.indexOf(a.id) - faqIds.indexOf(b.id))
  .map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const stats = [
  [site.stats.graduates, 'выпускников'],
  [site.stats.years, 'учим по своей системе'],
  [site.stats.videos, 'видеоуроков'],
  [site.stats.rating, 'на Яндекс Картах'],
  [site.stats.subscribers, 'подписчиков на YouTube'],
];
import { assetPath } from '../../lib/deployment';
const portrait = assetPath('/images/evgeny-gripinsky-color.webp');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Визуальные направления главной | GRIPINSKY</title>
    <meta name="description" content="Три варианта визуального оформления главной Академии 3D GRIPINSKY на утверждённых текстах." />
    <link rel="canonical" href={canonicalUrl(Astro.url.pathname)} />
    <meta name="theme-color" content="#f2f1ed" />
  </head>
  <body data-variant={initialVariant} data-embed={Astro.url.searchParams.get('embed') === '1' ? 'true' : 'false'}>
    <aside class="compare-bar" aria-label="Сравнение визуальных направлений">
      <a class="compare-bar__back" href="/">← Текущая главная</a>
      <div class="compare-bar__options" role="group" aria-label="Выбрать вариант">
        <button type="button" data-variant-button="light" aria-pressed={initialVariant === 'light'}><span>01</span> Светлая студия</button>
        <button type="button" data-variant-button="dark" aria-pressed={initialVariant === 'dark'}><span>02</span> Тёмная архитектура</button>
        <button type="button" data-variant-button="third" aria-pressed={initialVariant === 'third'}><span>03</span> Собранный ритм</button>
      </div>
      <p class="compare-bar__note">Один текст · три визуальных решения</p>
    </aside>

    <div class="concept-page">
      <section class="hero-shell" id="top">
        <header class="site-header">
          <a href="/" class="wordmark" aria-label="GRIPINSKY, главная"><Image src={logo} alt="GRIPINSKY" width={196} height={26} densities={[1, 2, 3]} /></a>
          <nav aria-label="Разделы сайта" class="site-nav">
            <a href="#directions">3D-визуализация</a><a href="/courses">Все курсы</a><a href="#works">Работы учеников</a><a href="#club">Сообщество</a><a href="#reviews">Отзывы</a><a href="/blog">Блог</a>
          </nav>
          <a href="/#consult" class="header-cta">Бесплатная консультация <span aria-hidden="true">↗</span></a>
        </header>

        <main>
          <section class="hero" aria-labelledby="home-title">
            <div class="hero__copy">
              <p class="eyebrow"><i aria-hidden="true"></i> Онлайн-школа 3D-графики</p>
              <h1 id="home-title">Курсы 3D-графики <span>с нуля до заказов</span></h1>
              <p class="hero__lead">Визуализация интерьеров и экстерьеров, 3D для игр и нейросети в работе. В своём темпе, без опыта и умения рисовать.</p>
              <div class="hero__actions"><a class="button button--primary" href="#directions">Выбрать направление <span aria-hidden="true">↗</span></a><a class="button button--quiet" href="#quiz">Подобрать курс за 1 минуту <span aria-hidden="true">→</span></a></div>
              <div class="hero__signature"><span>АКАДЕМИЯ 3D GRIPINSKY</span><span>01 / 05</span></div>
            </div>
            {hero && <figure class="hero__image"><Image src={hero.image} alt={hero.alt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 960px) 54vw, 100vw" loading="eager" fetchpriority="high" style={`object-position:${hero.focus}`} /><figcaption><span>РАБОТА УЧЕНИКА</span>{workCaption(hero)}</figcaption><span class="hero__image-index" aria-hidden="true">GRIPINSKY / 3D</span></figure>}
            <div class="hero__technical" aria-hidden="true"><span>3D</span><i></i><span>VISUAL SYSTEM 01</span></div>
          </section>
        </main>
      </section>

      <section class="stats" aria-label="Академия в цифрах">
        {stats.map(([value, label], index) => <div class="stat"><span class="stat__index">0{index + 1}</span><strong>{value}</strong><span class="stat__label">{label}</span></div>)}
      </section>

      <section id="directions" class="section directions" aria-labelledby="directions-title">
        <div class="section-heading">
          <div><p class="eyebrow">НАПРАВЛЕНИЯ И ПРОГРАММЫ</p><h2 id="directions-title">Выберите <span>курс</span></h2></div>
          <p class="directions-intro">Начните с направления, если выбираете профессию. Или сразу найдите курсы по программе, если уже знаете, что нужно.</p>
        </div>
        <div class="program-tabs" id="programs" role="tablist" aria-label="Способ выбора курса" data-program-tabs>
          <button type="button" role="tab" id="pick-tab-dir" aria-controls="pick-dir" aria-selected="true" tabindex="0">По направлению</button>
          <button type="button" role="tab" id="pick-tab-soft" aria-controls="pick-soft" aria-selected="false" tabindex="-1">По программе</button>
        </div>
        <div role="tabpanel" id="pick-dir" aria-labelledby="pick-tab-dir">
          <div class="direction-grid">
            {[
              { image: viz, href: '/courses-page/visualization', number: '01', meta: '3 профессии', path: 'От модели до проекта по реальному ТЗ', title: '3D-визуализация', text: 'Фотореалистичные интерьеры и экстерьеры в 3ds Max и Corona.', action: 'Выбрать профессию' },
              { image: game, href: '/courses-page/gamedev', number: '02', meta: '5 профессий', path: 'От пропса до персонажа', title: '3D для игр', text: 'Предметы, локации и персонажи в Blender, ZBrush и Unreal Engine.', action: 'Смотреть курсы' },
            ].map((item) => (
              <a class="direction" href={item.href}>
                <div class="direction__image">{item.image && <Image src={item.image.image} alt={item.image.alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 48vw, 100vw" style={`object-position:${item.image.focus}`} />}<span class="direction__number">{item.number} / НАПРАВЛЕНИЕ</span><span class="direction__arrow" aria-hidden="true">↗</span></div>
                <div class="direction__content"><p class="eyebrow">{item.meta}</p><h3>{item.title}</h3><p class="direction__description">{item.text}</p><p class="direction__path">{item.path}</p><div class="direction__footer"><span>{item.action} <b aria-hidden="true">→</b></span></div></div>
              </a>
            ))}
          </div>
        </div>
        <div role="tabpanel" id="pick-soft" aria-labelledby="pick-tab-soft" hidden>
          <div class="program-index-head"><p class="eyebrow">{programs.length} программ / один каталог</p><p>Выберите программу и перейдите к курсам по ней.</p></div>
          <ol class="program-index" style={`--program-rows:${Math.ceil(programs.length / 2)}`} aria-label="Курсы по программе">
            {programs.map((program, index) => (
              <li class:list={{ 'program-index-last-left': index === Math.ceil(programs.length / 2) - 1 }}>
                <a href={program.href} aria-label={`${program.name}: ${program.count} ${plural(program.count, ['курс', 'курса', 'курсов'])}`}>
                  <span class="program-index-number" aria-hidden="true">{program.number}</span>
                  <strong class="program-index-name">{program.name}</strong>
                  <span class="program-index-count">{program.count} {plural(program.count, ['курс', 'курса', 'курсов'])}</span>
                  <span class="program-index-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="direction-links">
          <a href="/courses" class="text-link">Смотреть каталог курсов <span aria-hidden="true">↗</span></a>
          <a href="/vizualization3_mini" class="text-link">Посмотреть пробный урок <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="quiz-section section" id="quiz" aria-labelledby="quiz-title">
        <div class="quiz-copy"><p class="eyebrow"><i aria-hidden="true"></i> ТЕСТ НА 1 МИНУТУ</p><h2 id="quiz-title">Подберём <span>ваш старт</span></h2><p>Ответьте на 5 вопросов, и мы определим ваш уровень, подскажем курсы и сразу посчитаем пакет.</p><a href="/#quiz" class="text-link">Перейти к подбору <span aria-hidden="true">↗</span></a></div>
        <div class="quiz-card"><div class="quiz-card__top"><span>ВОПРОС 01 / 05</span><span class="quiz-track"><i></i></span></div><h3>Что вам интереснее создавать?</h3><ol><li><span>01</span>Интерьеры, дома и предметы <b aria-hidden="true">↗</b></li><li><span>02</span>Игровые миры: предметы, локации, персонажей <b aria-hidden="true">↗</b></li><li><span>03</span>Пока не знаю <b aria-hidden="true">↗</b></li></ol></div>
      </section>

      <div class="why-reference-only"><WhyGripinsky /></div>
      <section class="ai-section section" id="ai" aria-labelledby="ai-title">
        <div class="ai-copy"><p class="eyebrow"><i aria-hidden="true"></i> НОВЫЙ КУРС / ИИ В 3D</p><h2 id="ai-title">ИИ <span>или умри</span></h2><p class="ai-claim">ИИ не заменит 3D-художника. Его заменит художник с ИИ</p><p class="ai-description">Нейросети во всём пайплайне: референсы, 3D-модель по фото, ретопология, текстуры и сцена. Рутину отдаёте ИИ, качество доводите сами. Курс входит в «Базу 3D-визуализатора».</p><div class="ai-action"><a class="button button--primary" href="/ai">Смотреть курс <span aria-hidden="true">↗</span></a><span>от <b>{rub(ai.price)}</b></span></div></div>
        <div class="ai-graphic" aria-hidden="true"><div class="ai-graphic__top"><span>PIPELINE / 3D + AI</span><span>02—06</span></div><svg viewBox="0 0 600 390" fill="none" role="presentation"><path d="M300 46 466 138v148l-166 92-166-92V138L300 46Z"/><path d="m134 138 166 96 166-96M300 234v144M218 91v191m164-191v191M134 212l166 95 166-95M134 286l166 92 166-92"/><circle cx="300" cy="46" r="5"/><circle cx="466" cy="138" r="5"/><circle cx="134" cy="138" r="5"/><circle cx="300" cy="234" r="7"/><circle cx="466" cy="286" r="5"/><circle cx="134" cy="286" r="5"/><path class="ai-graphic__signal" d="M300 46v92m166 0-82 48m-250-48 82 48m84 48v73"/></svg><div class="ai-graphic__bottom"><span>РЕФЕРЕНС</span><span>МОДЕЛЬ</span><span>СЦЕНА</span><span>РЕНДЕР</span></div><span class="ai-graphic__cross ai-graphic__cross--one"></span><span class="ai-graphic__cross ai-graphic__cross--two"></span><div class="ai-old-mark"><span>3D × AI</span><strong>ИИ</strong><small>ЧЕЛОВЕК РЕШАЕТ</small></div></div>
      </section>

      <section id="works" class="section works" aria-labelledby="works-title">
        <div class="section-heading"><div><p class="eyebrow">РЕЗУЛЬТАТЫ</p><h2 id="works-title">Работы <span>учеников</span></h2></div><div class="works__intro"><p>Всё сделано во время учёбы. {wv.galleryCount} {plural(wv.galleryCount, ['работа', 'работы', 'работ'])} в галерее, у {wv.kings} {plural(wv.kings, ['ученика', 'учеников', 'учеников'])} «Царь горы» на 3DDD.</p><a href="/gallery" class="text-link">Смотреть галерею <span aria-hidden="true">→</span></a></div></div>
        {featureWork && <figure class="work-feature"><div class="work-feature__photo"><Image src={featureWork.image} alt={featureWork.alt} widths={[700, 1100, 1500]} sizes="100vw" style={`object-position:${featureWork.focus}`} /><span class="work-feature__index">01 / 04</span></div><figcaption><span>РАБОТА УЧЕНИКА</span>{workCaption(featureWork)}<a href="/gallery" aria-label="Смотреть работы учеников">↗</a></figcaption></figure>}
        <div class="work-grid">{gallery.map((work, index) => <figure><div class="work-grid__photo"><Image src={work.image} alt={work.alt} widths={[400, 640, 900]} sizes="(min-width: 800px) 33vw, 100vw" style={`object-position:${work.focus}`} /><span>0{index + 2}</span></div><figcaption>{workCaption(work)}</figcaption></figure>)}</div>
      </section>

      <section id="founder" class="section founder" aria-labelledby="founder-title">
        <div class="founder__composition">
          <div class="founder__copy">
            <h2 id="founder-title">Евгений <span>Грипинский</span></h2>
            <p class="founder__lead">20 лет назад Евгений создал обучающую систему, в основе которой — системный подход к знаниям, высокие стандарты качества и адресная поддержка каждого студента.</p>
            <blockquote class="founder__quote"><svg viewBox="0 0 40 32" aria-hidden="true"><path d="M6 25c3-9 6-14 11-18M21 25c3-9 6-14 11-18" /></svg><span>«Основная цель занятий — научить вас <strong>думать</strong>, а не повторять действия»</span></blockquote>
            <a class="founder__link" href="https://gripinsky.ru/teachers">Все педагоги <span aria-hidden="true">↗</span></a>
          </div>
          <div class="founder__portrait"><img src={portrait} alt="Евгений Грипинский" width="764" height="1036" loading="lazy" /></div>
        </div>
      </section>

      <section id="reviews" class="section reviews" aria-labelledby="reviews-title">
        <div class="section-heading"><div><p class="eyebrow">ПОДТВЕРЖДАЮТ УЧЕНИКИ И ЗАКАЗЧИКИ</p><h2 id="reviews-title">Не обещания. <span>Их опыт.</span></h2></div><a class="text-link" href="/otzyvy">Все отзывы и истории <span aria-hidden="true">→</span></a></div>
        <div class="review-grid">{proof.map(({ number, claim, review }) => <figure><div class="review__eyebrow"><span>{number}</span>{claim}</div><blockquote>«{review!.data.text}»</blockquote><figcaption><b>{review!.data.author}</b><span>{review!.data.role}</span></figcaption></figure>)}</div>
      </section>

      <section id="club" class="section club" aria-labelledby="club-title">
        <div class="club__intro"><p class="eyebrow"><i aria-hidden="true"></i> СООБЩЕСТВО АКАДЕМИИ</p><h2 id="club-title">Растём в 3D <span>вместе</span></h2><p>Учёба продолжается и за пределами уроков: встречаемся на эфирах, разбираем работы и следим за успехами друг друга.</p><a class="button button--dark" href="/club">Узнать о сообществе <span aria-hidden="true">↗</span></a><div class="club__diagram" aria-hidden="true"><svg viewBox="0 0 430 160" fill="none"><path d="M42 116 132 50l83 72 82-91 91 75"/><path d="M42 116h346M132 50l-6 66m89 6 0-72m82-19 0 91m91-16-91 16"/><circle cx="42" cy="116" r="6"/><circle cx="132" cy="50" r="6"/><circle cx="215" cy="122" r="6"/><circle cx="297" cy="31" r="6"/><circle cx="388" cy="106" r="6"/></svg><span>ЛЮДИ / ОПЫТ / СВЯЗЬ</span><div class="club-old-mark"><strong>МЫ</strong><span>УЧЕНИКИ · ВЫПУСКНИКИ · ПЕДАГОГИ</span></div></div></div>
        <div class="club__topics"><article><span>01</span><div><h3>GRIPINSKY TV</h3><p>Прямые эфиры по средам: разборы работ учеников и встречи с профессионалами индустрии.</p></div></article><article><span>02</span><div><h3>«Рендер дня»</h3><p>Показываем работы учеников и отмечаем лучшие на стримах академии.</p></div></article><article><span>03</span><div><h3>Люди рядом</h3><p>Выпускники, ученики и педагоги остаются на связи и делятся опытом.</p></div></article></div>
      </section>

      <section id="faq" class="section faq" aria-labelledby="faq-title"><div class="faq__heading"><p class="eyebrow">ПЕРЕД СТАРТОМ</p><h2 id="faq-title">Вопросы</h2><p>Не нашли ответ? <a href="/#consult">Спросите на консультации</a> или в <a href={site.telegramBot}>Telegram</a>.</p></div><div class="faq__list">{faqItems.map(({ entry, Content }) => <details><summary>{entry.data.question}<span aria-hidden="true">+</span></summary><div class="faq-answer"><Content /></div></details>)}</div></section>

      <section id="consult" class="consult"><div><p class="eyebrow"><i aria-hidden="true"></i> КОНСУЛЬТАЦИЯ</p><h2>Поможем выбрать <span>за 15 минут</span></h2><p>Бесплатная консультация: подберём старт, профессию и формат обучения. Перезвоним или напишем в течение дня.</p></div><a class="button button--primary" href="/#consult">Записаться на консультацию <span aria-hidden="true">↗</span></a></section>
      <footer class="site-footer"><a href="/" aria-label="На главную"><Image src={logo} alt="GRIPINSKY" width={196} height={26} densities={[1, 2, 3]} /></a><span>Онлайн-школа 3D-графики</span><nav aria-label="Социальные сети"><a href={site.youtube}>YouTube</a><a href={site.telegramChannel}>Telegram</a><a href={site.vk}>ВКонтакте</a></nav><span>Создаём будущее 3D вместе</span></footer>
    </div>

    <script>
      const body = document.body;
      const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-variant-button]')];
      const setVariant = (variant: string, updateUrl = true) => {
        const selected = ['dark', 'third'].includes(variant) ? variant : 'light';
        body.dataset.variant = selected;
        buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.variantButton === selected)));
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', selected === 'light' ? '#f2f1ed' : '#111313');
        if (updateUrl) history.replaceState(null, '', `${location.pathname}?v=${selected}${location.hash}`);
      };
      buttons.forEach((button) => button.addEventListener('click', () => setVariant(button.dataset.variantButton ?? 'light')));
      setVariant(new URL(location.href).searchParams.get('v') ?? body.dataset.variant ?? 'dark', false);

      const courseTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-program-tabs] [role="tab"]')];
      const selectCourseTab = (selected: HTMLButtonElement, focus = false) => {
        courseTabs.forEach((tab) => {
          const active = tab === selected;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          document.getElementById(tab.getAttribute('aria-controls')!)!.hidden = !active;
        });
        if (focus) selected.focus();
      };
      courseTabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectCourseTab(tab));
        tab.addEventListener('keydown', (event) => {
          let next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % courseTabs.length;
          else if (event.key === 'ArrowLeft') next = (index + courseTabs.length - 1) % courseTabs.length;
          else if (event.key === 'Home') next = 0;
