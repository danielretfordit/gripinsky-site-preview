---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import interior from '../../../assets/works/rossoshansky-gostinaya.jpg';
import interiorModel from '../../../assets/works/rossoshansky-gostinaya-model.jpg';
import exterior from '../../../assets/works/zaytseva-dom-v-lesu.jpg';
import exteriorModel from '../../../assets/works/zaytseva-dom-v-lesu-model.jpg';
import ai from '../../../assets/ai/mesh-scene.jpg';
import aiModel from '../../../assets/ai/mesh-raw.jpg';
export function getStaticPaths() {
  return import.meta.env.DEV ? ['results', 'process'].map((view) => ({ params: { view } })) : [];
}
const process = Astro.params.view === 'process';
const samples = [
  { title: 'Интерьеры PRO', label: 'Продвинутый', soft: '3ds Max / Corona', image: interior, model: interiorModel, source: 'Михаил Россошанский. Гостиная.', idea: 'Свет, композиция и материалы сразу показывают, чему посвящён курс.' },
  { title: 'Экстерьеры PRO', label: 'Продвинутый', soft: '3ds Max / Corona', image: exterior, model: exteriorModel, source: 'Зайцева. Дом в лесу.', idea: 'Одна выразительная архитектурная сцена. Хорошо читается даже на телефоне.' },
  { title: 'ИИ в 3D', label: 'Любой уровень', soft: 'ИИ / 3D', image: ai, model: aiModel, source: 'Иллюстрации из прототипа курса ИИ.', idea: 'Вариант с процессом объясняет доработку модели и её применение в готовой сцене.' },
];
---
<Base title="Обложки курсов: варианты композиции | GRIPINSKY" description="Визуальное предложение для обновления каталога." noindex consult={false}>
  <section class="wrap section pb-16">
    <p class="t-overline">Дизайн каталога / предложение</p>
    <h1 class="t-display mt-4">Курс через <span class="t-accent">его результат</span></h1>
    <p class="t-lead mt-5 max-w-[760px]">Два подхода к обложкам. Сравните, что лучше показывает обучение: законченная работа или путь от модели к рендеру.</p>
    <nav class="cover-switch" aria-label="Вариант обложек">
      <a href="/design/course-covers/results" aria-current={!process ? 'page' : undefined}>A. Результат</a>
      <a href="/design/course-covers/process" aria-current={process ? 'page' : undefined}>B. Процесс</a>
      <a href="/courses">Открыть каталог →</a>
    </nav>
    <div class="cover-grid">
      {samples.map((s) => <article>
        <div class:list={['cover-art', { process }]}>
          <Image src={s.image} alt={s.source} width={1000} class="final-image" />
          {process && <div class="model-half"><Image src={s.model} alt="Модель до финальной визуализации" width={1000} /></div>}
          <span class="cover-level">{s.label}</span>
          {s.title === 'ИИ в 3D' && <span class="cover-new">Новый курс</span>}
          <span class="cover-soft">{s.soft}</span>
          {process && <span class="cover-step">Модель / результат</span>}
        </div>
        <p class="t-overline mt-5">Курс</p>
        <h2 class="t-h3 mt-2">{s.title}</h2>
        <p class="mt-3 text-muted">{s.idea}</p>
        <p class="mt-4 text-xs text-muted">Источник визуальной пробы: {s.source}</p>
      </article>)}
    </div>
    <div class="cover-rule">
      <h2 class="t-h3">Один принцип, разные сюжеты</h2>
      <p>Для основных курсов предлагаю вариант A. Сравнение B использовать там, где процесс важен для выбора. Пакеты показывать через 2–3 проекта, услуги через реальный разбор с педагогом.</p>
      <p class="text-muted">Это пробы композиции на материалах архива. Перед размещением на карточке согласуем работу, её автора и связь с программой курса.</p>
    </div>
  </section>
</Base>
<style>
.cover-switch { display: flex; gap: 12px; flex-wrap: wrap; margin: 32px 0; }
.cover-switch a { padding: 12px 18px; border: 1px solid #59615e; border-radius: 4px; color: #ecece6; }
.cover-switch a[aria-current] { background: #ecece6; color: #0e1112; }
.cover-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
.cover-art { aspect-ratio: 16/10; position: relative; overflow: hidden; border-radius: 6px; }
.cover-art img { height: 100%; width: 100%; object-fit: cover; }
.model-half { position: absolute; inset: 0 50% 0 0; overflow: hidden; border-right: 1px solid #ecece6; }
.model-half img { width: 200%; max-width: none; }
.cover-level,.cover-new,.cover-soft,.cover-step { position: absolute; font-size: 11px; border-radius: 3px; padding: 6px 8px; line-height: 1.3; }
.cover-level { top: 14px; left: 14px; background: #ecece6; color: #0e1112; }
.cover-new { top: 14px; right: 14px; background: #f8f61a; color: #0e1112; }
.cover-soft { left: 14px; bottom: 14px; background: #0e1112e8; color: #ecece6; }
.cover-step { right: 14px; bottom: 14px; background: #0e1112e8; color: #ecece6; }
.cover-rule { border-top: 1px solid #59615e; padding-top: 32px; margin-top: 48px; max-width: 880px; }
.cover-rule p { margin-top: 16px; }
@media(max-width: 1023px) { .cover-grid { grid-template-columns: 1fr; max-width: 680px; } }
</style>
