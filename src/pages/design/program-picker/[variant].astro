---
import { getCollection } from 'astro:content';
import { isListed } from '../../../lib/categories';
import { plural } from '../../../lib/format';
import Base from '../../../layouts/Base.astro';

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return ['index', 'index-bold', 'visual', 'paths'].map((variant) => ({ params: { variant } }));
}

const variant = ['index', 'index-bold', 'visual', 'paths'].includes(Astro.params.variant ?? '') ? Astro.params.variant : 'index';
const SOFTWARE = {
  '3dsmax': { name: '3ds Max', tag: '3DS MAX' },
  corona: { name: 'Corona', tag: 'CORONA RENDERER' },
  vray: { name: 'V-Ray', tag: 'V-RAY' },
  forestpack: { name: 'Forest Pack', tag: 'FOREST PACK' },
  photoshop: { name: 'Photoshop', tag: 'ADOBE PHOTOSHOP' },
  blender: { name: 'Blender', tag: 'BLENDER' },
  zbrush: { name: 'ZBrush', tag: 'ZBRUSH' },
  unreal: { name: 'Unreal Engine', tag: 'UNREAL ENGINE' },
  maya: { name: 'Maya', tag: 'MAYA' },
  substance: { name: 'Substance Painter', tag: 'SUBSTANCE PAINTER' },
} as const;
type SoftId = keyof typeof SOFTWARE;
const listed = await getCollection('courses', (c) => isListed(c.data) && (c.data.type === 'course' || c.id === 'baza'));
const programs = (Object.keys(SOFTWARE) as SoftId[]).map((id, i) => {
  const data = SOFTWARE[id];
  const count = listed.filter((c) => c.data.software.includes(data.tag)).length;
  return { id, name: data.name, tag: data.tag, count, number: String(i + 1).padStart(2, '0'), href: '/courses?type=course&soft=' + encodeURIComponent(data.tag.toLowerCase()) + '#catalog-filters' };
});
const byId = new Map(programs.map((p) => [p.id, p]));
const paths: Array<{ label: string; note: string; ids: SoftId[] }> = [
  { label: 'Моделирование и форма', note: 'Создать объект и проработать геометрию', ids: ['3dsmax', 'blender', 'maya', 'zbrush'] },
  { label: 'Сцена и рендер', note: 'Свет, окружение и итоговое изображение', ids: ['corona', 'vray', 'forestpack', 'unreal'] },
  { label: 'Материалы и подача', note: 'Текстуры и обработка изображения', ids: ['substance', 'photoshop'] },
];
const labels: Record<string, string> = { index: 'Указатель / строгий', 'index-bold': 'Указатель / крупная типографика', visual: 'Обзор программ', paths: 'Группы по задаче' };
const current = programs[0];
---
<Base title={'Выбор по программе: ' + labels[variant!] + ' | GRIPINSKY'} description="Локальные варианты блока выбора программ" noindex consult={false}>
  <div class:list={['picker-preview', 'picker-preview--' + variant]}>
    <header class="wrap preview-head">
      <p class="t-overline">Дизайн-предпросмотр / выбор программы</p>
      <div class="preview-head-row">
        <div><h1>{labels[variant!]}</h1><p>Два оформления выбранного указателя с реальными программами и переходами в каталог.</p></div>
        <nav aria-label="Варианты композиции">
          <a href="/design/program-picker/index" aria-current={variant === 'index' ? 'page' : undefined}>А / Строгий</a>
          <a href="/design/program-picker/index-bold" aria-current={variant === 'index-bold' ? 'page' : undefined}>Б / Крупный</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="wrap section picker-section" aria-labelledby="pick-title">
        <div class="head picker-head">
          <p class="t-overline">Направления и программы</p>
          <h2 id="pick-title" class="t-h2">Выберите <span class="t-accent">курс</span></h2>
          <p class="picker-intro">Начните с направления, если выбираете профессию. Или сразу найдите курсы по программе, если уже знаете, что нужно.</p>
        </div>

        <div class="pick-tabs" role="tablist" aria-label="Способ выбора курса" data-picker-tabs>
          <button id="picker-dir-tab" type="button" role="tab" aria-controls="picker-dir" aria-selected="false" tabindex="-1">По направлению</button>
          <button id="picker-soft-tab" type="button" role="tab" aria-controls="picker-soft" aria-selected="true" tabindex="0">По программе</button>
        </div>

        <div id="picker-dir" role="tabpanel" aria-labelledby="picker-dir-tab" hidden>
          <p class="panel-lead">Выберите сферу, если ещё не знаете, с какой программы начать.</p>
          <div class="direction-list">
            <a href="/courses-page/visualization"><span class="direction-no">01 / НАПРАВЛЕНИЕ</span><strong>3D-визуализация</strong><span>Фотореалистичные интерьеры и экстерьеры в 3ds Max и Corona для дизайнеров и застройщиков.</span><span class="direction-link">Выбрать профессию →</span></a>
            <a href="/courses-page/gamedev"><span class="direction-no">02 / НАПРАВЛЕНИЕ</span><strong>3D для игр</strong><span>Предметы, локации и персонажи в Blender, ZBrush и Unreal Engine.</span><span class="direction-link">Смотреть курсы →</span></a>
          </div>
        </div>

        <div id="picker-soft" role="tabpanel" aria-labelledby="picker-soft-tab">
          {(variant === 'index' || variant === 'index-bold') && <div class="editorial">
            <div class="panel-intro"><p class="t-overline">10 программ / один каталог</p><p>Знакомое название ведёт сразу к подходящим курсам.</p></div>
            <ol class="editorial-list">
              {programs.map((p) => <li><a href={p.href} aria-label={p.name + ': ' + p.count + ' ' + plural(p.count, ['курс', 'курса', 'курсов'])}>
                <span class="editorial-no">{p.number}</span>
                <strong>{p.name}</strong>
                <span class="editorial-count">{p.count} {plural(p.count, ['курс', 'курса', 'курсов'])}</span>
                <span class="editorial-arrow" aria-hidden="true">↗</span>
              </a></li>)}
            </ol>
          </div>}

          {variant === 'visual' && <div class="browser" data-browser>
            <div class="browser-stage">
              <p class="t-overline">Программа / каталог курсов</p>
              <div class="browser-stage-main">
                <span class="browser-stage-number" data-stage-number>01 / 10</span>
                <h3 data-stage-title>{current.name}</h3>
              </div>
              <div class="browser-stage-foot">
                <span data-stage-count>{current.count} {plural(current.count, ['курс', 'курса', 'курсов'])}</span>
                <a href={current.href} data-stage-link>Курсы по программе →</a>
              </div>
            </div>
            <div class="browser-index">
              <p class="browser-hint"><span class="hint-desktop">Наведите на название или выберите программу</span><span class="hint-mobile">Выберите программу</span></p>
              <ol>
                {programs.map((p) => <li><a href={p.href} data-preview-name={p.name} data-preview-number={p.number} data-preview-count={p.count} data-preview-href={p.href} data-active={p.number === '01' ? 'true' : undefined}>
                  <span class="browser-no">{p.number}</span><strong>{p.name}</strong><span class="browser-count">{p.count}</span><span class="browser-arrow" aria-hidden="true">↗</span>
                </a></li>)}
              </ol>
            </div>
          </div>}

          {variant === 'paths' && <div class="paths">
            <div class="panel-intro"><p class="t-overline">Выберите знакомую задачу</p><p>Программы собраны по типу работы. Каждая ссылка открывает отфильтрованный каталог.</p></div>
            {paths.map((group, i) => <section class="path-group" aria-labelledby={'path-' + i}>
              <div class="path-label"><span class="path-no">0{i + 1} / 03</span><h3 id={'path-' + i}>{group.label}</h3><p>{group.note}</p></div>
              <ul>{group.ids.map((id) => { const p = byId.get(id)!; return <li><a href={p.href} aria-label={p.name + ': ' + p.count + ' ' + plural(p.count, ['курс', 'курса', 'курсов'])}><span><strong>{p.name}</strong><small>{p.count} {plural(p.count, ['курс', 'курса', 'курсов'])}</small></span><span class="path-arrow" aria-hidden="true">↗</span></a></li>; })}</ul>
            </section>)}
          </div>}
        </div>

        <a href="/courses" class="catalog-link">Смотреть каталог курсов →</a>
      </section>
    </main>
  </div>
</Base>

<style>
  .picker-preview { background: #0E1112; color: var(--color-ink); }
  .picker-preview * { box-sizing: border-box; }
  .picker-preview h1, .picker-preview h2, .picker-preview h3, .picker-preview p, .picker-preview ol, .picker-preview ul { margin: 0; }
  .preview-head { padding-top: 36px; padding-bottom: 40px; border-bottom: 1px solid var(--color-line); }
  .preview-head-row { display: flex; justify-content: space-between; align-items: end; gap: 28px; margin-top: 12px; }
  .preview-head h1 { font-size: clamp(26px, 3vw, 42px); font-weight: 750; line-height: 1; letter-spacing: -.03em; text-transform: uppercase; }
  .preview-head-row p { max-width: 540px; margin-top: 12px; color: var(--color-ink-2); font-size: 15px; }
  .preview-head nav { display: flex; flex-wrap: wrap; gap: 8px; }
  .preview-head nav a { display: inline-flex; min-height: 44px; align-items: center; border: 1px solid var(--color-line-strong); border-radius: 4px; padding: 0 13px; font: 500 12px var(--font-mono); text-transform: uppercase; }
  .preview-head nav a[aria-current] { border-color: var(--color-ink); background: var(--color-bg-2); }
  .picker-section { padding-bottom: var(--space-section); }
  .picker-head { max-width: 840px; }
  .picker-intro { max-width: 640px; color: var(--color-ink-2); font-size: 17px; line-height: 1.5; }
  .pick-tabs { display: flex; width: max-content; max-width: 100%; gap: clamp(20px,3vw,40px); border-bottom: 1px solid var(--color-line); margin-bottom: 32px; }
  .pick-tabs button { position: relative; min-height: 54px; border: 0; background: transparent; padding: 0 0 14px; color: var(--color-muted); font-size: 16px; font-weight: 650; white-space: nowrap; }
  .pick-tabs button:hover, .pick-tabs button[aria-selected="true"] { color: var(--color-ink); }
  .pick-tabs button[aria-selected="true"]::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--color-lime); }
  [role="tabpanel"][hidden] { display: none; }
  .panel-lead { max-width: 600px; margin-bottom: 20px !important; color: var(--color-ink-2); }
  .direction-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--gap-grid); }
  .direction-list a { display: flex; flex-direction: column; min-height: 220px; gap: 12px; border-top: 1px solid var(--color-line); padding: 22px 16px 0 0; }
  .direction-list a:hover strong { color: #fff; }
  .direction-no, .path-no { color: var(--color-muted); font: 500 12px/1.4 var(--font-mono); letter-spacing: .04em; }
  .direction-list strong { font-size: clamp(22px,2.3vw,32px); line-height: 1.15; }
  .direction-list a > span:nth-child(3) { max-width: 440px; color: var(--color-ink-2); font-size: 16px; line-height: 1.5; }
  .direction-link { margin-top: auto; font-weight: 650; }
  .catalog-link { display: inline-flex; min-height: 48px; align-items: center; margin-top: 28px; border-bottom: 1px solid var(--color-line-strong); font-weight: 650; }
  .catalog-link:hover { border-color: var(--color-ink); }
  .panel-intro { display: flex; justify-content: space-between; align-items: end; gap: 24px; padding: 0 0 22px; }
  .panel-intro > p:last-child { max-width: 500px; color: var(--color-ink-2); font-size: 16px; line-height: 1.5; }

  .editorial-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); grid-auto-flow: column; grid-template-rows: repeat(5,auto); column-gap: var(--gap-grid); padding: 0; list-style: none; }
  .editorial-list li { min-width: 0; border-top: 1px solid var(--color-line); }
  .editorial-list li:nth-child(5), .editorial-list li:nth-child(10) { border-bottom: 1px solid var(--color-line); }
  .editorial-list a { position: relative; display: grid; grid-template-columns: 28px minmax(0,1fr) auto 18px; align-items: center; gap: 16px; min-height: 96px; padding: 12px 8px 12px 0; transition: background-color .18s ease; }
  .editorial-list a::before { position: absolute; top: 14px; bottom: 14px; left: 0; width: 2px; background: var(--color-lime); content: ''; opacity: 0; transition: opacity .18s ease; }
  .editorial-list a:hover, .editorial-list a:focus-visible { background: var(--color-surface); }
  .editorial-list a:hover::before, .editorial-list a:focus-visible::before { opacity: 1; }
  .editorial-no, .editorial-count { color: var(--color-muted); font: 500 12px/1.4 var(--font-mono); white-space: nowrap; }
  .editorial-no { padding-left: 8px; }
  .editorial-list strong { overflow-wrap: anywhere; font-size: clamp(24px,2.3vw,32px); font-weight: 700; line-height: 1.1; letter-spacing: -.035em; transition: transform .18s ease; }
  .editorial-list a:hover strong, .editorial-list a:focus-visible strong { transform: translateX(4px); }
  .editorial-arrow { color: var(--color-muted); font-size: 20px; transition: color .18s ease, transform .18s ease; }
  .editorial-list a:hover .editorial-arrow, .editorial-list a:focus-visible .editorial-arrow { color: var(--color-ink); transform: translate(2px,-2px); }
  .picker-preview--index-bold .editorial-list a { grid-template-columns: minmax(0,1fr) 18px; grid-template-rows: auto auto; align-content: center; gap: 5px 16px; min-height: 120px; padding-left: 12px; }
  .picker-preview--index-bold .editorial-no { display: none; }
  .picker-preview--index-bold .editorial-list strong { grid-column: 1; grid-row: 1; font-size: clamp(32px,3.2vw,44px); font-weight: 750; letter-spacing: -.05em; }
  .picker-preview--index-bold .editorial-count { grid-column: 1; grid-row: 2; }
  .picker-preview--index-bold .editorial-arrow { grid-column: 2; grid-row: 1 / 3; }

  .browser { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); border-top: 1px solid var(--color-line); }
  .browser-stage { position: sticky; top: calc(var(--header-h) + 16px); display: flex; flex-direction: column; align-self: start; min-height: 600px; padding: 24px 44px 24px 0; border-right: 1px solid var(--color-line); }
  .browser-stage-main { display: flex; flex: 1; flex-direction: column; align-items: flex-start; justify-content: center; }
  .browser-stage-main > span { color: var(--color-lime); font: 500 14px var(--font-mono); }
  .browser-stage h3 { max-width: 720px; margin-top: 10px; overflow-wrap: anywhere; font-size: clamp(56px,6vw,92px); font-weight: 750; letter-spacing: -.065em; line-height: .94; }
  .browser-stage-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; border-top: 1px solid var(--color-line); padding-top: 18px; }
  .browser-stage-foot span { color: var(--color-muted); font: 500 13px var(--font-mono); }
  .browser-stage-foot a { display: inline-flex; min-height: 44px; align-items: center; font-weight: 650; }
  .browser-index { padding-left: 44px; }
  .browser-hint { padding: 24px 0 16px; color: var(--color-muted); font: 500 12px var(--font-mono); text-transform: uppercase; }
  .hint-mobile { display: none; }
  .browser-index ol { padding: 0; list-style: none; }
  .browser-index li { border-top: 1px solid var(--color-line); }
  .browser-index li:last-child { border-bottom: 1px solid var(--color-line); }
  .browser-index a { display: grid; grid-template-columns: 26px minmax(0,1fr) 25px 16px; align-items: center; gap: 12px; min-height: 66px; padding: 10px 4px; }
  .browser-index a[data-active="true"], .browser-index a:hover, .browser-index a:focus-visible { background: var(--color-bg-2); }
  .browser-no, .browser-count { color: var(--color-muted); font: 500 12px var(--font-mono); }
  .browser-index strong { overflow-wrap: anywhere; font-size: 19px; line-height: 1.2; }
  .browser-arrow { color: var(--color-muted); }

  .paths { border-top: 1px solid var(--color-line); }
  .paths .panel-intro { padding-top: 24px; }
  .path-group { display: grid; grid-template-columns: minmax(220px,.7fr) minmax(0,1.8fr); gap: 40px; border-top: 1px solid var(--color-line); padding: 28px 0 36px; }
  .path-label h3 { max-width: 320px; margin-top: 15px; font-size: clamp(25px,2.8vw,40px); font-weight: 700; line-height: 1.08; letter-spacing: -.035em; }
  .path-label p { max-width: 280px; margin-top: 12px; color: var(--color-ink-2); font-size: 15px; line-height: 1.5; }
  .path-group ul { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0 20px; padding: 0; list-style: none; }
  .path-group li { border-top: 1px solid var(--color-line); }
  .path-group li:nth-last-child(-n+2) { border-bottom: 1px solid var(--color-line); }
  .path-group a { display: grid; grid-template-columns: minmax(0,1fr) 18px; align-items: center; gap: 14px; min-height: 84px; padding: 12px 2px; }
  .path-group a:hover, .path-group a:focus-visible { background: var(--color-bg-2); }
  .path-group a > span:first-child { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .path-group strong { overflow-wrap: anywhere; font-size: 18px; line-height: 1.2; }
  .path-group small { color: var(--color-muted); font: 500 12px/1.4 var(--font-mono); }
  .path-arrow { color: var(--color-muted); }
  @media (max-width: 1023px) {
    .preview-head-row { flex-direction: column; align-items: flex-start; }
    .editorial-list { column-gap: 20px; }
    .editorial-list a { grid-template-columns: 24px minmax(0,1fr) 18px; gap: 9px; }
    .editorial-count { display: none; }
    .picker-preview--index-bold .editorial-list a { grid-template-columns: minmax(0,1fr) 18px; grid-template-rows: auto auto; }
    .picker-preview--index-bold .editorial-count { display: block; }
    .browser-stage { padding-right: 24px; }
    .browser-index { padding-left: 24px; }
    .path-group { gap: 20px; }
  }
  @media (max-width: 767px) {
    .preview-head { padding-top: 28px; padding-bottom: 32px; }
    .preview-head nav { width: 100%; }
    .preview-head nav a { flex: 1 1 100px; justify-content: center; text-align: center; }
    .pick-tabs { width: 100%; }
    .pick-tabs button { flex: 1; padding-right: 0; padding-left: 0; }
    .panel-intro { display: block; }
    .panel-intro > p:last-child { margin-top: 10px; }
    .editorial-list { display: block; }
    .editorial-list li:nth-child(5) { border-bottom: 0; }
    .editorial-list a { min-height: 82px; grid-template-columns: 22px minmax(0,1fr) auto 16px; gap: 8px; }
    .editorial-list strong { font-size: 22px; }
    .editorial-count { display: block; font-size: 11px; }
    .picker-preview--index-bold .editorial-list a { min-height: 104px; }
    .picker-preview--index-bold .editorial-list strong { font-size: 30px; }
    .direction-list, .browser, .path-group { grid-template-columns: 1fr; }
    .direction-list { gap: 20px; }
    .direction-list a { min-height: 0; padding-bottom: 20px; }
    .browser-stage { position: static; min-height: 270px; padding: 20px 0; border-right: 0; }
    .browser-stage-main { display: flex; flex-direction: column; justify-content: center; }
    .browser-stage-main > span { margin: 0; }
    .browser-stage h3 { margin-top: 4px; font-size: clamp(38px,9vw,54px); }
    .browser-index { padding-left: 0; }
    .browser-hint { padding-top: 12px; }
    .hint-desktop { display: none; }
    .hint-mobile { display: inline; }
    .browser-index a { min-height: 60px; }
    .path-group { gap: 18px; padding: 24px 0; }
    .path-label h3 { margin-top: 8px; }
    .path-group ul { gap: 0 12px; }
    .path-group a { min-height: 72px; gap: 9px; }
    .path-group strong { font-size: 16px; }
  }
  @media (max-width: 480px) {
    .editorial-list a { grid-template-columns: 18px minmax(0,1fr) 14px; grid-template-rows: auto auto; min-height: 82px; }
    .editorial-no, .editorial-arrow { grid-row: 1 / 3; }
    .editorial-list strong { grid-column: 2; grid-row: 1; align-self: end; }
    .editorial-count { display: block; grid-column: 2; grid-row: 2; align-self: start; font-size: 11px; }
    .editorial-arrow { grid-column: 3; }
    .picker-preview--index-bold .editorial-list a { grid-template-columns: minmax(0,1fr) 14px; }
    .picker-preview--index-bold .editorial-list strong, .picker-preview--index-bold .editorial-count { grid-column: 1; }
    .picker-preview--index-bold .editorial-arrow { grid-column: 2; }
    .path-group ul { grid-template-columns: 1fr; }
    .path-group li:nth-last-child(2) { border-bottom: 0; }
    .path-group a { grid-template-columns: minmax(0,1fr) 18px; }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-picker-tabs] [role="tab"]')];
  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const active = t === tab;
      t.setAttribute('aria-selected', String(active));
      t.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !active;
    }
    if (focus) tab.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        select(tabs[(i + 1) % tabs.length], true);
      }
    });
  });

  const browser = document.querySelector<HTMLElement>('[data-browser]');
  if (browser) {
    const title = browser.querySelector<HTMLElement>('[data-stage-title]')!;
    const number = browser.querySelector<HTMLElement>('[data-stage-number]')!;
    const count = browser.querySelector<HTMLElement>('[data-stage-count]')!;
    const link = browser.querySelector<HTMLAnchorElement>('[data-stage-link]')!;
    const rows = [...browser.querySelectorAll<HTMLAnchorElement>('[data-preview-name]')];
    const preview = (row: HTMLAnchorElement) => {
      title.textContent = row.dataset.previewName!;
      number.textContent = row.dataset.previewNumber + ' / 10';
      const n = Number(row.dataset.previewCount);
      count.textContent = n + ' ' + (n % 10 === 1 && n % 100 !== 11 ? 'курс' : [2,3,4].includes(n % 10) && ![12,13,14].includes(n % 100) ? 'курса' : 'курсов');
      link.href = row.dataset.previewHref!;
      rows.forEach((r) => r.dataset.active = String(r === row));
    };
    rows.forEach((row) => {
      row.addEventListener('mouseenter', () => preview(row));
      row.addEventListener('focus', () => preview(row));
    });
  }
</script>
