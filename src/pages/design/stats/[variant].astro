---
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import HeroWork from '../../../components/HeroWork.astro';
import { workViews } from '../../../lib/works';

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return ['clean', 'lead', 'line', 'focus'].map((variant) => ({ params: { variant } }));
}

const requested = Astro.params.variant;
const variant = requested === 'lead' || requested === 'line' ? requested : 'clean';
const names = { clean: 'Чистый ряд', lead: 'Первый акцент', line: 'Общая линия' };
const site = (await getEntry('settings', 'site'))!.data;
const s = site.stats;
const stats = [
  { value: s.graduates, label: 'выпускников' },
  { value: s.years, label: 'учим по своей системе' },
  { value: s.videos, label: 'видеоуроков' },
  { value: s.rating, label: 'на Яндекс Картах', href: site.yandexMaps },
  { value: s.subscribers, label: 'подписчиков на YouTube', href: site.youtube },
];
const wv = await workViews();
const hero = wv.work('bolshunova-ostrov-1') ?? wv.pick(['tveritin-druzhba', 'rossoshansky-gostinaya'])[0];
---
<Base title={`Пять цифр: ${names[variant]} | GRIPINSKY`} description="Локальный предпросмотр блока статистики после первого экрана" noindex consult={false}>
  <header class="wrap preview-bar">
    <p class="t-overline">Дизайн-предпросмотр / пять цифр в ряд</p>
    <nav aria-label="Оформление строки статистики">
      <a href="/design/stats/clean#stats" aria-current={variant === 'clean' ? 'page' : undefined}>А / чисто</a>
      <a href="/design/stats/lead#stats" aria-current={variant === 'lead' ? 'page' : undefined}>Б / акцент</a>
      <a href="/design/stats/line#stats" aria-current={variant === 'line' ? 'page' : undefined}>В / линия</a>
    </nav>
  </header>

  {hero && <HeroWork work={hero} kicker="Онлайн-школа 3D-графики" id="preview-hero-title">
    <h1 slot="title" id="preview-hero-title" class="t-hero">Курсы <span class="whitespace-nowrap">3D-графики</span> <span class="t-accent block">с нуля до заказов</span></h1>
    <p slot="lead" class="t-lead m-0 max-w-[540px] !text-ink">Визуализация интерьеров и экстерьеров, 3D для игр и нейросети в работе. В своём темпе, без опыта и умения рисовать.</p>
    <Fragment slot="cta"><a href="/courses" class="btn btn-primary btn-lg">Выбрать направление</a></Fragment>
  </HeroWork>}

  <section id="stats" class={`wrap stats-row stats-row--${variant}`} aria-label="Академия в цифрах">
    <dl class="stats-row__list" aria-label="Пять показателей академии">
      {stats.map((stat) => (
        <div class="stats-row__item">
          <dd>
            {stat.href
              ? <a href={stat.href} rel="noopener" aria-label={stat.value + ', ' + stat.label}>{stat.value}</a>
              : stat.value}
          </dd>
          <dt>
            {stat.href
              ? <a href={stat.href} rel="noopener">{stat.label} <span aria-hidden="true">↗</span></a>
              : stat.label}
          </dt>
        </div>
      ))}
    </dl>
    <p class="stats-row__hint t-overline" aria-hidden="true">Листайте горизонтально</p>
  </section>

  <section class="wrap next-section" aria-labelledby="next-title">
    <p class="t-overline">Направления и программы</p>
    <h2 id="next-title" class="t-h2">Выберите <span class="t-accent">курс</span></h2>
    <p>Начните с направления, если выбираете профессию. Или сразу найдите курсы по программе, если уже знаете, что нужно.</p>
  </section>
</Base>

<style>
  .preview-bar { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px 32px; padding-block: 14px; }
  .preview-bar p { margin: 0; }
  .preview-bar nav { display: flex; flex-wrap: wrap; gap: 10px 24px; }
  .preview-bar nav a { color: var(--color-muted); font: 500 var(--type-meta)/1.4 var(--font-mono); text-transform: uppercase; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; }
  .preview-bar nav a[aria-current] { color: var(--color-ink); text-decoration-color: var(--color-lime); }
  .preview-bar nav a:hover { color: var(--color-ink); }
  .stats-row { padding-top: 24px; padding-bottom: 20px; }
  .stats-row__list { display: flex; align-items: end; justify-content: space-between; gap: 28px; margin: 0; }
  .stats-row__item { flex: 0 0 auto; min-width: 0; }
  .stats-row__item dd { margin: 0; color: var(--color-ink); font-size: var(--type-number); font-weight: 750; line-height: 1; letter-spacing: -.025em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .stats-row__item dt { margin-top: 8px; color: var(--color-muted); font-size: var(--type-small); line-height: 1.35; white-space: nowrap; }
  .stats-row__item a { color: inherit; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; }
  .stats-row__item a:hover, .stats-row__item a:focus-visible { text-decoration-color: currentColor; }
  .stats-row--lead .stats-row__item:first-child dd { font-size: var(--type-page-title); font-weight: 800; letter-spacing: -.035em; }
  .stats-row--line .stats-row__list { padding-bottom: 16px; background: linear-gradient(to right, var(--color-lime) 0 20px, var(--color-line-strong) 20px 100%) left bottom / 100% 1px no-repeat; }
  .stats-row--line .stats-row__item dt { font-family: var(--font-mono); font-size: var(--type-meta); letter-spacing: .015em; }
  .stats-row__hint { display: none; }
  .next-section { padding-top: var(--space-sub); padding-bottom: var(--space-section); }
  .next-section .t-overline { margin: 0 0 12px; }
  .next-section .t-h2 { margin: 0 0 16px; }
  .next-section > p:last-child { max-width: 640px; margin: 0; color: var(--color-ink-2); }
  @media (max-width: 1199px) {
    .stats-row { overflow: hidden; }
    .stats-row__list { justify-content: flex-start; gap: 28px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; scrollbar-width: none; -webkit-overflow-scrolling: touch; padding-bottom: 6px; }
    .stats-row__list::-webkit-scrollbar { display: none; }
    .stats-row__item { scroll-snap-align: start; }
    .stats-row--line .stats-row__list { padding-bottom: 16px; }
    .stats-row__hint { display: block; margin: 6px 0 0; color: var(--color-muted); }
  }
  @media (max-width: 767px) {
    .preview-bar nav { width: 100%; }
    .stats-row { padding-top: 18px; padding-bottom: 12px; }
    .stats-row__item dt { margin-top: 6px; }
    .stats-row--lead .stats-row__item:first-child dd { font-size: var(--type-display); }
  }
</style>
