---
import Base from '../../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import render from '../../../assets/home/ba-render.jpg';
import model from '../../../assets/home/ba-model.jpg';
const c=(await getEntry('courses','interiorpro'))!.data;
const steps=[
 {label:'Сцена',title:'Построить пространство',text:'Чертежи, пропорции, эргономика и организация сцены.',image:model},
 {label:'Изображение',title:'Настроить визуальную подачу',text:'Свет, материалы, камера и продуманная композиция.',image:render},
 {label:'Проект',title:'Представить результат',text:'Согласование с заказчиком и основы анимационной подачи.',image:render}
];
const labels=['Задача и сцена','Рабочий процесс','Работа с заказчиком','Камера и UV','Анимационная подача'];
---
<Base title="Дизайн страницы курса | Интерьеры PRO" description="Визуальная концепция страницы курса GRIPINSKY" noindex consult={false}>
 <aside class="design-note wrap t-small">Дизайн-концепция. Изображения иллюстрируют оформление. Работы выпускников и отзывы показаны как места для будущего контента.</aside>
 <section class="course-hero wrap" aria-labelledby="page-title">
  <div class="hero-copy">
   <a href="/interiorpro" class="t-small link">К текущей странице курса</a>
   <p class="t-overline">3D-визуализация / Продвинутый уровень</p>
   <h1 id="page-title" class="t-display">Интерьеры PRO.<br/><span class="text-heading-muted">От сцены<br/>к проекту.</span></h1>
   <p class="t-lead">Создавайте интерьерные визуализации по ТЗ: от чертежей и камеры до подачи заказчику.</p>
   <div class="hero-facts"><div><strong class="t-num">73</strong><span class="t-small">видеоурока</span></div><div><strong class="t-title">3ds Max + Corona</strong><span class="t-small">основные инструменты</span></div></div>
   <div class="hero-actions"><a href="#price" class="btn btn-primary">Выбрать курс, 29 900 ₽</a><a href="#program" class="btn btn-secondary">Посмотреть программу</a></div>
   <a href={c.trial!} class="t-small link">Сначала бесплатные уроки →</a>
  </div>
  <figure class="hero-picture"><div class="hero-signature t-overline"><span>Академия 3D GRIPINSKY</span><span>Interior / PRO</span></div><Image src={render} alt="Иллюстрация интерьерной визуализации с панорамными окнами" widths={[640,960,1400]} sizes="(min-width:1024px) 45vw, 100vw" loading="eager"/><figcaption class="t-small">Свет. Материалы. Композиция.<span>Визуальные материалы сайта</span></figcaption></figure>
 </section>
 <nav class="course-nav" aria-label="Разделы курса"><div class="wrap"><a href="#result">Результат</a><a href="#program">Программа</a><a href="#format">Обучение</a><a href="#works">Работы</a><a href="#reviews">Отзывы</a><a href="#price">Стоимость</a></div></nav>
 <section id="result" class="wrap section">
  <div class="section-intro"><p class="t-overline">01 / Что изменится в вашей работе</p><h2 class="t-h2">Не отдельные настройки.<br/><span class="text-heading-muted">Цельный интерьерный проект.</span></h2><p class="t-lead">Свяжите техническую часть с задачей заказчика. Каждый этап ведёт к следующему: подготовка сцены, визуальная подача, представление результата.</p></div>
  <div class="result-grid">{steps.map((s,i)=><article><div class="step-image media-frame media-frame--card"><Image src={s.image} alt={`Иллюстрация этапа: ${s.label}`} widths={[480,800]} sizes="(min-width:1024px) 30vw, 90vw" class:list={[i===2&&'presentation-crop']}/><span class="image-tag t-overline">0{i+1} / {s.label}</span></div><h3 class="t-h3">{s.title}</h3><p class="t-body text-ink-2">{s.text}</p></article>)}</div>
 </section>
 <section class="wrap section"><div class="audience-panel"><div><p class="t-overline">Подготовка</p><h2 class="t-h2">Уже умеете моделировать.<br/><span class="text-heading-muted">Готовы усложнить задачу?</span></h2></div><div><p class="t-lead">Курс для визуализаторов с базой 3ds Max и Corona, дизайнеров интерьера и практикующих специалистов.</p><details class="entry-details"><summary class="t-title">Проверьте, подходит ли ваш уровень</summary><ul class="t-body">{c.prerequisites.map(p=><li>{p}</li>)}</ul><a href="/courses-page/visualization#base" class="link t-small">Посмотреть базовую подготовку →</a></details></div></div></section>
 <section id="program" class="wrap section">
  <div class="section-intro"><p class="t-overline">02 / Маршрут обучения</p><h2 class="t-h2">Пять этапов.<br/><span class="text-heading-muted">Один рабочий процесс.</span></h2><p class="t-lead">Выберите этап: увидите темы, практику и результат. Подробности остаются рядом с задачей, к которой относятся.</p></div>
  <div class="program-layout" data-program>
   <div class="stage-nav" role="tablist" aria-label="Этапы программы">{c.modules.map((m,i)=><button id={`tab-${i}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`stage-${i}`} tabindex={i===0?0:-1} data-stage={i}><span class="t-overline">0{i+1}</span><span class="t-title">{labels[i]}</span><span aria-hidden="true" class="stage-dot"></span></button>)}</div>
   <div>{c.modules.map((m,i)=><article id={`stage-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} tabindex="0" hidden={i!==0} class="stage-panel"><div class="stage-panel-head"><p class="t-overline">Этап 0{i+1} / 05</p><h3 class="t-h3">{m.title}</h3><p class="t-body text-ink-2">{m.description}</p></div><div class="stage-visual"><Image src={i===0?model:render} alt="Иллюстрация процесса подготовки интерьерной сцены" widths={[640,960]} sizes="(min-width:1024px) 55vw, 90vw"/><span class="t-meta">Иллюстрация процесса</span></div><div class="stage-content"><div><span class="t-overline">Темы</span><ul class="topic-chips">{m.topics.map(t=><li class="t-small">{t}</li>)}</ul><p class="t-body"><b>Практика: </b>{m.practice}</p></div><div class="stage-result"><span class="t-overline">На выходе</span><p class="t-title">{m.result}</p></div></div></article>)}</div>
  </div>
 </section>
 <section id="format" class="wrap section"><div class="format-grid"><div><p class="t-overline">03 / Как проходит обучение</p><h2 class="t-h2">Смотрите.<br/>Применяйте.<br/><span class="text-heading-muted">Уточняйте.</span></h2><a href={c.trial!} class="link t-small">Познакомиться с подачей →</a></div><div class="format-list">{[['01','Разберите приём','Уроки в записи помогают последовательно изучать инструменты и возвращаться к нужным объяснениям.'],['02','Выполните практику','Примените тему урока к учебной сцене и сравните результат с референсом.'],['03','Соберите свой процесс','Объедините навыки подготовки сцены, композиции и подачи в работе над проектом.']].map(([n,title,text])=><article><span class="t-overline">{n}</span><div><h3 class="t-h3">{title}</h3><p class="t-body text-ink-2">{text}</p></div></article>)}</div></div>
  <div class="teacher-strip"><span class="t-overline">Преподаватели курса</span><div>{['Мария Гохман','Виктор Тверитин','Александр Зайцев','Александр Фролов'].map(name=><span class="t-title">{name}</span>)}</div></div>
 </section>
 <section id="works" class="wrap section"><div class="gallery-heading"><div><p class="t-overline">04 / Результаты учеников</p><h2 class="t-h2">Лучше увидеть.</h2></div><p class="t-body text-ink-2">Здесь будут работы выпускников именно этого курса: крупные изображения, автор и задача проекта.</p></div>
  <div class="work-layout"><figure class="work-main"><div class="work-placeholder"><svg viewBox="0 0 800 600" aria-hidden="true"><path d="M110 440V150L420 75 700 160V440L405 540Z M420 75V370L110 440 M420 370L700 440 M160 195L350 150V350L160 390Z M475 145L640 190V365L475 320Z M235 410L405 365 550 420 380 470Z M235 410V455L380 520V470 M550 420V465L380 520"/><path class="soft-line" d="M405 540V370 M80 480L410 390 740 480 M110 150L420 370 700 160"/></svg><span class="t-overline">Главная работа / 4:3</span></div><figcaption><span class="t-title">Интерьерный проект выпускника</span><span class="t-small text-muted">Имя автора и задача проекта</span></figcaption></figure><div class="work-side">{['Другой световой сценарий','Детали и крупный план'].map((title,i)=><figure><div class="small-placeholder"><span class="t-overline">Работа 0{i+2}</span><span class="frame-corner"></span></div><figcaption class="t-body">{title}</figcaption></figure>)}</div></div>
 </section>
 <section id="reviews" class="wrap section"><div class="reviews-layout"><div><p class="t-overline">05 / Опыт учеников</p><h2 class="t-h2">Что получилось<br/><span class="text-heading-muted">после курса.</span></h2><p class="t-body text-ink-2">Отзыв рядом с результатом помогает понять, какой путь прошёл человек.</p></div><article class="review-placeholder"><span class="t-overline">Место для реального отзыва</span><p class="t-quote">С каким опытом пришли.<br/>Что было сложно.<br/>Какую работу создали.</p><div class="review-author"><span class="avatar-placeholder" aria-hidden="true"></span><div><span class="t-title">Имя выпускника</span><p class="t-small text-muted">Курс, опыт до обучения и ссылка на работу</p></div></div></article></div></section>
 <section class="wrap section"><div class="trial-panel"><div><p class="t-overline">Перед покупкой</p><h2 class="t-h3">Посмотрите, как объясняет преподаватель.</h2><p class="t-body text-ink-2">Бесплатные уроки помогут оценить темп и подачу материала.</p></div><a href={c.trial!} class="btn btn-secondary">Открыть бесплатные уроки</a></div></section>
 <section id="price" class="wrap section"><div class="price-layout"><div><p class="t-overline">06 / Ваш следующий шаг</p><h2 class="t-h2">Начните работу<br/><span class="text-heading-muted">над новым уровнем.</span></h2><p class="t-lead">Интерьеры PRO: 73 видеоурока, практические задачи и последовательный процесс работы над интерьером.</p><details class="entry-details"><summary class="t-title">Компьютер и программы</summary><ul class="t-body">{c.requirements.map(p=><li>{p}</li>)}</ul></details></div><div class="price-card"><span class="t-overline">Полный курс</span><h3 class="t-h3">Интерьеры PRO</h3><p class="t-num">29 900 ₽</p><ul class="t-body">{c.included.map(p=><li>{p}</li>)}</ul><a href="/interiorpro#course-price" class="btn btn-primary btn-block">Перейти к выбору курса</a><p class="t-small text-muted">Есть рассрочка. Условия на странице курса.</p></div></div></section>
 <section class="wrap section faq-section"><div><p class="t-overline">Остались вопросы</p><h2 class="t-h2">До начала курса.</h2></div><div>{c.courseFaq.map(f=><details class="faq-item"><summary class="t-title">{f.question}<span aria-hidden="true">+</span></summary><p class="t-body text-ink-2">{f.answer}</p></details>)}</div></section>
</Base>
<script>
 document.querySelectorAll('[data-program]').forEach(root=>{
  const tabs=Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  function select(index:number){tabs.forEach((t,i)=>{const active=i===index;t.setAttribute('aria-selected',String(active));t.tabIndex=active?0:-1;const panel=document.getElementById(t.getAttribute('aria-controls')!);if(panel)panel.hidden=!active;});}
  tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>select(i));tab.addEventListener('keydown',e=>{let next=i;if(e.key==='ArrowDown'||e.key==='ArrowRight')next=(i+1)%tabs.length;else if(e.key==='ArrowUp'||e.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();select(next);tabs[next].focus();});});
 });
</script>
<style>
 .design-note{padding-top:calc(var(--header-h) + 20px);color:var(--color-muted);padding-bottom:16px;border-bottom:1px solid var(--color-line)}
 .course-hero{display:grid;grid-template-columns:3fr 2fr;gap:48px;padding-top:32px;padding-bottom:40px}.hero-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:24px;min-width:0}.hero-copy p,.hero-copy h1{margin:0}.hero-copy .t-lead{max-width:560px}.hero-facts{display:flex;flex-wrap:wrap;gap:40px}.hero-facts div{display:flex;flex-direction:column;gap:6px;justify-content:center}.hero-actions{display:flex;flex-wrap:wrap;gap:12px}.hero-picture{margin:0;position:relative;display:flex;flex-direction:column;min-width:0}.hero-signature{display:flex;justify-content:space-between;gap:12px;padding-bottom:14px}.hero-picture :global(img){width:100%;flex:1;min-height:0;object-fit:cover;border-radius:2px;aspect-ratio:4/5}.hero-picture figcaption{display:flex;justify-content:space-between;gap:12px;padding-top:14px}.hero-picture figcaption span{color:var(--color-muted)}
 .course-nav{position:sticky;top:var(--header-h);z-index:20;background:var(--color-bg);border-block:1px solid var(--color-line)}.course-nav .wrap{display:flex;gap:32px;overflow:auto;padding-block:18px}.course-nav a{font-size:var(--type-small);white-space:nowrap;color:var(--color-ink-2)}.course-nav a:hover{color:var(--color-ink)}
 section[id]{scroll-margin-top:calc(var(--header-h) + 70px)}.section-intro{max-width:880px;margin-bottom:32px}.section-intro .t-lead{max-width:690px;color:var(--color-ink-2)}.section-intro h2{margin-block:16px}.result-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.step-image{position:relative}.step-image :global(img){width:100%;height:100%;object-fit:cover}.step-image :global(.presentation-crop){object-position:85% 50%;transform:scale(1.2)}.image-tag{position:absolute;bottom:12px;left:12px;background:var(--color-bg);padding:10px 12px}.result-grid h3{margin:20px 0 12px}.result-grid p{margin:0}
 .audience-panel{display:grid;grid-template-columns:1fr 1fr;gap:60px;background:var(--color-surface);padding:40px;border-radius:2px}.audience-panel h2{margin-bottom:0}.entry-details{border-top:1px solid var(--color-line);padding-top:20px;margin-top:24px}.entry-details summary{cursor:pointer}.entry-details ul{padding-left:20px;color:var(--color-ink-2)}.entry-details li{margin-block:12px}
 .program-layout{display:grid;grid-template-columns:1fr 2fr;gap:32px}.stage-nav{display:flex;flex-direction:column;align-self:start;border-top:1px solid var(--color-line)}.stage-nav button{display:grid;grid-template-columns:32px 1fr 8px;gap:16px;align-items:center;text-align:left;padding:24px 18px;border-bottom:1px solid var(--color-line);background:none;color:var(--color-ink-2);cursor:pointer}.stage-nav button[aria-selected="true"]{background:var(--color-surface);color:var(--color-ink)}.stage-dot{height:6px;width:6px;border-radius:50%;background:var(--color-lime);opacity:0}.stage-nav button[aria-selected="true"] .stage-dot{opacity:1}.stage-panel{background:var(--color-surface);border-radius:2px;overflow:hidden}.stage-panel[hidden]{display:none}.stage-panel-head{padding:28px}.stage-panel-head h3{margin:14px 0}.stage-panel-head p{margin-bottom:0}.stage-visual{position:relative;aspect-ratio:16/7;overflow:hidden}.stage-visual :global(img){width:100%;height:100%;object-fit:cover}.stage-visual>span{position:absolute;bottom:10px;left:16px;background:var(--color-bg);padding:8px}.stage-content{display:grid;grid-template-columns:1.25fr 1fr;gap:24px;padding:28px}.topic-chips{display:flex;flex-wrap:wrap;gap:8px;padding:0;list-style:none;margin-block:12px 20px}.topic-chips li{border:1px solid var(--color-line);padding:8px 10px}.stage-result{border-left:1px solid var(--color-line);padding-left:24px}.stage-result .t-title{margin-top:12px}
 .format-grid,.reviews-layout,.price-layout{display:grid;grid-template-columns:1fr 1.3fr;gap:70px}.format-grid h2{margin-block:20px 28px}.format-list article{display:grid;grid-template-columns:36px 1fr;gap:24px;border-top:1px solid var(--color-line);padding:26px 0}.format-list h3,.format-list p{margin-top:0}.format-list p{margin-bottom:0}.teacher-strip{border-block:1px solid var(--color-line);margin-top:40px;padding-block:24px;display:flex;gap:40px}.teacher-strip>div{display:flex;flex-wrap:wrap;gap:20px 32px}
 .gallery-heading{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:32px}.gallery-heading h2{margin-bottom:0}.gallery-heading>p{max-width:380px}.work-layout{display:grid;grid-template-columns:2fr 1fr;gap:24px}.work-layout figure{margin:0}.work-layout figcaption{display:flex;flex-direction:column;gap:6px;margin-top:14px}.work-placeholder{aspect-ratio:4/3;position:relative;background:linear-gradient(140deg,#202726,#121615);display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:2px}.work-placeholder svg{width:90%;height:90%;fill:none;stroke:#879994;stroke-width:1.3}.work-placeholder .soft-line{stroke:#3f4c49}.work-placeholder>span{position:absolute;left:20px;top:20px;color:var(--color-muted)}.work-side{display:grid;gap:24px}.small-placeholder{aspect-ratio:16/10;background:linear-gradient(120deg,#25302b,#171e1b);position:relative;padding:20px;display:flex;align-items:flex-end;color:var(--color-muted);overflow:hidden;border-radius:2px}.frame-corner{position:absolute;width:65%;height:60%;top:12%;left:17%;border:1px solid #70847b;transform:skewY(-12deg)}.frame-corner:after{content:'';position:absolute;inset:18% 15%;border:1px solid #70847b}.review-placeholder{padding:36px;background:var(--color-surface);border-top:1px solid var(--color-line-strong)}.review-placeholder .t-quote{margin-block:28px 40px}.review-author{display:flex;align-items:center;gap:16px}.review-author p{margin:8px 0 0}.avatar-placeholder{width:48px;height:48px;border:1px solid var(--color-line);border-radius:50%;flex-shrink:0}
 .trial-panel{padding:28px 32px;border-block:1px solid var(--color-line);display:flex;justify-content:space-between;align-items:center;gap:24px}.trial-panel h2{margin-block:14px}.trial-panel p{margin-bottom:0}.trial-panel a{flex-shrink:0}.price-card{padding:36px;background:var(--color-surface);border-top:1px solid var(--color-line-strong)}.price-card h3{margin-block:18px}.price-card .t-num{margin-block:24px}.price-card ul{padding-left:18px;color:var(--color-ink-2);margin-bottom:30px}.price-card li{margin-block:12px}.faq-section{display:grid;grid-template-columns:1fr 1.3fr;gap:70px;padding-bottom:80px}.faq-item{border-bottom:1px solid var(--color-line);padding-block:22px}.faq-item summary{display:flex;justify-content:space-between;gap:20px;cursor:pointer}.faq-item p{margin-bottom:0}
 @media(max-width:1023px){.course-hero{gap:28px;grid-template-columns:1.2fr 1fr}.hero-copy{gap:20px}.hero-actions{flex-direction:column;align-items:flex-start}.hero-facts{gap:24px}.hero-picture figcaption{flex-direction:column}.audience-panel{gap:28px;padding:28px}.format-grid,.reviews-layout,.price-layout,.faq-section{gap:32px}.program-layout{grid-template-columns:1fr 1.5fr;gap:20px}.stage-content{grid-template-columns:1fr}.stage-result{border-left:0;border-top:1px solid var(--color-line);padding:20px 0 0}.teacher-strip{flex-direction:column;gap:20px}.result-grid{gap:16px}}
 @media(max-width:767px){.design-note{padding-top:calc(var(--header-h) + 16px)}.course-hero{grid-template-columns:1fr;padding-top:24px;gap:28px}.hero-copy{gap:20px}.hero-copy h1{font-size:var(--type-display)}.hero-actions{flex-direction:row}.hero-picture :global(img){aspect-ratio:16/10;flex:auto}.hero-signature{padding-bottom:12px}.hero-picture figcaption{flex-direction:row}.course-nav .wrap{gap:24px}.result-grid{grid-template-columns:1fr;gap:32px}.audience-panel,.format-grid,.reviews-layout,.price-layout,.faq-section{grid-template-columns:1fr;gap:24px}.audience-panel{padding:24px}.program-layout{grid-template-columns:1fr;gap:16px}.stage-nav{display:grid;grid-template-columns:1fr 1fr;border-top:0;gap:8px}.stage-nav button{padding:16px 12px;grid-template-columns:24px 1fr 6px;gap:8px;border:1px solid var(--color-line)}.stage-nav .t-title{font-size:var(--type-small)}.stage-panel-head,.stage-content{padding:24px}.stage-visual{aspect-ratio:16/10}.gallery-heading{display:block}.gallery-heading>p{margin-top:20px}.work-layout{grid-template-columns:1fr}.work-side{grid-template-columns:1fr 1fr;gap:16px}.small-placeholder{padding:12px}.review-placeholder,.price-card{padding:24px}.trial-panel{flex-direction:column;align-items:flex-start;padding:24px 0}.teacher-strip>div{flex-direction:column;gap:14px}.section-intro{margin-bottom:24px}}
</style>
