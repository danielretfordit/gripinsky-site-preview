---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { workViews } from '../../../lib/works';

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return ['gallery', 'editorial', 'proof'].map((variant) => ({ params: { variant } }));
}

const variant = Astro.params.variant;
const works = await workViews();
const victor = works.work('tveritin-druzhba')!;
const kate = works.work('bugaeva-interior')!;
const elena = works.work('gushchina-house')!;
const lake = works.work('meshkov-lake-house')!;
const links = [
  { id: 'gallery', name: 'А · Галерея' },
  { id: 'editorial', name: 'Б · Журнал' },
  { id: 'proof', name: 'В · Раздельные блоки' },
];
---
<Base title="Варианты нижней части главной | GRIPINSKY" description="Локальные варианты композиции работ и отзывов" noindex consult={false}>
  <div class="wrap preview-intro">
    <p class="t-overline">Дизайн-предпросмотр · не опубликовано</p>
    <h1 class="t-h2">После блока «ИИ или умри»</h1>
    <p class="t-lead">Те же работы, тексты и согласованная палитра. Меняются композиция галереи и подача отдельных блоков ниже.</p>
    <nav class="preview-nav" aria-label="Варианты композиции">
      {links.map((link) => <a class={variant === link.id ? 'current' : ''} href={`/design/after-ai/${link.id}`}>{link.name}</a>)}
    </nav>
  </div>

  {variant === 'gallery' && <section class="variant wrap" aria-label="Вариант А: галерея">
    <header class="preview-head"><span>01 / РЕЗУЛЬТАТЫ</span><h2>Работы <em>учеников</em></h2><p>Сначала крупная работа Виктора, затем три работы в общей гамме. Отзывы идут после «Почему GRIPINSKY».</p></header>
    <figure class="v-wide"><Image src={victor.image} alt={victor.alt} widths={[900, 1440]} sizes="100vw" /><figcaption>Виктор Тверитин · Пансионат «Дружба» · «Царь горы» на 3DDD</figcaption></figure>
    <div class="v-three">
      {[kate, elena, lake].map((w) => <figure><Image src={w.image} alt={w.alt} widths={[450, 700]} sizes="33vw" /><figcaption>{w.author} · {w.title}</figcaption></figure>)}
    </div>
  </section>}

  {variant === 'editorial' && <section class="variant wrap" aria-label="Вариант Б: журнал">
    <header class="preview-head"><span>01 / РЕЗУЛЬТАТЫ</span><h2>Работы <em>учеников</em></h2><p>Крупный архитектурный разворот, затем интерьер как спокойная пауза и меньшие кадры.</p></header>
    <div class="v-editorial">
      <figure class="v-lead"><Image src={victor.image} alt={victor.alt} widths={[800, 1200]} sizes="70vw" /><figcaption>01 / Виктор Тверитин · «Дружба»</figcaption></figure>
      <figure class="v-portrait"><Image src={kate.image} alt={kate.alt} widths={[450, 700]} sizes="30vw" /><figcaption>02 / Екатерина Бугаева · интерьер</figcaption></figure>
      <div class="v-statement"><span>ОТ ПЕРВОЙ МОДЕЛИ ДО ПОРТФОЛИО</span><strong>Разные задачи.<br />Свой взгляд.</strong></div>
      <figure class="v-small"><Image src={elena.image} alt={elena.alt} widths={[700, 1000]} sizes="50vw" /><figcaption>03 / Елена Гущина · дом у пруда</figcaption></figure>
      <figure class="v-small"><Image src={lake.image} alt={lake.alt} widths={[700, 1000]} sizes="50vw" /><figcaption>04 / Дмитрий Мешков · дом у озера</figcaption></figure>
    </div>
  </section>}

  {variant === 'proof' && <>
    <section class="variant wrap v-proof-works" aria-labelledby="proof-works-title">
      <header class="preview-head"><span>01 / РЕЗУЛЬТАТЫ</span><h2 id="proof-works-title">Работы <em>учеников</em></h2><p>Здесь только проекты и их авторы. Работа Виктора сохраняет главное место в галерее.</p></header>
      <figure class="v-wide"><Image src={victor.image} alt={victor.alt} widths={[900, 1440]} sizes="100vw" /><figcaption><span>Виктор Тверитин · Пансионат «Дружба» · «Царь горы» на 3DDD</span><a href="https://3ddd.ru/galleries/gallery/pansionat_druzhba_kurpaty" target="_blank" rel="noopener noreferrer">«Начал моделить здание еще год назад, но в какой-то момент отложил в дальний ящик» ↗</a></figcaption></figure>
      <div class="v-three">
        {[kate, elena, lake].map((w) => <figure><Image src={w.image} alt={w.alt} widths={[450, 700]} sizes="33vw" /><figcaption><span>{w.author} · {w.title}</span>{w === kate && <a href="https://t.me/s/gripinsky?after=5254&amp;q=%23gripinsky_%D0%A0%D0%B5%D0%BD%D0%B4%D0%B5%D1%80%D0%94%D0%BD%D1%8F" target="_blank" rel="noopener noreferrer">«Основные сложности возникли при постановке камеры и света» ↗</a>}{w === lake && <a href="https://t.me/s/gripinsky?after=5254&amp;q=%23gripinsky_%D0%A0%D0%B5%D0%BD%D0%B4%D0%B5%D1%80%D0%94%D0%BD%D1%8F" target="_blank" rel="noopener noreferrer">«На 4-м я хотел больше поработать над экстерьером» ↗</a>}</figcaption></figure>)}
      </div>
    </section>

    <section class="variant wrap v-proof-why" aria-labelledby="proof-why-title">
      <header class="preview-head"><span>02 / ПОДХОД АКАДЕМИИ</span><h2 id="proof-why-title">Почему <em>GRIPINSKY</em></h2><p>Сначала объясняем, как устроено обучение, и показываем конкретные условия.</p></header>
      <div class="v-reasons">
        <div><span>01</span><h3>Учим думать, а не копировать</h3><p>Разбираем логику каждого приёма, чтобы вы могли создавать собственные сцены.</p></div>
        <div><span>02</span><h3>Практика для портфолио</h3><p>Проекты для портфолио, в том числе по реальному ТЗ.</p></div>
        <div><span>03</span><h3>Награды учеников на 3DDD</h3><p>Показываем авторов и работы, получившие «Царя горы».</p></div>
        <div><span>04</span><h3>Путь под вашу цель</h3><p>Можно начать с базы или выбрать отдельный курс.</p></div>
        <div><span>05</span><h3>Экосистема, а не просто уроки</h3><p>Проверка работ, занятия, наставничество и помощь с портфолио.</p></div>
        <div><span>06</span><h3>Тёплое комьюнити</h3><p>Ученики, выпускники и педагоги остаются на связи.</p></div>
      </div>
    </section>

    <section class="variant wrap v-proof-reviews" aria-labelledby="proof-reviews-title">
      <header class="preview-head"><span>03 / ОТЗЫВЫ</span><h2 id="proof-reviews-title">Их <em>опыт</em></h2><p>Отзывы подтверждают тезисы предыдущего блока. Они не смешаны с галереей работ.</p></header>
      <div class="v-review-grid">
        <blockquote><span>УЧИМ ДУМАТЬ</span><p>«Евгений заложил в меня ценные навыки. Не только моделирования, визуализации, но и самого подхода к поставленной задаче».</p><cite>Наталья · ученица</cite></blockquote>
        <blockquote><span>СИЛЬНЫЕ РАБОТЫ</span><p>«На любую сложную и нетривиальную задачу всегда подходили творчески и делали все на высоте».</p><cite>Дарья Владимировна · заказчица работ выпускников</cite></blockquote>
        <blockquote><span>СООБЩЕСТВО РЯДОМ</span><p>«Гораздо удобнее и надежнее с коллегами решать вопросы».</p><cite>bitUM · ученик</cite></blockquote>
      </div>
    </section>
  </>}
</Base>

<style>
  .preview-intro { padding-top: 72px; padding-bottom: 48px; }
  .preview-intro .t-lead { max-width: 700px; }
  .preview-nav { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
  .preview-nav a { border: 1px solid #5a605e; color: #ecece6; text-decoration: none; padding: 10px 18px; border-radius: 4px; }
  .preview-nav a.current { background: #f8f61a; border-color: #f8f61a; color: #0e1112; }
  .variant { padding-bottom: 120px; }
  .preview-head { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 50px; border-top: 1px solid #5a605e; padding-top: 32px; margin-bottom: 40px; }
  .preview-head span { grid-column: 1/-1; color: #8c9391; font: 12px 'JetBrains Mono', monospace; letter-spacing: .12em; }
  .preview-head h2 { font-size: clamp(32px,5vw,68px); line-height: .98; text-transform: uppercase; letter-spacing: -.05em; margin: 0; }
  .preview-head h2 em { font-style: normal; color: #8c9391; }
  .preview-head p { max-width: 440px; color: #b6bfbc; font-size: 17px; line-height: 1.5; margin: 0; align-self: end; }
  figure { margin: 0; min-width: 0; }
  figure img { width: 100%; height: 100%; object-fit: cover; display: block; }
  figcaption { font-size: 13px; color: #a6aeaa; margin-top: 12px; }
  .v-proof-works figcaption { display: flex; flex-direction: column; gap: 8px; }
  .v-proof-works figcaption a { max-width: 820px; color: #ecece6; font-size: 16px; line-height: 1.4; text-decoration-color: #8c9391; text-underline-offset: 4px; }
  .v-proof-works figcaption a:hover { color: #f8f61a; }
  .v-wide img { aspect-ratio: 21/9; }
  .v-three { display: grid; grid-template-columns: repeat(3,1fr); gap: 22px; margin-top: 44px; }
  .v-three img { aspect-ratio: 4/5; }
  .v-editorial { display: grid; gap: 22px; grid-template-columns: repeat(2,minmax(0,1fr)); }
  .v-editorial { grid-template-columns: minmax(0,1.35fr) minmax(0,.65fr); }
  .v-editorial .v-lead { grid-column: 1; grid-row: span 2; }
  .v-editorial .v-lead img { aspect-ratio: 4/5; }
  .v-editorial .v-portrait img { aspect-ratio: 4/3; }
  .v-statement { border-top: 1px solid #5a605e; padding-top: 24px; display: flex; flex-direction: column; justify-content: space-between; }
  .v-statement span, .v-review-grid blockquote span { font: 12px 'JetBrains Mono', monospace; color: #f8f61a; letter-spacing: .09em; }
  .v-statement strong { font-size: clamp(32px,4vw,58px); line-height: 1; letter-spacing: -.05em; }
  .v-small img { aspect-ratio: 16/10; }
  .v-proof-works { padding-bottom: 96px; }
  .v-proof-why { padding-top: 80px; border-top: 1px solid #5a605e; padding-bottom: 96px; }
  .v-reasons { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 50px 22px; }
  .v-reasons > div { border-top: 1px solid #414746; padding-top: 18px; }
  .v-reasons span { font: 12px 'JetBrains Mono', monospace; color: #8c9391; }
  .v-reasons h3 { font-size: 20px; line-height: 1.2; margin: 20px 0 10px; }
  .v-reasons p { color: #a6aeaa; line-height: 1.5; margin: 0; }
  .v-proof-reviews { padding-top: 80px; border-top: 1px solid #5a605e; }
  .v-review-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 22px; }
  .v-review-grid blockquote { margin: 0; border-top: 1px solid #414746; padding: 22px 0 0; display: flex; flex-direction: column; }
  .v-review-grid blockquote p { font-size: clamp(18px,1.6vw,23px); line-height: 1.35; margin: 24px 0; }
  .v-review-grid blockquote cite { font-style: normal; font-size: 13px; color: #a6aeaa; margin-top: auto; }
  @media(max-width:760px) {
    .preview-intro { padding-top: 42px; }
    .preview-head { grid-template-columns: 1fr; }
    .preview-head p { max-width: none; }
    .v-three { grid-template-columns: repeat(2,1fr); gap: 16px; }
    .v-three figure:first-child { grid-column: 1/-1; }
    .v-editorial, .v-reasons, .v-review-grid { grid-template-columns: 1fr; }
    .v-editorial .v-lead { grid-column: 1; }
    .v-editorial .v-lead img { aspect-ratio: 4/3; }
    .v-statement { min-height: 200px; }
    .v-wide img { aspect-ratio: 4/3; }
    .v-proof-works { padding-bottom: 64px; }
    .v-proof-why, .v-proof-reviews { padding-top: 56px; }
  }
</style>
