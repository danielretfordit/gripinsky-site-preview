---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { personMap, visibleWorks } from '../../lib/people';

export async function getStaticPaths() {
  const people = await personMap();
  return (await getCollection('stories', (s) => people.has(s.data.person.id))).map((s) => ({ params: { slug: s.id }, props: { story: s } }));
}
const { story } = Astro.props;
const s = story.data;
const people = await personMap();
const works = new Map((await visibleWorks()).map((w) => [w.id, w]));
const person = people.get(s.person.id)!;
const { Content } = await render(story);
const pics = [...s.works, ...s.extraWorks].map((r) => works.get(r.id)).filter(Boolean);
const hasBody = Boolean(story.body?.trim());
const crumbs = [{ name: 'Главная', href: '/' }, { name: 'Отзывы и истории', href: '/otzyvy' }, { name: person.name }];
---
<Base
  title={`${person.name}: история выпускника Академии 3D GRIPINSKY`}
  description={`Было: ${s.before}. Стало: ${s.after}. История ${person.name} и работы, сделанные во время обучения.`}
  breadcrumbs={crumbs}
  consultContext={`История: ${person.name}`}
>
  <article class="wrap pb-12 pt-5 md:pt-7" aria-labelledby="story-title">
    <Breadcrumbs items={crumbs} class="mb-6" />
    <div class="grid gap-8 md:grid-cols-[7fr_5fr] md:gap-12">
      <div class="flex flex-col gap-3">
        {pics.slice(0, 1).map((w) => <Image src={w!.data.image} alt={w!.data.alt} widths={[640, 960, 1440]} sizes="(min-width: 1024px) 58vw, 100vw" loading="eager" class="w-full rounded-[20px] object-cover" />)}
        <div class="grid grid-cols-2 gap-3">
          {pics.slice(1).map((w) => <Image src={w!.data.image} alt={w!.data.alt} widths={[400, 640]} sizes="(min-width: 1024px) 28vw, 50vw" class="aspect-[4/3] w-full rounded-2xl object-cover" />)}
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <span class="chip chip-lime self-start">{s.tag}</span>
        <h1 id="story-title" class="t-display !text-[clamp(30px,4vw,44px)]">{person.name}</h1>
        <span class="text-sea">{s.subtitle}</span>
        <p class="m-0 text-muted">Было: {s.before}</p>
        <p class="m-0 text-[19px] font-semibold"><span class="text-sea">Стало:</span> {s.after}</p>
        {s.quote && <blockquote class="t-hand m-0">{s.quote}</blockquote>}
        {s.highlights.length > 0 && <ul class="m-0 flex list-none flex-col gap-1.5 p-0 text-ink-2">{s.highlights.map((h) => <li class="flex gap-2.5"><b class="text-lime" aria-hidden="true">+</b>{h}</li>)}</ul>}
        {s.courses && <p class="m-0 text-[15px] text-muted">{s.courses}</p>}
        {s.extraNote && <p class="m-0 rounded-2xl bg-sea-08 p-4 text-[15px]">{s.extraNote}</p>}
        {s.links.length > 0 && <p class="m-0 flex flex-wrap gap-x-5 gap-y-2">{s.links.map((l) => <a href={l.url} class="link" rel="noopener">{l.label} ↗</a>)}</p>}
        <div class="mt-2 flex flex-col gap-3 sm:flex-row">
          <a href="/courses-page/visualization#quiz" class="btn btn-primary">Подобрать свой путь</a>
          <a href="/otzyvy" class="btn btn-secondary">Все истории</a>
        </div>
      </div>
    </div>
    {hasBody && (
      <div class="story-body mt-12 max-w-[760px] text-[17px] leading-relaxed text-ink-2">
        <h2 class="t-h3 mb-4">История от первого лица</h2>
        <Content />
      </div>
    )}
  </article>
</Base>
<style is:global>
  .story-body p { margin: 0 0 14px; }
</style>
