---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostCard from '../components/PostCard.astro';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const crumbs = [{ name: 'Главная', href: '/' }, { name: 'Блог' }];
---
<Base title="Блог Академии 3D GRIPINSKY: статьи о 3D, новости программ, интервью" description="Статьи о 3D-визуализации и моделировании, новости 3ds Max, Corona, Blender и других программ, интервью с педагогами, итоги конкурсов и встреч академии." breadcrumbs={crumbs} consultContext="Блог">
  <section class="wrap pb-16 pt-5 md:pt-7" aria-labelledby="blog-title">
    <Breadcrumbs items={crumbs} class="mb-6" />
    <h1 id="blog-title" class="t-display mb-10">Блог <span class="t-accent">академии</span></h1>
    <ul class="post-grid m-0 list-none p-0">
      {posts.map((p, i) => <PostCard post={p} eager={i < 2} />)}
    </ul>
  </section>
</Base>
