---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HeroWork from '../../components/HeroWork.astro';
import { heroSlides } from '../../lib/hero';
import HeroActions from '../../components/HeroActions.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CourseCard from '../../components/CourseCard.astro';
import DirectionSupport from '../../components/games/DirectionSupport.astro';
import { courseHref } from '../../lib/categories';
import { rub } from '../../lib/format';
import { getCatalog } from '../../lib/catalog';
import PrototypeCartHint from '../../islands/PrototypeCartHint';
const cat = await getCatalog();

const crumbs = [{ name: 'Главная', href: '/' }, { name: 'Курсы', href: '/courses' }, { name: '3D для игр' }];
const professions = (await getCollection('gameProfessions')).sort((a, b) => a.data.order - b.data.order);
const panels = await Promise.all(professions.map(async p => ({
  ...p,
  courses: await Promise.all(p.data.courses.map(c => getEntry('courses', c.id))),
  trials: await Promise.all(p.data.trials.map(c => getEntry('courses', c.id))),
  addons: await Promise.all(p.data.addons.map(async a => ({
    text: a.text,
    course: (await getEntry('courses', a.course.id))!,
    alternative: a.alternative ? await getEntry('courses', a.alternative.id) : null,
  }))),
})));
// Слайды первого экрана редактируются в админке: «Слайды первого экрана»
const slides = await heroSlides('games');
const hero = slides[0];
const shortLabels: Record<string, string> = { props: 'Предметы', environment: 'Окружение', character: 'Персонажи', foliage: 'Растительность', 'hard-surface': 'Hard Surface', unreal: 'Unreal' };
---
<Base title="Курсы 3D для игр: профессии и обучение | GRIPINSKY" description="Выберите профессию в игровой 3D-графике: предметы, окружение, персонажи, растительность, Hard Surface или Unreal Engine. Основные и дополнительные курсы." breadcrumbs={crumbs} consultContext="Направление 3D для игр">
  {hero && <HeroWork work={hero} slides={slides} kicker="Направление" id="games-title">
    <Breadcrumbs slot="top" items={crumbs} />
    <h1 slot="title" id="games-title" class="t-hero">3D для игр <span class="t-accent block">от первых моделей к профессии</span></h1>
    <p slot="lead" class="t-lead">Игровые предметы, локации, персонажи и растительность. Выберите, что хотите создавать, и соберите свой маршрут обучения.</p>
    <HeroActions slot="cta" primaryHref="#profession" primaryLabel="Выбрать профессию" secondaryHref="/demo_gamedev" secondaryLabel="Бесплатные уроки" secondaryGoal="trial_click" />
  </HeroWork>}
  <section id="profession" class="wrap section games-professions" aria-labelledby="profession-title">
    <div class="games-start-options"><h3 class="t-title">С чего начать</h3><div class="games-start-grid"><article><p class="t-overline">Первый опыт в 3D</p><h4 class="t-small">Начните с основных курсов</h4><p class="t-small text-ink-2">Освойте инструменты выбранного маршрута и создайте первые игровые модели.</p><a href="#games-main" class="link t-small" data-game-start>Начать с основ →</a></article><article><p class="t-overline">Уже есть опыт</p><h4 class="t-small">Выберите курсы под свои задачи</h4><p class="t-small text-ink-2">Пропустите знакомые этапы и добавьте инструменты, которые хотите освоить.</p><a href="#games-additional" class="link t-small" data-game-start>Выбрать дополнения →</a></article></div></div>
    <div class="games-heading">
      <div><p class="t-overline">Профессии / 3D для игр</p><h2 id="profession-title" class="t-h2">Выберите <span class="t-accent">профессию</span></h2></div>
      <p class="t-lead">Основные курсы задают маршрут. Дополнительные помогают освоить нужные инструменты, их можно добавить по желанию. Если уже знаете основы, переходите к следующему курсу.</p>
    </div>
    <div class="games-selector" role="tablist" aria-label="Профессии в игровой графике">
      {panels.map((p, i) => <button type="button" role="tab" id={`game-tab-${p.id}`} data-game-profession={p.id} aria-controls={`game-panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="btn btn-secondary"><span class="game-label-full">{p.data.title}</span><span class="game-label-short">{shortLabels[p.id]}</span></button>)}
    </div>
    {panels.map((p, i) => <div class="games-panel" id={`game-panel-${p.id}`} role="tabpanel" aria-labelledby={`game-tab-${p.id}`} hidden={i !== 0}>
      <div class="games-description"><div><h3 class="t-h3">{p.data.short}</h3><p class="t-body text-ink-2">{p.data.lead}</p></div><aside><p class="t-overline text-muted">Практика и результат</p><p class="t-title">{shortLabels[p.id]}</p><a href="#games-works" class="link t-small">Работы учеников →</a></aside></div>
      <h3 id={i === 0 ? 'games-main' : undefined} class="t-title games-section-title">Основные курсы</h3>
      <div class="games-course-grid">{p.courses.map((c, index) => c && <div><p class="t-overline games-step">{String(index + 1).padStart(2, '0')} / Маршрут обучения</p><CourseCard course={c} framed selectable /></div>)}</div>
      <div id={i === 0 ? 'games-additional' : undefined} class="games-additional">
        <h3 class="t-title games-section-title">Дополнительные курсы</h3>
        <p class="t-small text-ink-2">Усильте навыки под свои задачи. Выберите нужные инструменты, остальные можно добавить позже.</p>
        <div class="games-addon-grid">{p.addons.map(a => <article data-game-addon={a.course.id}>
          <p class="t-overline">По желанию</p>
          <h4 class="t-title"><a href={courseHref(a.course.id, a.course.data)} class="link">{a.course.data.title} ↗</a></h4>
          <p class="t-small text-ink-2">{a.text}</p>
          <a href={courseHref(a.course.id, a.course.data)} class="link t-small">Программа курса →</a>
          {a.alternative && <p class="t-small games-alternative">Или <a href={a.alternative.data.legacyPath} class="link">{a.alternative.data.title} ↗</a><span class="t-caption text-muted">Подбор отдельных курсов</span></p>}
          <div class="games-addon-buy"><b class="t-title">{rub(a.course.data.price)}</b><label class="games-course-select t-small"><input type="checkbox" data-cart-select={a.course.id} disabled /><span>Выбрать курс</span></label></div>
        </article>)}</div>
      </div>
    </div>)}
    <a href="/courses" class="link games-all-courses">Все курсы академии →</a>
  </section>
  <DirectionSupport />
  <section id="games-faq" class="wrap section games-faq" aria-labelledby="games-faq-title">
    <div class="games-faq-layout"><div class="games-faq-heading">    <p class="t-overline">Перед стартом</p><h2 id="games-faq-title" class="t-h2">Вопросы</h2><p class="t-body text-ink-2">Не нашли ответ? <a href="#consult" class="link">Спросите на консультации</a> или в <a href="https://t.me/Academy3D_bot" class="link">Telegram</a>.</p>
</div><div class="games-faq-items">    <details class="faq"><summary class="t-title">Можно начать без опыта?<span aria-hidden="true" class="games-faq-plus">+</span></summary><p class="t-body">Да. Начните с бесплатных уроков, затем переходите к первому основному курсу выбранной профессии. Основные курсы выстраивают базу перед специализацией.</p></details>
    <details class="faq"><summary class="t-title">Какие программы и компьютер нужны?<span aria-hidden="true" class="games-faq-plus">+</span></summary><p class="t-body">В направлении используются Blender, Maya, ZBrush, Substance Painter, SpeedTree и Unreal Engine. Дополнительные инструменты зависят от выбранных курсов. Сверьте характеристики компьютера с требованиями используемых версий программ; если сомневаетесь, обсудите свой компьютер на консультации.</p></details>
    <details class="faq"><summary class="t-title">Куда обращаться, если возникнут сложности?<span aria-hidden="true" class="games-faq-plus">+</span></summary><p class="t-body">В корзине можно выбрать обучение с чатом поддержки или самостоятельный формат. Для индивидуального разбора можно обсудить работу с наставником. Условия проверки заданий уточняйте для выбранного курса и формата.</p></details>
    <details class="faq"><summary class="t-title">Нужно покупать весь маршрут сразу?<span aria-hidden="true" class="games-faq-plus">+</span></summary><p class="t-body">Можно выбрать отдельные курсы под свой опыт и задачи. Скидка за количество рассчитывается в корзине; включённые курсы и подарки учитываются автоматически.</p></details>
</div></div>
  </section>
  <PrototypeCartHint client:load cat={cat} />
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-game-profession]')];
  const panels = [...document.querySelectorAll<HTMLElement>('.games-panel')];
    const tabBar = document.querySelector<HTMLElement>('.games-selector')!;
  new ResizeObserver(() => document.documentElement.style.setProperty('--games-tabs-h', `${tabBar.offsetHeight}px`)).observe(tabBar);
  document.querySelectorAll<HTMLAnchorElement>('[data-game-start]').forEach(link=>link.addEventListener('click',event=>{ event.preventDefault(); const panel=panels.find(p=>!p.hidden); panel?.querySelector(link.hash === '#games-main' ? '.games-section-title' : '.games-additional')?.scrollIntoView({block:'start',behavior:'smooth'}); }));
  const activate = (index: number) => {
    const bar = document.querySelector<HTMLElement>('.games-selector')!;
    const mobile = window.matchMedia('(max-width: 767px)').matches;
    const pinned = bar.getBoundingClientRect().top <= parseFloat(getComputedStyle(bar).top) + 2;
  tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
    panels.forEach((panel, i) => {
      panel.hidden = i !== index;
      const main = panel.querySelector<HTMLElement>('.games-section-title')!;
      const additional = panel.querySelector<HTMLElement>('.games-additional')!;
      if (i === index) { main.id = 'games-main'; additional.id = 'games-additional'; }
      else { main.removeAttribute('id'); additional.removeAttribute('id'); }
    });
    if (mobile) {
      const tab = tabs[index];
      bar.scrollTo({ left: tab.offsetLeft - (bar.clientWidth - tab.offsetWidth) / 2, behavior: 'instant' });
    }
    if (pinned) requestAnimationFrame(() => panels[index].scrollIntoView({ block: 'start', behavior: 'instant' }));
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activate(i));
    tab.addEventListener('keydown', e => {
      let next = i;
      if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      else return;
      e.preventDefault(); activate(next); tabs[next].focus();
    });
  });
  const requested = new URLSearchParams(location.search).get('profession');
  const index = tabs.findIndex(tab => tab.dataset.gameProfession === requested);
  if (index >= 0) activate(index);
</script>

<style>
  .games-heading { display:grid; grid-template-columns:3fr 2fr; gap:48px; margin-bottom:32px; }
  .games-heading .t-overline { margin-bottom:16px; }
  .games-heading > p { margin:0; color:var(--color-ink-2); }
  .games-selector { display:flex; flex-wrap:wrap; gap:12px; margin-bottom:32px; }
  .games-selector [aria-selected="true"] { border-color:var(--color-lime); color:var(--color-lime); }
  .game-label-short { display:none; }
  @media(max-width:767px) {
    .games-selector { position:sticky; top:var(--header-h); z-index:30; flex-wrap:nowrap; overflow-x:auto; overscroll-behavior-x:contain; margin-inline:calc(-1 * var(--site-gutter)); padding:10px var(--site-gutter); background:var(--color-bg); border-bottom:1px solid var(--color-line); scrollbar-width:thin; }
    .games-selector button { flex-shrink:0; white-space:nowrap; }
    .games-panel { scroll-margin-top:calc(var(--header-h) + 90px); overflow-anchor:none; }
    .game-label-full { display:none; }
    .game-label-short { display:inline; }
  }
  .games-panel { min-width:0; }
  .games-panel[hidden] { display:none; }
  .games-description { max-width:800px; margin-bottom:28px; }
  .games-description h3 { margin:12px 0; }
  .games-description > p:last-child { color:var(--color-ink-2); }
  .games-trials { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:20px; padding:24px; border:1px solid var(--color-line); background:var(--color-surface); margin-bottom:32px; }
  .games-trials p { margin:0; }
  .games-trials .t-small { margin-top:10px; color:var(--color-ink-2); }
  .games-trial-links { display:flex; flex-wrap:wrap; gap:12px; }
  .games-section-title { margin:0 0 24px; padding-block:16px; border-bottom:1px solid var(--color-line); }
  .games-course-grid,.games-addon-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }
  .games-step { color:var(--color-muted); margin:0 0 12px; }
  .games-additional { margin-top:48px; }
  .games-additional > p { margin:0 0 24px; }
  .games-addon-grid article { display:flex; flex-direction:column; align-items:flex-start; min-width:0; padding:24px; border-top:1px solid var(--color-line-strong); background:var(--color-surface); }
  .games-addon-grid h4 { margin:14px 0 12px; }
  .games-addon-grid article > p { margin:0 0 16px; }
  .games-addon-grid article > .t-overline { color:var(--color-muted); margin:0; }
  .games-addon-grid article > .games-alternative { margin-top:16px; }
  .games-alternative span { display:block; margin-top:6px; }
  .games-addon-buy { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; width:100%; padding-top:24px; margin-top:auto; }
  .games-all-courses { display:inline-flex; margin-top:32px; }
  @media(max-width:1023.98px) { .games-course-grid,.games-addon-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:767px) { .games-heading,.games-course-grid,.games-addon-grid { grid-template-columns:1fr; } .games-heading { gap:20px; } .games-trials { padding:20px; } .games-selector { gap:8px; } }
</style>

<style>
  .games-start-options { margin:0 0 var(--space-section); }
  .games-start-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; margin-top:var(--space-head); }
  .games-start-grid article { border-radius:var(--radius-card); padding:16px 20px; background:var(--color-surface); border-top:1px solid var(--color-line-strong); }
  .games-start-grid .t-overline { color:var(--color-muted); margin:0 0 8px; }
  .games-start-grid h4 { margin:0 0 8px; font-weight:650; }
  .games-start-grid article > p.t-small { margin:0 0 12px; }
  .prototype-result { padding-left:24px; border-left:1px solid var(--color-line-strong); }
  .prototype-result > .t-overline { margin:0 0 12px; }
  .prototype-result > .t-title { margin:0; max-width:28ch; }
  .prototype-result a { display:inline-block; margin-top:20px; }
  [data-course-stage] { scroll-margin-top:calc(var(--header-h) + var(--games-selector-h, 85px) + 16px); }
  @media(max-width:767px) { [data-course-stage] { scroll-margin-top:calc(var(--header-h) + var(--games-selector-h, 85px) + 16px); } }
  .games-faq-layout { display:grid; grid-template-columns:1fr 2fr; gap:var(--space-sub); align-items:start; }
  .games-faq-heading { align-self:start; }
  .games-faq-heading .t-overline { color:var(--color-muted); margin:0 0 18px; }
  .games-faq-heading h2 { margin:0; }
  .games-faq-heading > p:last-child { margin:16px 0 0; max-width:36ch; }
  .games-faq details { border-bottom:1px solid var(--color-line); }
  .games-faq details:first-child { border-top:1px solid var(--color-line); }
  .games-faq summary { display:flex; align-items:center; justify-content:space-between; gap:24px; min-height:63px; padding:12px 0; cursor:pointer; font-size:var(--type-body); font-weight:600; list-style:none; }
  .games-faq summary::-webkit-details-marker { display:none; }
  .games-faq-plus { flex-shrink:0; color:var(--color-muted); font-size:var(--type-title); transition:transform .2s; }
  .games-faq details[open] .games-faq-plus { transform:rotate(45deg); }
  .games-faq details p { max-width:68ch; color:var(--color-ink-2); margin:0; padding-bottom:20px; }
  @media(max-width:767.98px) { .games-faq-layout { grid-template-columns:1fr; gap:61px; } .games-faq-heading { position:static; } }
  @media(max-width:560px) { .games-faq-layout { gap:25px; } .games-faq summary { min-height:59px; padding:13px 0; } }
  @media(max-width:767px){.games-start-grid{grid-template-columns:1fr;gap:24px;}.games-start-grid article{padding:16px;}}

  .prototype-note { padding-top:calc(var(--header-h) + 20px); padding-bottom:20px; display:flex; flex-wrap:wrap; justify-content:space-between; gap:16px; }
  :global(body:has([data-prototype-empty-cart])) { padding-bottom:var(--prototype-hint-h, 120px); }
  .prototype-note + :global(.hero) { padding-top:0; }
  .prototype-professions { padding-bottom:0; }
  .prototype-proof :global(.viz-reviews) { margin-top:var(--space-sub); padding-block:var(--space-sub); }
  .prototype-proof :global(.viz-more) { display:inline-flex; margin-top:28px; min-height:44px; align-items:center; }
  .games-heading { display:grid; grid-template-columns:3fr 2fr; gap:var(--space-sub); margin-bottom:0; }
  .games-heading .t-overline { margin:0 0 18px; }
  .games-heading > p { margin:0; max-width:640px; color:var(--color-ink-2); }
  .games-selector { position:sticky; top:var(--header-h); z-index:30; display:flex; flex-wrap:wrap; gap:12px; margin:var(--space-sub) 0 var(--space-head); padding-block:12px; background:var(--color-bg); border-bottom:1px solid var(--color-line); }
  .games-panel { scroll-margin-top:calc(var(--header-h) + var(--games-selector-h, 85px) + 16px); overflow-anchor:none; }
  .profession-label-short { display:none; }
  @media(max-width:767px) {
    .games-start-options { margin-bottom:var(--space-section); }
    .games-heading { margin-bottom:0; }
    .games-selector { position:sticky; top:var(--header-h); z-index:30; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px; margin-inline:calc(-1 * var(--site-gutter)); padding:10px var(--site-gutter); background:var(--color-bg); border-bottom:1px solid var(--color-line); }
    .games-panel { scroll-margin-top:calc(var(--header-h) + var(--games-selector-h, 85px) + 16px); overflow-anchor:none; }
    .games-selector button { min-width:0; padding-inline:6px; }
    .profession-label-full { display:none; }
    .profession-label-short { display:inline; }
  }
  .games-selector [aria-selected="true"] { border-color:var(--color-lime); color:var(--color-lime); }
  .games-panel[hidden] { display:none; }
  .games-description { display:grid; grid-template-columns:3fr 2fr; gap:var(--space-sub); align-items:start; margin-bottom:var(--space-sub); }
  .games-description > div > p { margin:16px 0 0; max-width:56ch; }
  .games-description h3 { max-width:28ch; text-wrap:balance; }
  @media(max-width:767.98px) { .games-description { grid-template-columns:1fr; gap:24px; } .prototype-result { padding-left:16px; } }
  .prototype-free { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:20px; margin-top:var(--space-head); padding:var(--pad-l); border:1px solid var(--color-line); background:var(--color-surface); }
  .prototype-proof > .prototype-free { margin-top:var(--space-sub); padding-block:var(--space-head) 0; padding-inline:var(--site-gutter); border:0; border-top:1px solid var(--color-line); background:transparent; }
  .prototype-free p { margin:0; }
  .prototype-free .t-overline { color:var(--color-muted); }
  .prototype-free .t-small { margin-top:10px; color:var(--color-ink-2); }
  .prototype-free-links { display:flex; flex-wrap:wrap; gap:12px; }
  .prototype-free-links a { max-width:100%; white-space:normal; }
  .games-section-title { margin:var(--space-sub) 0 var(--space-head); padding-block:16px; border-bottom:1px solid var(--color-line); }
  .games-addon-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--gap-grid); margin-top:var(--space-head); }
  .games-addon-grid article { border-radius:var(--radius-card); display:flex; flex-direction:column; align-items:flex-start; min-width:0; padding:24px; border-top:1px solid var(--color-line-strong); background:var(--color-surface); }
  .games-addon-grid article > .t-overline { color:var(--color-muted); margin:0; }
  .games-addon-grid h4 { margin:14px 0 12px; }
  .games-addon-grid article > p { margin:0 0 16px; }
  .prototype-course-select { display:flex; align-items:center; justify-content:center; width:100%; gap:12px; min-height:52px; padding:0 16px; border:1px solid var(--color-line-strong); border-radius:var(--radius-card); cursor:pointer; font-weight:600; }
  .prototype-course-select input { width:24px; height:24px; flex-shrink:0; accent-color:var(--color-lime); cursor:pointer; }
  .prototype-course-select:has(:checked) { border-color:var(--color-lime); }
  .games-addon-buy { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px; width:100%; padding-top:24px; margin-top:auto; }
  .prototype-section-head { margin:40px 0 24px; border-top:1px solid var(--color-line); padding-top:24px; }
  .prototype-section-head .t-overline { color:var(--color-muted); margin:0 0 12px; }
