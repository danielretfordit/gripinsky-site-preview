---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewWall from '../components/ReviewWall.astro';
import GraduateHighlights from '../components/GraduateHighlights.astro';
const crumbs=[{name:'Главная',href:'/'},{name:'Истории и отзывы'}];
---
<Base title="Отзывы учеников Академии 3D GRIPINSKY: истории выпускников" description="Короткие отзывы учеников, истории выпускников и работы, получившие награду «Царь горы» на 3DDD." breadcrumbs={crumbs} consultContext="Отзывы">
<section class="wrap section reviews-intro" aria-labelledby="reviews-title"><Breadcrumbs items={crumbs} class="mb-6" /><p class="t-overline">Опыт учеников</p><h1 id="reviews-title" class="t-display">Истории <span class="text-heading-muted">и отзывы</span></h1><p class="t-lead">С чего начинали, чего достигли и как учились в академии. Работы и впечатления наших учеников.</p></section>
<section id="quotes" class="wrap section review-collections">
  <div class="collection-tabs" role="tablist" aria-label="Отзывы и результаты">
    <button class="choice" role="tab" id="tab-stories" aria-controls="stories-title" aria-selected="true" data-collection="stories">Истории выпускников</button>
    <button class="choice" role="tab" id="tab-quotes" aria-controls="panel-quotes" aria-selected="false" tabindex="-1" data-collection="quotes">Отзывы</button>
    <button class="choice" role="tab" id="tab-awards" aria-controls="kings-title" aria-selected="false" tabindex="-1" data-collection="awards">«Цари горы»</button>
  </div>
  <div id="panel-quotes" role="tabpanel" aria-labelledby="tab-quotes" data-collection-panel="quotes"><ReviewWall /></div>
  <div class="graduate-collection"><GraduateHighlights expanded /></div>
</section>
</Base>
<style>.review-nav,.review-links{display:flex;flex-wrap:wrap;gap:24px;margin-top:24px}.review-nav a,.review-links a{display:inline-flex;min-height:44px;align-items:center}#quotes{scroll-margin-top:100px}</style>

<style>
 .review-editorial { padding-bottom: 24px; }
 .review-editorial :global(.proof-process) { display: none; }
 .collection-tabs { display: flex; flex-wrap: wrap; gap: 12px; padding-block: 20px; border-block: 1px solid var(--color-line); margin-bottom: 32px; }
 .collection-tabs button { min-height: 48px; padding-inline: 18px; }
 .collection-tabs [aria-selected="true"] { background: var(--color-ink); color: var(--color-bg); }
 .graduate-collection :global(.graduate-highlights) { margin-top: 0; }
 .review-collections :global([hidden]) { display: none !important; }
</style>
<script>
 const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-collection]')];
 const quotes = document.querySelector<HTMLElement>('[data-collection-panel="quotes"]')!;
 const stories = document.getElementById('stories-title')!;
 const awards = document.getElementById('kings-title')!;
 stories.setAttribute('role', 'tabpanel'); stories.setAttribute('aria-labelledby', 'tab-stories');
 awards.setAttribute('role', 'tabpanel'); awards.setAttribute('aria-labelledby', 'tab-awards');
 const select = (key: string) => {
   quotes.hidden = key !== 'quotes'; stories.hidden = key !== 'stories'; awards.hidden = key !== 'awards';
   buttons.forEach(b => { b.setAttribute('aria-selected', String(b.dataset.collection === key)); b.tabIndex = b.dataset.collection === key ? 0 : -1; });
 };
 buttons.forEach((b, i) => { b.addEventListener('click', () => select(b.dataset.collection!)); b.addEventListener('keydown', e => { if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return; e.preventDefault(); const next=buttons[(i+(e.key==='ArrowRight'?1:buttons.length-1))%buttons.length]; select(next.dataset.collection!); next.focus(); }); });
 const fromHash = () => select(location.hash === '#quotes' || location.hash === '#panel-quotes' ? 'quotes' : location.hash === '#kings-title' ? 'awards' : 'stories');
 document.querySelectorAll<HTMLAnchorElement>('.review-nav a').forEach(a => a.addEventListener('click', () => { const key=a.hash==='#stories-title'?'stories':a.hash==='#kings-title'?'awards':'quotes'; select(key); document.getElementById('quotes')?.scrollIntoView({behavior:'smooth'}); }));
 fromHash(); window.addEventListener('hashchange', fromHash);
</script>

<style>
 .reviews-intro { padding-bottom: 24px; }
 .review-collections { padding-top: 0; }
</style>
