---
// Работы учеников и отзывы на странице курса (между «Ваша практика» и «Как проходит обучение»).
// Модерация в админке, в карточке курса: «Работы учеников курса» и «Отзывы для страницы курса».
// Пока ничего не выбрано, показываются подходящие опубликованные работы и общие отзывы (только с согласием).
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import { personMap, visibleWorks } from '../lib/people';

interface Props { course: CollectionEntry<'courses'>['data'] }
const { course: c } = Astro.props;
const people = await personMap();
const all = (await visibleWorks()).filter((w) => people.get(w.data.author.id)?.consent === 'yes');
const picked = all.filter((w) => c.studentWorks.some((ref) => ref.id === w.id));
// Без выбора: работы по профилю курса (игры и моделирование или интерьеры и экстерьеры), сначала с наградами
const modelOnly = c.software.length > 0 && !c.software.some((s) => /3ds|corona|v-?ray/i.test(s));
const cats = modelOnly ? ['model'] : ['int', 'ext'];
const fallback = all.filter((w) => w.data.categories.some((x) => cats.includes(x)))
  .sort((a, b) => b.data.awards.length - a.data.awards.length || a.data.order - b.data.order);
const works = (picked.length ? picked : fallback).slice(0, 3);

const reviewsAll = await getCollection('reviews', (r) => !r.data.person || people.has(r.data.person.id));
const pickedReviews = (c.reviews ?? []).map((ref) => reviewsAll.find((r) => r.id === ref.id)).filter(Boolean) as CollectionEntry<'reviews'>[];
const own = c.testimonials.filter((t) => t.consent).map((t) => ({ text: t.text, author: t.author, role: t.context }));
const general = reviewsAll.sort((a, b) => a.data.order - b.data.order).slice(0, 2);
const reviews = pickedReviews.length
  ? pickedReviews.map((r) => ({ text: r.data.quote ?? r.data.text, author: r.data.author, role: r.data.role }))
  : own.length ? own : general.map((r) => ({ text: r.data.quote ?? r.data.text, author: r.data.author, role: r.data.role }));
const author = (w: (typeof all)[number]) => people.get(w.data.author.id)?.name ?? '';
---
{(works.length > 0 || reviews.length > 0) && (
  <section id="course-proof" class="wrap section" aria-labelledby="course-proof-title">
    <div class="head proof-head">
      <p class="t-overline">Работы учеников и отзывы</p>
      <h2 id="course-proof-title" class="t-h2">Так учатся <span class="t-accent">у нас</span></h2>
      <a href="/gallery" class="link t-small">Все работы в галерее →</a>
    </div>
    {works.length > 0 && (
      <div class="proof-works">
        {works.map((w, i) => (
          <figure class:list={['proof-work', { 'proof-work--main': i === 0 }]}>
            <div class="media-frame"><Image src={w.data.image} alt={w.data.alt} widths={[480, 800, 1200]} sizes={i === 0 ? '(min-width: 1024px) 58vw, 92vw' : '(min-width: 1024px) 30vw, 92vw'} loading="lazy" /></div>
            <figcaption class="t-small"><b>{author(w)}</b><span>{w.data.title.replace(/,?\s*«(Рендер дня|Царь горы)»/g, '')}</span></figcaption>
          </figure>
        ))}
      </div>
    )}
    {reviews.length > 0 && (
      <div class="proof-reviews">
        {reviews.slice(0, 3).map((r) => (
          <figure>
            <blockquote><p class="t-body">«{r.text.replace(/^«|»$/g, '')}»</p></blockquote>
            <figcaption class="t-small"><b>{r.author}</b>{r.role && <span>{r.role}</span>}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>
)}

<style>
  .proof-head { flex-direction: row; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; column-gap: 32px; }
  .proof-head > :first-child { flex-basis: 100%; }
  .proof-head h2 { margin-top: var(--stack-eyebrow); }
  .proof-head > a { margin-top: 0 !important; }
  .proof-works { display: grid; gap: var(--gap-grid); }
  .proof-work { display: grid; gap: 10px; margin: 0; min-width: 0; }
  .proof-work .media-frame { aspect-ratio: var(--media-ratio-work-card); }
  .proof-work img { width: 100%; height: 100%; object-fit: cover; }
  .proof-work figcaption { display: flex; flex-wrap: wrap; gap: 4px 10px; color: var(--color-muted); }
  .proof-work figcaption b { color: var(--color-ink); font-weight: 600; }
  .proof-reviews { display: grid; gap: var(--gap-grid); margin-top: var(--space-head); }
  .proof-reviews figure { display: flex; flex-direction: column; gap: 16px; margin: 0; }
  .proof-reviews blockquote p { margin: 0; color: var(--color-ink-2); }
  .proof-reviews figcaption { display: flex; flex-direction: column; gap: 4px; padding-left: clamp(16px, 1.8vw, 24px); color: var(--color-muted); }
  .proof-reviews figcaption b { color: var(--color-ink); font-weight: 600; }
  @media (min-width: 768px) {
    .proof-works { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proof-work--main { grid-column: 1 / -1; }
    .proof-reviews { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  }
  @media (min-width: 1024px) {
    .proof-works { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); grid-template-rows: auto auto; }
    .proof-work--main { grid-column: 1; grid-row: 1 / span 2; }
    .proof-work--main .media-frame { aspect-ratio: auto; height: 100%; min-height: 420px; }
  }
</style>
