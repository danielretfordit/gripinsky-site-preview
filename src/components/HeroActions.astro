---
interface Props {
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  secondaryGoal?: string;
}
const { primaryHref, primaryLabel, secondaryHref, secondaryLabel, secondaryGoal } = Astro.props;
---
<div class="hero-actions">
  <a href={primaryHref} class="btn btn-primary btn-lg">{primaryLabel} <span aria-hidden="true">↗</span></a>
  <a href={secondaryHref} class="btn btn-secondary btn-lg" data-goal={secondaryGoal}>{secondaryLabel} <span class="arrow-long" aria-hidden="true"></span></a>
</div>
<style>
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:12px 24px; max-width:100%; }
  /* Телефон: обе кнопки во всю ширину столбцом (удобно большому пальцу), подпись слева, стрелка справа */
  @media(max-width:559.98px) {
    .hero-actions { align-items:stretch; flex-direction:column; width:100%; }
    .hero-actions > .btn { width:100%; }
  }
</style>
