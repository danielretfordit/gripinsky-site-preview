---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { personMap, visibleWorks } from '../lib/people';
interface Props { compact?: boolean; expanded?: boolean }
const {compact=false,expanded=false}=Astro.props;
const people=await personMap();const works=new Map((await visibleWorks()).map(w=>[w.id,w]));
const stories=(await getCollection('stories',s=>people.has(s.data.person.id))).sort((a,b)=>a.data.order-b.data.order);
const awards=(await getCollection('awards',a=>a.data.kind==='student' && people.has(a.data.person.id))).sort((a,b)=>a.data.order-b.data.order);
const illustratedAwards=awards.filter(a=>(a.data.work && works.has(a.data.work.id)) || [...works.values()].some(w=>w.data.author.id===a.data.person.id && w.data.awards.includes('tsar-gory')));
---
<div class="graduate-highlights">
<section id="kings-title" class="graduate-chapter"><div class="graduate-head"><div><p class="t-overline">Награды на 3DDD</p><h2 class="t-h2">«Цари горы»</h2></div>{compact && <a class="link t-small" href="/otzyvy#kings-title">Все награды →</a>}</div><div class="graduate-grid">{(compact?illustratedAwards.slice(0,3):awards).map(a=>{const w=(a.data.work && works.get(a.data.work.id)) || [...works.values()].find(w=>w.data.author.id===a.data.person.id && w.data.awards.includes('tsar-gory'));return <article class="award">{w && <a href={`/gallery#${w.id}`}><Image src={w.data.image} alt={w.data.alt} widths={[480,800]} sizes="(min-width:768px) 33vw,100vw" class="media-frame media-frame--work-card" /></a>}<span class="award-mark t-overline">{a.data.title}</span><h3 class="t-title">{people.get(a.data.person.id)?.name}</h3><p class="t-small">{a.data.text}</p></article>})}</div></section>
<section id="stories-title" class:list={['graduate-chapter',{'stories-expanded':expanded}]}><div class="graduate-head"><div><p class="t-overline">Путь выпускника</p><h2 class="t-h2">Истории</h2></div></div><div class="graduate-grid">{stories.slice(0,compact?3:stories.length).map(s=>{const w=s.data.works[0] && works.get(s.data.works[0].id);return <article class="story">
{!expanded && w && <Image src={w.data.image} alt={w.data.alt} widths={[480,800]} sizes="(min-width:768px) 40vw,100vw" class="media-frame media-frame--work-card" />}
<div class="story-content"><span class="t-overline">{s.data.tag}</span><h3 class="t-h3">{people.get(s.data.person.id)?.name}</h3>
<dl class="t-small"><div class="story-stage"><dt>Было</dt><dd>{s.data.before}</dd></div><div class="story-stage"><dt>Стало</dt><dd>{s.data.after}</dd></div></dl>
{expanded && s.data.courses && <div><h4 class="t-title">Как достиг результата</h4><p class="t-body">{s.data.courses}</p></div>}
{expanded && s.data.highlights.length>0 && <ul class="story-steps t-body">{s.data.highlights.map(text=><li>{text}</li>)}</ul>}
{expanded && s.data.extraNote && <p class="story-note t-small">{s.data.extraNote}</p>}
{s.data.quote && <div><h4 class="t-title">Об академии</h4><blockquote class="t-body">{s.data.quote}</blockquote></div>}
</div></article>})}</div></section>
</div>
<style>
 .graduate-highlights{display:grid;gap:64px;margin-top:64px}.graduate-chapter{scroll-margin-top:100px}.graduate-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:32px}.graduate-head h2{margin:16px 0 0}.graduate-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}.graduate-grid article{display:flex;flex-direction:column;align-items:flex-start;gap:16px;border-top:1px solid var(--color-line);padding-top:20px}.graduate-grid article>a:first-child{width:100%}.graduate-grid img{width:100%;object-fit:cover}.graduate-grid h3,.graduate-grid p{margin:0}.graduate-grid p{color:var(--color-ink-2)}.award-mark{color:var(--color-heading-muted)}.story dl{display:grid;gap:16px;margin:0}.story dt{color:var(--color-muted);margin-bottom:6px}.story dd{margin:0}.story> a:last-child{margin-top:auto}@media(max-width:767px){.graduate-grid{grid-template-columns:1fr;gap:32px}.graduate-head{display:block}.graduate-head>a{display:inline-block;margin-top:20px}.graduate-highlights{gap:48px;margin-top:48px}}
</style>

<style>
 .stories-expanded .graduate-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
 .story-content { display:grid;gap:20px;width:100%; }
 .story-content h4,.story-content blockquote { margin:0; }
 .story-content h4 { margin-bottom:10px; }
 .story-stage { padding:16px;background:var(--color-surface);border-radius:2px; }
 .story-content dl { grid-template-columns:repeat(2,minmax(0,1fr)); }
 .story-steps { display:grid;gap:10px;margin:0;padding:0;list-style:none;color:var(--color-ink-2); }
 .story-steps li { position:relative;padding-left:22px; }
 .story-steps li::before { position:absolute;top:.8em;left:0;width:12px;height:1px;background:var(--color-line-strong);content:""; }
 .story-note { margin:0;color:var(--color-muted); }
 .story-content blockquote { color:var(--color-ink-2); }
 @media(max-width:767px){.stories-expanded .graduate-grid{grid-template-columns:1fr}}
</style>
