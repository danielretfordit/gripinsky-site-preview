---
import type { Crumb } from '../lib/seo';
interface Props { items: Crumb[]; class?: string }
const { items, class: cls = '' } = Astro.props;
---
<nav aria-label="Хлебные крошки" class={cls}>
  <ol class="m-0 flex list-none flex-wrap gap-x-2.5 gap-y-1 p-0 text-[14px] text-muted md:text-[15px]">
    {items.map((c, i) => (
      <li class="flex items-center gap-2.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {c.href && i < items.length - 1 ? <a href={c.href} class="text-muted hover:text-white">{c.name}</a> : <span aria-current={i === items.length - 1 ? 'page' : undefined} class="text-ink">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
