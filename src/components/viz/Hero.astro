---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import render from '../../assets/works/rossoshansky-gostinaya.jpg';
import model from '../../assets/works/rossoshansky-gostinaya-model.jpg';
import texture from '../../assets/brand/texture.png';
import Breadcrumbs from '../Breadcrumbs.astro';
import type { Crumb } from '../../lib/seo';
import { rub, sp } from '../../lib/format';

interface Props { crumbs: Crumb[]; basePrice: number; months: number }
const { crumbs, basePrice, months } = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;
const s = site.stats;
const checks = ['Без опыта и умения рисовать', 'Онлайн, в своём темпе', 'Портфолио: 104 модели и 7 визуализаций'];
---
<section class="wrap relative overflow-hidden pb-14 pt-5 md:pb-[72px] md:pt-7" aria-labelledby="hero-title">
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-10 -left-[20%] -right-[20%] h-[340px] [mask-image:linear-gradient(to_top,#000_10%,transparent_85%)] [transform-origin:50%_100%] [transform:perspective(500px)_rotateX(62deg)]"
       style="background-image: linear-gradient(rgba(248,246,26,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(248,246,26,0.08) 1px, transparent 1px); background-size: 60px 60px;"></div>
  <Image src={texture} alt="" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-[0.07]" widths={[768, 1440]} sizes="100vw" />

  <Breadcrumbs items={crumbs} class="relative mb-6" />

  <div class="relative grid items-center gap-8 md:grid-cols-[6fr_5fr] md:gap-12">
    <div class="flex flex-col gap-5">
      <span class="text-[15px] font-bold tracking-[0.08em] text-sea">Направление</span>
      <h1 id="hero-title" class="t-display">Курсы <span class="whitespace-nowrap">3D-визуализации</span> <span class="t-accent block">с нуля до заказов</span></h1>
      <p class="t-lead max-w-[640px]">Интерьеры, экстерьеры и модели для стоков в 3ds Max и Corona Renderer. С нуля или чтобы закрыть пробелы, если вы уже работаете в 3D.</p>
      <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[16px] text-ink-2 sm:flex-row sm:flex-wrap sm:gap-x-7 md:text-[17px]">
        {checks.map((c) => (
          <li class="flex items-center gap-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F8F61A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{c}</li>
        ))}
      </ul>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="#base" class="btn btn-primary btn-lg">Начать с базы</a>
        <a href="/vizualization3_mini" class="btn btn-secondary btn-lg" data-goal="trial_click">Бесплатные уроки</a>
      </div>
      <p class="m-0 text-[15px] text-ink-2">
        База от <b class="text-ink">{rub(basePrice)}</b> или {sp(Math.ceil(basePrice / months))}&nbsp;₽/мес в рассрочку.
        Не знаете, с чего начать? <a href="#quiz" class="link" data-open-quiz>Тест за 1 минуту</a>
      </p>
    </div>

    <div class="relative aspect-[4/3] overflow-hidden rounded-[20px] shadow-[0_30px_80px_rgba(0,0,0,0.5)] md:aspect-auto md:h-[460px]">
      <Image src={render} alt="Гостиная, финальный рендер ученика в Corona" widths={[480, 768, 1080, 1440]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
      <div class="scan-wire absolute inset-0">
        <Image src={model} alt="Та же гостиная в сером материале, модель в 3ds Max" widths={[480, 768, 1080, 1440]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" class="absolute inset-0 h-full w-full object-cover" />
      </div>
      <span class="scan-line absolute bottom-0 top-0 -ml-px w-[3px] bg-lime shadow-[0_0_24px_6px_rgba(248,246,26,0.45)]" aria-hidden="true"></span>
      <span class="badge-on-image absolute left-3 top-3 sm:left-4 sm:top-4">Модель в 3ds Max</span>
      <span class="badge-on-image absolute right-3 top-3 sm:right-4 sm:top-4"><span class="h-2 w-2 rounded-full bg-lime"></span>Рендер в Corona</span>
      <span class="badge-on-image absolute bottom-3 left-3 !text-ink-2 sm:bottom-4 sm:left-4">Артём Россошанский, «Рендер дня»</span>
    </div>
  </div>

  <dl class="relative mt-10 grid grid-cols-2 gap-y-6 border-y border-line py-6 sm:grid-cols-3 md:mt-12 md:grid-cols-5 md:py-7">
    <div class="flex flex-col-reverse gap-1.5 pr-4 md:pr-7"><dt class="text-[15px] text-muted">выпускников</dt><dd class="m-0 text-[clamp(26px,2.5vw,36px)] font-bold leading-none">{s.graduates}</dd></div>
    <div class="flex flex-col-reverse gap-1.5 pr-4 md:border-l md:border-line md:px-7"><dt class="text-[15px] text-muted">учим по своей системе</dt><dd class="m-0 text-[clamp(26px,2.5vw,36px)] font-bold leading-none">{s.years}</dd></div>
    <div class="flex flex-col-reverse gap-1.5 pr-4 md:border-l md:border-line md:px-7"><dt class="text-[15px] text-muted">видеоуроков</dt><dd class="m-0 text-[clamp(26px,2.5vw,36px)] font-bold leading-none">{s.videos}</dd></div>
    <div class="flex flex-col-reverse gap-1.5 pr-4 md:border-l md:border-line md:px-7">
      <dt class="text-[15px] text-muted"><a href={site.yandexMaps} class="text-muted hover:text-white">{s.ratingCount ? `${s.ratingCount} отзывов` : 'отзывы'} на Яндекс Картах ↗</a></dt>
      <dd class="m-0 flex items-center gap-2.5"><span class="text-[clamp(26px,2.5vw,36px)] font-bold leading-none">{s.rating}</span><span class="text-[13px] tracking-[2px] text-ink" aria-label={`Оценка ${s.rating} из 5`}>★★★★★</span></dd>
    </div>
    <div class="flex flex-col-reverse gap-1.5 pr-4 md:border-l md:border-line md:px-7"><dt class="text-[15px] text-muted">подписчиков на YouTube</dt><dd class="m-0 text-[clamp(26px,2.5vw,36px)] font-bold leading-none">{s.subscribers}</dd></div>
  </dl>
</section>
