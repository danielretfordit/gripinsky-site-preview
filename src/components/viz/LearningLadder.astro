---
const steps = [
  {
    number: '00',
    label: 'Точка старта',
    title: 'Сейчас',
    text: 'Приходите с нуля или возвращаетесь к 3D, чтобы закрыть пробелы в знаниях.',
  },
  {
    number: '01',
    label: 'Основа',
    title: 'База',
    text: 'Последовательно проходите 3ds Max, сложное моделирование, Corona и работу с ИИ.',
    link: '#base',
    action: 'Посмотреть программу базы',
  },
  {
    number: '02',
    label: 'Специализация',
    title: 'Профессия',
    text: 'Выбираете интерьеры, экстерьеры или 3D-модели для стоков и учитесь работать по задаче.',
    link: '#profession',
    action: 'Выбрать профессию',
  },
  {
    number: '03',
    label: 'Результат',
    title: 'Портфолио и проекты',
    text: 'Собираете портфолио из учебных проектов и готовитесь перейти к первым заказам.',
    link: '#works',
    action: 'Смотреть работы учеников',
    outcomes: [
      ['104', 'модели'],
      ['7', 'визуализаций'],
    ],
    projects: [
      'Интерьеры: четыре проекта',
      'Экстерьеры: проект по реальному ТЗ',
      'ЖК: проект с генпланом',
      '3D-стоки: модель для публикации на 3DDD',
    ],
  },
];
---
<section id="path" class="wrap section learning-ladder" aria-labelledby="path-title">
  <header class="learning-ladder__head">
    <div class="head !mb-0">
      <p class="t-overline m-0">Путь ученика, четыре этапа</p>
      <h2 id="path-title" class="t-h2 normal-case" tabindex="-1">От первого объекта <span class="t-accent">к портфолио</span></h2>
      <p class="t-lead max-w-[640px]">Показываем, что изучаете по дороге и как база соединяется с выбранной профессией.</p>
    </div>
    <a href="#quiz" class="link min-h-11 self-start" data-open-quiz>Не знаете, с чего начать? Пройти тест ↓</a>
  </header>

  <ol class="learning-ladder__steps">
    {steps.map((step, i) => (
      <li class:list={['learning-ladder__step', i === steps.length - 1 && 'learning-ladder__step--result']}>
        <div class="learning-ladder__marker" aria-hidden="true">{step.number}</div>
        <div class="learning-ladder__copy">
          <span class="t-overline learning-ladder__label">{step.label}</span>
          <h3>{step.title}</h3>
          {step.outcomes && (
            <ul class="learning-ladder__outcomes" aria-label="Результаты обучения">
              {step.outcomes.map(([value, label]) => <li><b>{value}</b><span>{label}</span></li>)}
            </ul>
          )}
          <p>{step.text}</p>
          {step.projects && <ul class="learning-ladder__projects">{step.projects.map((project) => <li>{project}</li>)}</ul>}
          {step.action && <a href={step.link} class="link min-h-11">{step.action} ↓</a>}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .learning-ladder__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: var(--space-head);
  }
  .learning-ladder__head .head > p:last-child { margin-top: 4px; }
  .learning-ladder__steps {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .learning-ladder__step {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    padding: 24px 0 28px;
    border-top: 1px solid var(--color-line);
  }
  .learning-ladder__step:last-child { border-bottom: 1px solid var(--color-line); }
  .learning-ladder__marker {
    position: relative;
    z-index: 1;
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-lime);
    font-family: var(--font-mono);
    font-size: var(--type-meta);
    font-weight: 600;
    box-shadow: 0 0 0 1px var(--color-line-strong);
  }
  .learning-ladder__step:not(:last-child)::before {
    position: absolute;
    top: 63px;
    bottom: -1px;
    left: 19px;
    width: 1px;
    background: var(--color-line);
    content: "";
  }
  .learning-ladder__copy { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; gap: 10px; }
  .learning-ladder__label { color: var(--color-muted); }
  .learning-ladder__copy h3 {
    margin: 0;
    font-size: var(--type-card-title);
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .learning-ladder__copy p { max-width: 440px; margin: 0; color: var(--color-ink-2); line-height: 1.5; }
  .learning-ladder__outcomes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 4px 0;
    padding: 0;
    list-style: none;
  }
  .learning-ladder__outcomes li { display: flex; align-items: baseline; gap: 8px; }
  .learning-ladder__outcomes b {
    color: var(--color-ink);
    font-size: var(--type-number);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .learning-ladder__outcomes span { color: var(--color-muted); font-size: var(--type-small); }
  .learning-ladder__step--result .learning-ladder__marker {
    background: var(--color-lime);
    color: var(--color-bg);
    box-shadow: none;
  }
  .learning-ladder__projects { display: flex; flex-direction: column; gap: 5px; margin: 3px 0; padding: 0; list-style: none; color: var(--color-ink-2); font-size: 13px; line-height: 1.35; }
  .learning-ladder__projects li { position: relative; padding-left: 13px; }
  .learning-ladder__projects li::before { position: absolute; top: .55em; left: 1px; width: 4px; height: 4px; border-radius: 50%; background: var(--color-muted); content: ""; }
  @media (min-width: 768px) {
    .learning-ladder__head { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 32px; }
    .learning-ladder__head .head { max-width: 720px; }
    .learning-ladder__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
    .learning-ladder__step,
    .learning-ladder__step:last-child {
      grid-template-columns: 40px minmax(0, 1fr);
      align-content: start;
      gap: 16px;
      min-height: 0;
      padding: 24px 0;
      border-top: 1px solid var(--color-line);
      border-bottom: 0;
    }
    .learning-ladder__step:not(:last-child)::before { display: none; }
    .learning-ladder__marker { width: 36px; height: 36px; }
    .learning-ladder__steps::before { display: none; }
    .learning-ladder__copy { gap: 10px; }
    .learning-ladder__step--result .learning-ladder__copy h3 { color: var(--color-ink); }
  }
  @media (min-width: 1280px) {
    .learning-ladder__steps { grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: end; gap: 0; }
    .learning-ladder__step,
    .learning-ladder__step:last-child {
      display: flex;
      min-height: 248px;
      flex-direction: column;
      justify-content: flex-start;
      gap: 18px;
      padding: 18px 20px 0 0;
      border-top: 1px solid var(--color-line);
      border-bottom: 0;
    }
    .learning-ladder__step:nth-child(2) { min-height: 312px; }
    .learning-ladder__step:nth-child(3) { min-height: 376px; }
    .learning-ladder__step:nth-child(4) { min-height: 440px; }
    .learning-ladder__step + .learning-ladder__step { padding-left: 20px; border-left: 1px solid var(--color-line); }

    .learning-ladder__marker { width: 40px; height: 40px; }
    .learning-ladder__copy { gap: 10px; }
    .learning-ladder__copy h3 { font-size: 26px; }
    .learning-ladder__step--result .learning-ladder__copy h3 { color: var(--color-ink); }
  }
</style>
