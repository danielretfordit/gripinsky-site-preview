---
import { Image } from 'astro:assets';
import meshRaw from '../assets/ai/mesh-raw.jpg';
import meshScene from '../assets/ai/mesh-scene.jpg';
interface Text { eyebrow: string; title: string; accent: string; quote: string; body: string; cta: string }
interface Props { price: string; text?: Text }
// Тексты по умолчанию; на главной приходят из админки («Главная страница», блок «ИИ в 3D»)
const DEFAULT: Text = {
  eyebrow: 'Новый курс / ИИ в 3D', title: 'ИИ', accent: 'ИЛИ УМРИ', quote: 'ИИ не заменит 3D-художника. Его заменит художник с ИИ',
  body: 'Нейросети во всём пайплайне: референсы, 3D-модель по фото, ретопология, текстуры и сцена. Рутину отдаёте ИИ, качество доводите сами. Курс входит в «Базу 3D-визуализатора».', cta: 'Смотреть курс',
};
const { price, text = DEFAULT } = Astro.props;
---

<div class="ai-feature">
  <div class="ai-feature__copy">
    <p class="ai-feature__eyebrow t-overline">{text.eyebrow}</p>
    <h2 id="ai-title" class="t-h2">{text.title} <span>{text.accent}</span></h2>
    <p class="ai-feature__quote t-quote">{text.quote}</p>
    <p class="ai-feature__body t-body">{text.body}</p>
    <div class="ai-feature__action"><a href="/ai" class="btn btn-primary btn-lg">{text.cta} <span aria-hidden="true">↗</span></a><span>от {price}</span></div>
  </div>
  <figure class="ai-feature__visual">
    {/* Одна сцена: слева сетка модели после нейросети, справа доведённый рендер */}
    <Image src={meshScene} alt="Консоль с вазой: модель после нейросети и готовая визуализация" widths={[640, 960, 1280]} sizes="(min-width: 768px) 40vw, 100vw" loading="lazy" class="ai-feature__img" />
    <Image src={meshRaw} alt="" widths={[640, 960, 1280]} sizes="(min-width: 768px) 40vw, 100vw" loading="lazy" class="ai-feature__img ai-feature__img--raw" />
    <span class="ai-feature__split" aria-hidden="true"></span>
    <figcaption><span>Модель от ИИ</span><span>Рендер художника</span></figcaption>
  </figure>
</div>

<style>
  .ai-feature { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); overflow: hidden; border-block: 1px solid var(--color-line); background: var(--color-bg-2); }
  .ai-feature__copy { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: clamp(24px, 3vw, 40px); }
  .ai-feature__eyebrow { color: var(--color-ink-2); }
  .ai-feature h2 { max-width: 670px; }
  .ai-feature h2 span { display: block; color: var(--color-muted); }
  .ai-feature__quote { max-width: 559.98px; }
  .ai-feature__body { max-width: 560px; color: var(--color-ink-2); }
  .ai-feature__action { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 6px; padding-top: 8px; font-weight: 650; }
  /* Настоящая работа вместо условного знака: сетка и рендер одной сцены, разделённые лаймовой линией */
  .ai-feature__visual { position: relative; min-height: 260px; margin: 0; overflow: hidden; border-radius: var(--radius-media); background: var(--color-bg); }
  .ai-feature__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; transition: scale 1.2s var(--ease-out); }
  .ai-feature__img--raw { clip-path: inset(0 50% 0 0); }
  .ai-feature__split { position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: var(--color-lime); }
  .ai-feature__visual figcaption { position: absolute; right: 14px; bottom: 14px; left: 14px; display: flex; justify-content: space-between; gap: 12px; }
  .ai-feature__visual figcaption span { padding: 6px 10px; border-radius: var(--radius-field); background: rgb(17 19 19 / .82); color: var(--color-ink); font-size: var(--type-label); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  @media (hover: hover) { .ai-feature:hover .ai-feature__img { scale: 1.03; } }
  @media (max-width: 767.98px) {
    .ai-feature { grid-template-columns: 1fr; }
    .ai-feature__copy { padding: 30px 24px; }
    .ai-feature__visual { aspect-ratio: 16 / 10; min-height: 0; }
  }
  @media (max-width: 559.98px) {
    .ai-feature__copy { padding: 24px 20px; }
  }
</style>
