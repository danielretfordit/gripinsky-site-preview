---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import { personMap, visibleWorks, type PersonView } from '../lib/people';
import CourseDiagram from './CourseDiagram.astro';
import interiorModel from '../assets/home/ba-model.jpg';
import interiorRender from '../assets/home/ba-render.jpg';
interface Props { course: CollectionEntry<'courses'>['data']; teachers: (PersonView | undefined)[] }
const {course:c,teachers}=Astro.props;
const people=await personMap();
const works=(await visibleWorks()).filter(w=>c.studentWorks.some(ref=>ref.id===w.id)&&people.get(w.data.author.id)?.consent==='yes');
const bios=new Map((await getCollection('people')).map(p=>[p.id,p.data.bio]));
const testimonials=c.testimonials.filter(t=>t.consent);
const stages=c.modules;
const interior=c.legacyPath==='/interiorpro';
const resultImage=(i:number)=>interior ? (i===0?interiorModel:interiorRender) : (i===1?undefined:c.cover);
---
<nav class="course-nav" aria-label="Разделы курса"><div class="wrap"><a href="#course-about">Результат</a><a href="#course-program">Программа</a><a href="#course-learning">Обучение</a>{works.length>0&&<a href="#course-works">Работы</a>}{testimonials.length>0&&<a href="#course-reviews">Отзывы</a>}<a href="#course-price">Стоимость</a>{c.courseFaq.length>0&&<a href="#course-questions">Вопросы</a>}</div></nav>
<section class="wrap section" aria-labelledby="course-about">
 <div class="section-intro"><p class="t-overline">01 / Задачи курса</p><h2 id="course-about" class="t-h2">Что сможете делать<br/><span class="text-heading-muted">после практики.</span></h2></div>
 <div class="result-grid">{c.benefits.map((b,i)=><article><div class="result-visual">{resultImage(i) ? <Image src={resultImage(i)!} alt={`Визуальные материалы: ${b.title}`} widths={[480,800]} sizes="(min-width:1024px) 30vw, 90vw" class:list={[i===2 && 'result-detail']}/> : <CourseDiagram variant={i%3} software={c.software}/>}</div><h3 class="t-h3">{b.title}</h3><p class="t-body text-ink-2">{b.text}</p></article>)}</div>
 <details class="course-details"><summary class="t-title">Подробнее о курсе и навыках</summary><p class="t-body text-ink-2">{c.description}</p><ul class="t-body text-ink-2">{c.outcomes.map(o=><li>{o}</li>)}</ul></details>
</section>
<section class="wrap section" aria-labelledby="course-audience"><div class="audience-panel"><div><p class="t-overline">Подготовка</p><h2 id="course-audience" class="t-h2">Подходит ли курс<br/><span class="text-heading-muted">вашей задаче?</span></h2><ul class="audience-list t-body text-ink-2">{c.forWhom.map(p=><li>{p}</li>)}</ul></div><div><h3 class="t-h3">Что нужно знать до начала</h3><ul class="t-body text-ink-2">{c.prerequisites.map(p=><li>{p}</li>)}</ul><a href="#consult" class="link t-small">Помочь с выбором курса →</a></div></div></section>
<section id="course-program" class="wrap section" aria-labelledby="course-program-title">
 <div class="section-intro"><p class="t-overline">02 / Маршрут обучения</p><h2 id="course-program-title" class="t-h2" tabindex="-1">Программа курса.<br/><span class="text-heading-muted">От задачи к результату.</span></h2><p class="t-lead text-ink-2">Выберите этап, чтобы посмотреть темы, практику и результат.</p></div>
 <div class="program-layout" data-course-program>
  <div class="stage-nav" role="tablist" aria-label="Этапы программы" aria-orientation="vertical">{stages.map((m,i)=><button id={`course-tab-${i}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`course-stage-${i}`} tabindex={i===0?0:-1}><span class="t-overline">{String(i+1).padStart(2,'0')}</span><span class="t-title">{m.title}</span><span class="stage-dot" aria-hidden="true"></span></button>)}</div>
  <div>{stages.map((m,i)=><article class="stage-panel" id={`course-stage-${i}`} role="tabpanel" aria-labelledby={`course-tab-${i}`} tabindex="0" data-course-panel><div class="stage-panel-head"><p class="t-overline">Этап {String(i+1).padStart(2,'0')} / {String(stages.length).padStart(2,'0')}</p><h3 class="t-h3">{m.title}</h3><p class="t-body text-ink-2">{m.description}</p></div><div class="stage-illustration">{interior ? <Image src={i===0?interiorModel:interiorRender} alt="Иллюстрация интерьерной сцены" widths={[640,960]} sizes="(min-width:1024px) 55vw, 90vw"/> : <CourseDiagram variant={i%3} software={c.software}/>}</div><div class="stage-content"><div><span class="t-overline">Темы</span><ul class="topic-chips">{m.topics.map(t=><li class="t-small">{t}</li>)}</ul>{m.practice&&<p class="t-body"><b>Практика: </b>{m.practice}</p>}{m.tools.length>0&&<p class="t-small text-muted">{m.tools.join(', ')}</p>}</div><div class="stage-result"><span class="t-overline">На выходе</span><p class="t-title">{m.result}</p></div></div></article>)}</div>
 </div>
</section>
<section class="wrap section" aria-labelledby="course-projects"><div class="project-layout"><div><p class="t-overline">Ваша практика</p><h2 id="course-projects" class="t-h2">Что вы создадите.</h2><p class="t-body text-ink-2">Примените изученные приёмы в заданиях курса.</p></div><div>{c.projects.map(p=><article class="project-card">{p.image&&<div class="media-frame media-frame--card"><Image src={p.image} alt={p.title} widths={[480,800]} sizes="(min-width:1024px) 50vw, 90vw" class="h-full w-full object-cover"/></div>}<h3 class="t-h3">{p.title}</h3><p class="t-body text-ink-2">{p.description}</p>{p.deliverable&&<div class="project-result"><span class="t-overline">Результат</span><p class="t-title">{p.deliverable}</p></div>}</article>)}{!c.projects.length&&<p class="t-lead">{c.finalProject}</p>}</div></div></section>
<section class="wrap section" aria-labelledby="course-learning"><div class="format-grid"><div><p class="t-overline">03 / Как проходит обучение</p><h2 id="course-learning" class="t-h2">Изучайте.<br/>Применяйте.<br/><span class="text-heading-muted">Уточняйте.</span></h2>{c.trial&&<a href={c.trial} class="link t-small">Познакомиться с подачей →</a>}</div><div class="format-list">{c.learning.map((item,i)=><article><span class="t-overline">{String(i+1).padStart(2,'0')}</span><div><h3 class="t-h3">{item.title}</h3><p class="t-body text-ink-2">{item.text}</p></div></article>)}</div></div>
 {teachers.length>0&&<div class="teacher-strip"><h3 id="course-teachers" class="t-overline">Преподаватели курса</h3><div class="teacher-grid">{teachers.filter(Boolean).map(t=><article>{t!.photo&&<Image src={t!.photo} alt={t!.name} width={96} class="teacher-photo"/>}<div><h4 class="t-title">{t!.name}</h4>{bios.get(t!.id)&&<p class="t-small text-ink-2">{bios.get(t!.id)}</p>}</div></article>)}</div></div>}
</section>
{works.length>0&&<section id="course-works" class="wrap section"><div class="gallery-heading"><div><p class="t-overline">Результаты учеников</p><h2 class="t-h2">Лучше увидеть.</h2></div><p class="t-body text-ink-2">Работы учеников этого курса.</p></div><div class="work-layout">{works.map((w,i)=><figure class:list={[i===0&&'work-main']}><div class="media-frame media-frame--work-card"><Image src={w.data.image} alt={w.data.alt} widths={[480,800,1200]} sizes={i===0?'(min-width:1024px) 60vw, 90vw':'(min-width:1024px) 30vw, 90vw'} class="h-full w-full object-cover"/></div><figcaption class="t-title">{w.data.title}<span class="t-small text-muted">{people.get(w.data.author.id)?.name}</span></figcaption></figure>)}</div></section>}
{testimonials.length>0&&<section id="course-reviews" class="wrap section"><div class="reviews-layout"><div><p class="t-overline">Опыт учеников</p><h2 class="t-h2">Что получилось<br/><span class="text-heading-muted">после курса.</span></h2></div><div class="review-list">{testimonials.map(t=><figure class="review-card"><blockquote class="t-quote">{t.text}</blockquote><figcaption class="t-title">{t.author}{t.context&&<span class="t-small text-muted">{t.context}</span>}</figcaption></figure>)}</div></div></section>}
{c.trial&&<section class="wrap section"><div class="trial-panel"><div><p class="t-overline">Перед покупкой</p><h2 class="t-h3">Посмотрите, как объясняет преподаватель.</h2><p class="t-body text-ink-2">{c.trialDescription||'Бесплатные уроки помогут оценить темп и подачу материала.'}</p></div><a href={c.trial} class="btn btn-secondary">Открыть бесплатные уроки</a></div></section>}
<slot name="price"/>
{c.requirements.length>0&&<section class="wrap section"><details class="course-details"><summary class="t-title">Компьютер и программы</summary><ul class="t-body text-ink-2">{c.requirements.map(t=><li>{t}</li>)}</ul></details></section>}
{c.courseFaq.length>0&&<section class="wrap section" aria-labelledby="course-questions"><div class="faq-layout"><div><p class="t-overline">Остались вопросы</p><h2 id="course-questions" class="t-h2">До начала курса.</h2></div><div>{c.courseFaq.map(f=><details class="faq-item"><summary class="t-title">{f.question}<span aria-hidden="true">+</span></summary><p class="t-body text-ink-2">{f.answer}</p></details>)}</div></div></section>}
<script>
 document.querySelectorAll('[data-course-program]').forEach(root=>{
  const tabs=Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  function select(index:number){tabs.forEach((t,i)=>{const active=i===index;t.setAttribute('aria-selected',String(active));t.tabIndex=active?0:-1;const p=document.getElementById(t.getAttribute('aria-controls')!);if(p)p.hidden=!active;});}
  select(0);
  tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>select(i));tab.addEventListener('keydown',e=>{let next=i;if(e.key==='ArrowDown'||e.key==='ArrowRight')next=(i+1)%tabs.length;else if(e.key==='ArrowUp'||e.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();select(next);tabs[next].focus();});});
 });
</script>
<style>
 .course-nav{position:sticky;top:var(--header-h);z-index:20;background:var(--color-bg);border-block:1px solid var(--color-line)}.course-nav .wrap{display:flex;gap:28px;overflow:auto;padding-block:6px;scrollbar-width:none}.course-nav a{display:inline-flex;align-items:center;min-height:var(--tap);white-space:nowrap;color:var(--color-ink-2);font-size:var(--type-small)}@media(hover:hover){.course-nav a:hover{color:var(--color-ink)}}
 .result-visual{aspect-ratio:var(--media-ratio-card);overflow:hidden;border-radius:2px;background:var(--color-surface)}.result-visual :global(img){width:100%;height:100%;object-fit:cover}.result-visual :global(.result-detail){transform:scale(1.2);object-position:75% 50%}.stage-illustration :global(img){width:100%;height:clamp(200px,24vw,260px);object-fit:cover}
 .section-intro{max-width:880px;margin-bottom:32px}.section-intro h2{margin-block:16px}.result-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.result-grid h3{margin:20px 0 12px}.result-grid p{margin:0}.course-details{border-top:1px solid var(--color-line);padding-top:20px;margin-top:28px;max-width:980px}.course-details summary{cursor:pointer}.course-details ul{padding-left:20px}.course-details li{margin-block:12px}
 .audience-panel{display:grid;grid-template-columns:1fr 1fr;gap:60px;background:var(--color-surface);padding:40px;border-radius:2px}.audience-panel h2{margin-bottom:24px}.audience-panel ul{padding-left:20px}.audience-panel li{margin-block:14px}.program-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:32px}.stage-nav{display:flex;flex-direction:column;align-self:start;border-top:1px solid var(--color-line)}.stage-nav button{display:grid;grid-template-columns:32px minmax(0,1fr) 8px;gap:16px;align-items:center;text-align:left;padding:24px 18px;border-bottom:1px solid var(--color-line);background:none;color:var(--color-ink-2);cursor:pointer}.stage-nav button[aria-selected="true"]{background:var(--color-surface);color:var(--color-ink)}.stage-dot{height:6px;width:6px;border-radius:50%;background:var(--color-lime);opacity:0}.stage-nav button[aria-selected="true"] .stage-dot{opacity:1}.stage-panel{background:var(--color-surface);border-radius:2px;overflow:hidden;margin-bottom:24px}.stage-panel[hidden]{display:none}.stage-panel-head,.stage-content{padding:28px}.stage-panel-head h3{margin:14px 0}.stage-panel-head p{margin-bottom:0}.stage-illustration{max-height:260px;overflow:hidden}.stage-content{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:24px}.topic-chips{display:flex;flex-wrap:wrap;gap:8px;padding:0;list-style:none;margin-block:12px 20px}.topic-chips li{border:1px solid var(--color-line);padding:8px 10px}.stage-result{border-left:1px solid var(--color-line);padding-left:24px}.stage-result p{margin-top:12px}
 .project-layout,.format-grid,.reviews-layout,.faq-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:70px}.project-card{border-top:1px solid var(--color-line);padding:28px;background:var(--color-surface);margin-bottom:20px}.project-card h3{margin-top:0}.project-result{border-top:1px solid var(--color-line);padding-top:20px;margin-top:24px}.project-result p{margin:12px 0 0}.format-grid h2{margin-block:20px 28px}.format-list article{display:grid;grid-template-columns:36px minmax(0,1fr);gap:24px;border-top:1px solid var(--color-line);padding:26px 0}.format-list h3{margin-top:0}.format-list p{margin-top:var(--stack-tight)}.format-list p{margin-bottom:0}.teacher-strip{border-block:1px solid var(--color-line);margin-top:40px;padding-block:24px}.teacher-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:24px}.teacher-grid article{display:flex;align-items:start;gap:16px}.teacher-grid h4,.teacher-grid p{margin:0 0 8px}.teacher-photo{width:80px;height:80px;object-fit:cover;flex-shrink:0;border-radius:2px}.gallery-heading{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:32px}.gallery-heading h2{margin-bottom:0}.work-layout{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.work-layout figure{margin:0}.work-main{grid-column:span 2;grid-row:span 2}.work-layout figcaption{display:flex;flex-direction:column;gap:8px;margin-top:14px}.review-list{display:grid;gap:24px}.review-card{margin:0;padding:36px;background:var(--color-surface);border-top:1px solid var(--color-line-strong)}.review-card blockquote{margin:0 0 28px}.review-card figcaption{display:flex;flex-direction:column;gap:8px}.trial-panel{padding:28px 32px;border-block:1px solid var(--color-line);display:flex;justify-content:space-between;align-items:center;gap:24px}.trial-panel h2{margin-block:14px}.trial-panel p{margin-bottom:0}.trial-panel a{flex-shrink:0}.faq-item{border-bottom:1px solid var(--color-line);padding-block:22px}.faq-item summary{display:flex;justify-content:space-between;gap:20px;cursor:pointer}.faq-item p{margin-bottom:0}
 @media(max-width:1023px){.audience-panel{gap:28px;padding:28px}.result-grid{gap:16px}.project-layout,.format-grid,.reviews-layout,.faq-layout{gap:32px}.program-layout{grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:20px}.stage-content{grid-template-columns:1fr}.stage-result{border-left:0;border-top:1px solid var(--color-line);padding:20px 0 0}}
 @media(max-width:767px){.course-nav .wrap{gap:24px}.result-grid{grid-template-columns:1fr;gap:32px}.audience-panel,.project-layout,.format-grid,.reviews-layout,.faq-layout{grid-template-columns:1fr;gap:24px}.audience-panel{padding:24px}.program-layout{grid-template-columns:1fr;gap:16px}.stage-nav{display:grid;grid-template-columns:1fr 1fr;border-top:0;gap:8px}.stage-nav button{padding:16px 12px;grid-template-columns:24px minmax(0,1fr) 6px;gap:8px;border:1px solid var(--color-line)}.stage-nav .t-title{font-size:var(--type-small)}.stage-panel-head,.stage-content,.project-card,.review-card{padding:24px}.stage-illustration{max-height:200px}.teacher-grid{grid-template-columns:1fr}.gallery-heading{display:block}.work-layout{grid-template-columns:1fr 1fr;gap:16px}.work-main{grid-column:span 2;grid-row:auto}.trial-panel{flex-direction:column;align-items:flex-start;padding:24px 0}}
 @media(prefers-reduced-motion:no-preference){.stage-panel:not([hidden]){animation:stage-in .2s ease-out}@keyframes stage-in{from{opacity:.7;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}}

 .course-details>summary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:var(--tap);cursor:pointer}.course-details>summary::after{content:'+';flex-shrink:0;color:var(--color-muted);font-size:var(--type-title);font-weight:400;transition:transform var(--dur) ease}.course-details[open]>summary::after{transform:rotate(45deg)}
 .faq-item>summary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:var(--tap);padding-block:10px;cursor:pointer}
</style>
