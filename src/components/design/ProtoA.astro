---
// Вариант A «Аккуратная эволюция»: нынешняя система, но с одним ритмом отступов,
// одной сеткой карточек и лаймом только на H1, главной кнопке и ключевых цифрах.
import { Image } from 'astro:assets';
import type { ProtoData } from './data';

interface Props { d: ProtoData }
const { d } = Astro.props;
const { stats, prices, rub, sp, pkg, pkgLines, tariffs, galleryCount } = d;

const hero = d.work('rossoshansky-gostinaya')!;
const steps = [
  {
    label: 'Шаг 1', title: 'База', img: d.work('merkulova-kuhnya'), cap: 'Работа с курса базы',
    text: '3ds Max, Corona и ИИ в 3D. От первого запуска программы до фотореалистичного рендера.',
    facts: [['230', 'уроков'], ['104', 'модели'], ['7', 'визуализаций']],
    price: `от ${rub(prices.base)}`, href: '#a-price',
  },
  {
    label: 'Шаг 2', title: 'Профессия', img: d.work('kondratenko-interer'), cap: 'Работа с курса профессии',
    text: 'Интерьеры, экстерьеры или модели для стоков. Работа по ТЗ, общение с заказчиком и цена проекта.',
    facts: [['3', 'профессии'], ['4', 'проекта интерьеров'], ['1', 'проект по ТЗ']],
    price: `от ${rub(prices.profMin)}`, href: '#a-price',
  },
  {
    label: 'Итог', title: 'Портфолио и заказы', img: d.work('bolshunova-banya-1'), cap: 'Коммерческий проект',
    text: 'Работы в портфолио, проект по реальному ТЗ и понимание, где брать заказы и сколько просить.',
    facts: [[rub(pkg.savings).replace(' ₽', ''), '₽ выгоды в пакете'], ['1', 'формат на весь пакет']],
    price: `пакет от ${rub(prices.pkgMin)}`, href: '#a-price',
  },
];
const works = d.pick(['bolshunova-ostrov-1', 'kamola-kuhnya', 'tveritin-villa-1', 'korotovskaya-shale', 'zaytseva-dom-v-lesu', 'shesterikova-loft']);
const reviews = d.reviews.slice(0, 3);
const tOpt = tariffs.find((t) => t.id === 'opt')!;
const fmt = pkg.lines.find((l) => l.kind === 'format');
---
<div class="pa">
  <!-- 1. Первый экран -->
  <section class="wrap pa-hero" aria-labelledby="a-hero">
    <div class="pa-hero__grid">
      <div class="pa-hero__text">
        <p class="t-overline">Направление</p>
        <h1 id="a-hero" class="pa-h1">Курсы <span class="nowrap">3D-визуализации</span> <span class="t-accent">с нуля до заказов</span></h1>
        <p class="pa-lead">Интерьеры, экстерьеры и модели для стоков в 3ds Max и Corona. С нуля или чтобы закрыть пробелы, если вы уже работаете в 3D.</p>
        <div class="pa-actions">
          <a href="#a-steps" class="btn btn-primary btn-lg">Начать с базы</a>
          <a href="#a-final" class="btn btn-secondary btn-lg">Бесплатные уроки</a>
        </div>
        <p class="pa-note">База от <b>{rub(prices.base)}</b> или {sp(prices.baseMonthly)}&nbsp;₽/мес. <a href="#a-final" class="link">Тест за 1 минуту</a></p>
      </div>
      <figure class="pa-hero__media">
        <div class="pa-split">
          <Image src={hero.image} alt={hero.alt} widths={[480, 768, 1080]} sizes="(min-width: 1024px) 46vw, 100vw" loading="eager" fetchpriority="high" />
          {hero.before && <div class="pa-split__before"><Image src={hero.before} alt="Та же сцена: модель в 3ds Max" widths={[480, 768, 1080]} sizes="(min-width: 1024px) 46vw, 100vw" loading="eager" /></div>}
          <span class="pa-split__line" aria-hidden="true"></span>
          <span class="badge-on-image pa-split__l">Модель в 3ds Max</span>
          <span class="badge-on-image pa-split__r">Рендер в Corona</span>
        </div>
        <figcaption>{hero.author}, гостиная. {hero.award}</figcaption>
      </figure>
    </div>
    <dl class="pa-stats">
      <div><dt>выпускников</dt><dd>{stats.graduates}</dd></div>
      <div><dt>учим по своей системе</dt><dd>{stats.years}</dd></div>
      <div><dt>оценка на Яндекс Картах</dt><dd>{stats.rating}</dd></div>
      <div><dt>подписчиков на YouTube</dt><dd>{stats.subscribers}</dd></div>
    </dl>
  </section>

  <!-- 2. Как устроено обучение -->
  <section id="a-steps" class="wrap pa-sec" aria-labelledby="a-steps-t">
    <header class="pa-head">
      <p class="t-overline">Путь ученика</p>
      <h2 id="a-steps-t" class="t-h2">Как устроено <span class="t-accent">обучение</span></h2>
      <p class="pa-head__lead">Сначала база: программы и первые работы. Затем профессия: заказчик, ТЗ и цена. Вместе это пакет с одним форматом обучения.</p>
    </header>
    <ol class="pa-steps">
      {steps.map((s) => (
        <li class="pa-card">
          {s.img && (
            <figure class="pa-card__media">
              <Image src={s.img.image} alt={s.img.alt} widths={[400, 640, 800]} sizes="(min-width: 1024px) 30vw, 100vw" style={`object-position:${s.img.focus}`} />
              <figcaption class="badge-on-image">{s.img.author}. {s.cap}</figcaption>
            </figure>
          )}
          <div class="pa-card__body">
            <p class="pa-card__label">{s.label}</p>
            <h3 class="pa-card__title">{s.title}</h3>
            <p class="pa-card__text">{s.text}</p>
            <dl class="pa-facts">
              {s.facts.map(([n, l]) => <div><dd>{n}</dd><dt>{l}</dt></div>)}
            </dl>
            <p class="pa-card__price"><span>{s.price}</span><a href={s.href} class="link">Подробнее ↓</a></p>
          </div>
        </li>
      ))}
    </ol>
    <p class="t-hand pa-handnote" aria-hidden="true">без профессии после базы непонятно, где брать заказы и сколько просить</p>
  </section>

  <!-- 3. Результаты -->
  <section id="a-works" class="wrap pa-sec" aria-labelledby="a-works-t">
    <header class="pa-head pa-head--row">
      <div>
        <p class="t-overline">Результаты</p>
        <h2 id="a-works-t" class="t-h2">Работы <span class="t-accent">учеников</span></h2>
        <p class="pa-head__lead">Всё сделано во время учёбы. Лучшие работы получают «Рендер дня» на стримах GRIPINSKY TV и «Царя горы» на 3DDD.</p>
      </div>
      <a href="/gallery" class="link">Все {galleryCount} работ →</a>
    </header>
    <div class="pa-works">
      {works.map((w, i) => (
        <figure class={`pa-work pa-work--${i + 1}`}>
          <div class="pa-work__img"><Image src={w.image} alt={w.alt} widths={[480, 720, 1080]} sizes={i === 0 ? '(min-width: 1024px) 58vw, 100vw' : '(min-width: 1024px) 30vw, 50vw'} style={`object-position:${w.focus}`} /></div>
          <figcaption><b>{w.author}</b> {w.title}{w.award && <span>{w.award}</span>}</figcaption>
        </figure>
      ))}
    </div>
    <ul class="pa-reviews">
      {reviews.map((r) => (
        <li>
          <blockquote>{r.text}</blockquote>
          <p><b>{r.author}</b>, {r.role}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 4. Цена и пакет -->
  <section id="a-price" class="wrap pa-sec" aria-labelledby="a-price-t">
    <header class="pa-head">
      <p class="t-overline">Цены</p>
      <h2 id="a-price-t" class="t-h2">Формат: <span class="t-accent">как будете учиться</span></h2>
      <p class="pa-head__lead">Программа одна: 230 уроков и доступ на год. Формат решает, сколько помощи вы получите по дороге, и действует на весь пакет.</p>
    </header>
    <div class="pa-price">
      <div class="pa-tariffs" role="radiogroup" aria-label="Формат обучения">
        {tariffs.map((t) => (
          <div class="choice pa-tariff" role="radio" aria-checked={t.id === 'opt' ? 'true' : 'false'} tabindex={t.id === 'opt' ? 0 : -1}>
            <span class="radio-dot" aria-hidden="true"></span>
            <span class="pa-tariff__main">
              <span class="pa-tariff__name">{t.name}{t.badge && <span class="chip">{t.badge}</span>}</span>
              <span class="pa-tariff__short">{t.short}</span>
            </span>
            <span class="pa-tariff__price">{rub(t.price)}</span>
          </div>
        ))}
        <p class="pa-tariffs__note">Цена указана за базу. Курс профессии стоит одинаково в любом формате.</p>
      </div>
      <aside class="pa-pkg" aria-label="Пример пакета">
        <p class="t-overline">Пример пакета</p>
        <h3 class="pa-pkg__title">База + Интерьеры PRO</h3>
        <ul class="pa-pkg__lines">
          <li><span>{pkgLines.base}</span><b>{rub(prices.base)}</b></li>
          <li><span>{pkgLines.prof}</span><b>{rub(d.cat.professions.int.courses[0].price)}</b></li>
          {fmt && <li><span>Формат «{tOpt.name}»</span><b>+{rub(fmt.price)}</b></li>}
          <li class="is-gift"><span>{pkgLines.gift}</span><b>в подарок</b></li>
        </ul>
        <div class="pa-pkg__total">
          <span>Итого</span>
          <b>{rub(pkg.total)}</b>
        </div>
        <p class="pa-pkg__sub">или {sp(pkg.monthly)}&nbsp;₽/мес в рассрочку</p>
        <p class="pa-pkg__save">Выгода {rub(pkg.savings)} по сравнению с покупкой по отдельности</p>
        <a href="#a-final" class="btn btn-primary btn-lg btn-block">Оформить пакет</a>
        <a href="#a-final" class="link-sea pa-pkg__alt">Купить только базу</a>
      </aside>
    </div>
  </section>

  <!-- 5. Финальный призыв -->
  <section id="a-final" class="wrap pa-sec pa-final" aria-labelledby="a-final-t">
    <h2 id="a-final-t" class="t-h2">Начните с <span class="t-accent">бесплатных уроков</span></h2>
    <p>Оцените формат и педагога до оплаты. Не знаете, с чего начать? Тест за 1 минуту соберёт пакет и покажет цену.</p>
    <div class="pa-actions pa-actions--center">
      <a href="#" class="btn btn-primary btn-lg">Смотреть бесплатные уроки</a>
      <a href="#" class="btn btn-secondary btn-lg">Пройти тест</a>
    </div>
    <a href="#" class="link">Или бесплатная консультация</a>
  </section>
</div>

<style>
  /* Ритм варианта A: одна шкала на всю страницу */
  .pa { --sec: 64px; --head: 24px; --pad: 20px; --gap: 16px; }
  @media (min-width: 768px) { .pa { --sec: 80px; --head: 32px; --pad: 24px; --gap: 20px; } }
  @media (min-width: 1024px) { .pa { --sec: 96px; --head: 40px; --pad: 28px; --gap: 24px; } }
  @media (min-width: 1280px) { .pa { --sec: 112px; --pad: 32px; } }
  .pa-sec { padding-top: var(--sec); }
  .pa > :last-child { padding-bottom: var(--sec); }
  .nowrap { white-space: nowrap; }

  /* Заголовок секции */
  .pa-head { display: flex; flex-direction: column; gap: 12px; margin-bottom: var(--head); }
  .pa-head :global(.t-h2) { margin-bottom: 4px; }
  .pa-head__lead { margin: 0; max-width: 640px; color: var(--color-ink-2); }
  .pa-head--row { flex-direction: column; gap: 16px; }
  .pa-head--row > div { display: flex; flex-direction: column; gap: 12px; }
  @media (min-width: 768px) { .pa-head--row { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 32px; } }

  /* Первый экран */
  .pa-hero { padding-top: 32px; }
  @media (min-width: 1024px) { .pa-hero { padding-top: 56px; } }
  .pa-hero__grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 1024px) { .pa-hero__grid { grid-template-columns: 6fr 5fr; gap: 64px; } }
  .pa-hero__text { display: flex; flex-direction: column; gap: 20px; }
  .pa-h1 { margin: 0; font-size: clamp(34px, 4.6vw, 62px); font-weight: 800; line-height: 1.02; letter-spacing: -0.02em; text-transform: uppercase; }
  .pa-h1 .t-accent { display: block; }
  .pa-lead { margin: 0; max-width: 560px; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.5; color: var(--color-ink-2); }
  .pa-actions { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  @media (min-width: 480px) { .pa-actions { flex-direction: row; flex-wrap: wrap; } }
  .pa-actions--center { justify-content: center; }
  .pa-note { margin: 0; font-size: 15px; color: var(--color-ink-2); }
  .pa-note b { color: var(--color-ink); }

  .pa-hero__media { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .pa-hero__media figcaption { font-size: 14px; color: var(--color-muted); }
  .pa-split { position: relative; aspect-ratio: 4 / 3; border-radius: 20px; overflow: hidden; }
  .pa-split :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pa-split__before { position: absolute; inset: 0; clip-path: inset(0 50% 0 0); }
  .pa-split__line { position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: var(--color-lime); }
  .pa-split__l { position: absolute; left: 12px; top: 12px; }
  .pa-split__r { position: absolute; right: 12px; top: 12px; }

  .pa-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 16px; margin: 40px 0 0; padding-top: 24px; border-top: 1px solid var(--color-line); }
  @media (min-width: 768px) { .pa-stats { grid-template-columns: repeat(4, 1fr); margin-top: 56px; padding-top: 32px; } }
  .pa-stats div { display: flex; flex-direction: column-reverse; gap: 6px; }
  .pa-stats dd { margin: 0; font-size: clamp(28px, 2.6vw, 40px); font-weight: 800; line-height: 1; letter-spacing: -0.01em; }
  .pa-stats dt { font-size: 15px; color: var(--color-muted); }

  /* Шаги: три одинаковые карточки */
  .pa-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap); }
  @media (min-width: 1024px) { .pa-steps { grid-template-columns: repeat(3, 1fr); } }
  .pa-card { display: flex; flex-direction: column; border: 1px solid var(--color-line); border-radius: 20px; overflow: hidden; }
  .pa-card__media { position: relative; margin: 0; aspect-ratio: 16 / 10; min-height: 0; overflow: hidden; flex: none; }
  .pa-card__media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .pa-card__media figcaption { position: absolute; left: 12px; bottom: 12px; font-size: 13px; font-weight: 500; }
  .pa-card__body { flex: 1; display: flex; flex-direction: column; gap: 12px; padding: var(--pad); }
  .pa-card__label { margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-sea); }
  .pa-card__title { margin: 0; font-size: clamp(24px, 2.2vw, 28px); font-weight: 800; line-height: 1.15; }
  .pa-card__text { margin: 0; color: var(--color-ink-2); }
  .pa-facts { display: flex; flex-wrap: wrap; gap: 12px 24px; margin: 8px 0 0; }
  .pa-facts div { display: flex; flex-direction: column; gap: 2px; }
  .pa-facts dd { margin: 0; font-size: 28px; font-weight: 800; line-height: 1; color: var(--color-lime); }
  .pa-facts dt { font-size: 14px; color: var(--color-muted); }
  .pa-card__price { margin: auto 0 0; padding-top: 16px; border-top: 1px solid var(--color-line); display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-weight: 700; }
  .pa-card__price span { font-size: 18px; }
  .pa-card__price .link { font-size: 15px; }
  .pa-handnote { margin: 24px 0 0; color: var(--color-sea); max-width: 560px; }

  /* Работы: 12 колонок, одна большая и пять меньших */
  .pa-works { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px var(--gap); }
  .pa-work { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .pa-work__img { position: relative; border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 3; min-height: 0; }
  .pa-work__img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
  .pa-work:hover .pa-work__img :global(img) { transform: scale(1.03); }
  .pa-work figcaption { font-size: 14px; line-height: 1.4; color: var(--color-muted); }
  .pa-work figcaption b { color: var(--color-ink); font-weight: 600; }
  .pa-work figcaption span { display: block; color: var(--color-sea); }
  .pa-work--1, .pa-work--6 { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .pa-works { grid-template-columns: repeat(12, 1fr); }
    .pa-work--1 { grid-column: 1 / 8; grid-row: 1 / 3; }
    .pa-work--1 .pa-work__img { aspect-ratio: auto; flex: 1 1 0; }
    .pa-work--2, .pa-work--3 { grid-column: 8 / 13; }
    .pa-work--2 .pa-work__img, .pa-work--3 .pa-work__img { aspect-ratio: 16 / 9; }
    .pa-work--4 { grid-column: 1 / 5; } .pa-work--5 { grid-column: 5 / 9; } .pa-work--6 { grid-column: 9 / 13; }
  }

  .pa-reviews { list-style: none; margin: 56px 0 0; padding: 0; display: grid; gap: 32px; }
  @media (min-width: 1024px) { .pa-reviews { grid-template-columns: repeat(3, 1fr); gap: var(--gap); margin-top: 72px; } }
  .pa-reviews li { display: flex; flex-direction: column; gap: 12px; padding-top: 20px; border-top: 1px solid var(--color-line); }
  .pa-reviews blockquote { margin: 0; font-size: 17px; line-height: 1.5; }
  .pa-reviews p { margin: 0; font-size: 14px; color: var(--color-muted); }
  .pa-reviews b { color: var(--color-ink); }

  /* Цена */
  .pa-price { display: grid; gap: 32px; align-items: start; }
  @media (min-width: 1024px) { .pa-price { grid-template-columns: 7fr 5fr; gap: 48px; } }
  .pa-tariffs { display: flex; flex-direction: column; gap: 12px; }
  .pa-tariff { display: grid; grid-template-columns: auto 1fr; gap: 4px 16px; align-items: center; padding: 20px; }
  @media (min-width: 768px) { .pa-tariff { grid-template-columns: auto 1fr auto; padding: 24px; } }
  .pa-tariff__main { display: flex; flex-direction: column; gap: 4px; }
  .pa-tariff__name { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 19px; font-weight: 800; }
  .pa-tariff__short { font-size: 15px; color: var(--color-muted); }
  .pa-tariff__price { grid-column: 2; font-size: 22px; font-weight: 800; white-space: nowrap; }
  @media (min-width: 768px) { .pa-tariff__price { grid-column: auto; } }
  .pa-tariffs__note { margin: 4px 0 0; font-size: 14px; color: var(--color-muted); }

  .pa-pkg { display: flex; flex-direction: column; gap: 12px; padding: var(--pad); border: 1px solid var(--color-line); border-radius: 20px; }
  .pa-pkg__title { margin: 0; font-size: 24px; font-weight: 800; }
  .pa-pkg__lines { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; }
  .pa-pkg__lines li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--color-line); font-size: 15px; color: var(--color-ink-2); }
  .pa-pkg__lines b { color: var(--color-ink); white-space: nowrap; }
  .pa-pkg__lines .is-gift b { color: var(--color-sea); }
  .pa-pkg__total { display: flex; justify-content: space-between; align-items: baseline; margin-top: 12px; }
  .pa-pkg__total span { font-size: 17px; font-weight: 700; }
  .pa-pkg__total b { font-size: clamp(32px, 3vw, 40px); font-weight: 800; letter-spacing: -0.01em; }
  .pa-pkg__sub { margin: -6px 0 0; text-align: right; font-size: 15px; color: var(--color-muted); }
  .pa-pkg__save { margin: 0 0 8px; font-size: 15px; color: var(--color-sea); }
  .pa-pkg__alt { align-self: center; padding: 10px; font-size: 15px; }

  /* Финал: без рамки и подложки, только воздух */
  .pa-final { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
  .pa-final p { margin: 0; max-width: 560px; color: var(--color-ink-2); }
  .pa-final .pa-actions { margin-top: 8px; width: 100%; }
  @media (min-width: 480px) { .pa-final .pa-actions { width: auto; } }
</style>
