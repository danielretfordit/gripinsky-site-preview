---
// Переключатель вариантов прототипа. Виден только на /design/*.
// group="layout": варианты структуры A/B/C; group="style": стилевые направления 1–4.
import { VARIANTS } from './data';
import { STYLES } from './styles';
interface Props { current?: string; group?: 'layout' | 'style' }
const { current, group = 'layout' } = Astro.props;
const items = group === 'style'
  ? STYLES.map((s) => ({ href: `/design/style-${s.n}`, key: `style-${s.n}`, label: String(s.n), title: s.name }))
  : VARIANTS.map((v) => ({ href: `/design/${v.id}`, key: v.id, label: v.letter, title: v.name }));
---
<nav class="pnav" aria-label={group === 'style' ? 'Стилевые направления' : 'Варианты прототипа'}>
  <a href="/design" class="pnav__all" aria-current={current ? undefined : 'page'}>{group === 'style' ? 'Стиль' : 'Прототип'}</a>
  {items.map((i) => (
    <a href={i.href} class="pnav__v" aria-current={current === i.key ? 'page' : undefined} title={i.title}>{i.label}</a>
  ))}
</nav>

<style>
  .pnav {
    position: fixed; left: 50%; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 70; transform: translateX(-50%);
    display: flex; align-items: center; gap: 4px; padding: 4px;
    border-radius: 999px; border: 1px solid rgb(231 231 231 / 0.4); background: rgb(16 42 46 / 0.92); backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35); font-family: system-ui, sans-serif;
  }
  .pnav a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; border-radius: 999px; font-size: 15px; font-weight: 700; color: #E7E7E7; text-decoration: none; }
  .pnav a:hover { color: #fff; background: rgb(231 231 231 / 0.08); }
  .pnav__all { padding: 0 16px; font-weight: 600 !important; color: #D3DCE2 !important; }
  .pnav a[aria-current='page'] { background: rgb(146 186 190 / 0.14); box-shadow: inset 0 0 0 1.5px #E7E7E7; }
</style>
