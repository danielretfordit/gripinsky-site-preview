---
interface Stat { value: string; label: string; href?: string | null }
interface Props { stats: Stat[] }
const { stats } = Astro.props;
---
<section class="wrap stats-ribbon" aria-label="Академия в цифрах">
  <dl class="stats-ribbon__grid">
    {stats.map((stat) => (
      <div class="stats-ribbon__item">
        <dt>{stat.label}</dt>
        <dd>
          {stat.href
            ? <a href={stat.href} rel="noopener" aria-label={`${stat.value}, ${stat.label}`}>{stat.value}</a>
            : stat.value}
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .stats-ribbon { padding-top: 8px; }
  .stats-ribbon__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .stats-ribbon__item {
    display: flex;
    min-width: 0;
    min-height: 104px;
    flex-direction: column-reverse;
    justify-content: center;
    gap: 4px;
    padding: 16px 12px 16px 0;
  }
  .stats-ribbon__item:nth-child(odd) { border-right: 1px solid var(--color-line); }
  .stats-ribbon__item:nth-child(even) { padding-left: 16px; }
  .stats-ribbon__item:last-child {
    grid-column: 1 / -1;
    min-height: 76px;
    flex-direction: row;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
    border-top: 1px solid var(--color-line);
    border-right: 0;
    padding: 12px 0;
  }
  .stats-ribbon__item dt {
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.35;
  }
  .stats-ribbon__item dd {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(25px, 3vw, 42px);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
  }
  .stats-ribbon__item a {
    color: inherit;
    text-decoration: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .stats-ribbon__item a:hover { text-decoration: underline; }
  @media (min-width: 768px) {
    .stats-ribbon { padding-top: 12px; }
    .stats-ribbon__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .stats-ribbon__item,
    .stats-ribbon__item:last-child {
      min-height: 128px;
      flex-direction: column-reverse;
      align-items: flex-start;
      justify-content: center;
      gap: 8px;
      border-top: 0;
      border-right: 1px solid var(--color-line);
      padding: 20px 20px 20px 0;
    }
    .stats-ribbon__item + .stats-ribbon__item { padding-left: 20px; }
    .stats-ribbon__item:last-child { grid-column: auto; border-right: 0; }
    .stats-ribbon__item dt { font-size: 14px; }
    .stats-ribbon__item dd { font-size: clamp(26px, 2.5vw, 42px); }
  }
</style>
