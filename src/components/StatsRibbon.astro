---
interface Stat { value: string; label: string; href?: string | null }
interface Props { stats: Stat[] }
const { stats } = Astro.props;
// «10 000+»: плюс выделяется лаймом
const split = (v: string) => (v.endsWith('+') ? [v.slice(0, -1), '+'] : [v, '']);
---
<section class="wrap stats-ribbon" aria-label="Академия в цифрах">
  <dl class="stats-ribbon__list" tabindex="0" aria-label="Пять показателей академии; на узком экране листайте горизонтально">
    {stats.map((stat, index) => (
      <div class="stats-ribbon__item">
        <span class="stats-ribbon__index" aria-hidden="true">0{index + 1}</span>
        <dt>{stat.label}</dt>
        <dd>
          {stat.href
            ? <a href={stat.href} rel="noopener" aria-label={`${stat.value}, ${stat.label}`}>{split(stat.value)[0]}{split(stat.value)[1] && <span class="num-plus">+</span>}</a>
            : <>{split(stat.value)[0]}{split(stat.value)[1] && <span class="num-plus">+</span>}</>}
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .stats-ribbon { padding-top: 20px; }
  .stats-ribbon__list {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(20px, 3vw, 48px);
    margin: 0;
    padding: 0 0 16px;
    background: linear-gradient(to right, var(--color-lime) 0 20px, var(--color-line-strong) 20px 100%) left bottom / 100% 1px no-repeat;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }
  .stats-ribbon__list::-webkit-scrollbar { display: none; }
  .stats-ribbon__item {
    display: flex;
    flex: 0 0 auto;
    min-width: 0;
    flex-direction: column-reverse;
    gap: 7px;
    scroll-snap-align: start;
  }
  .stats-ribbon__item dt {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: var(--type-small);
    line-height: 1.35;
  }
  .stats-ribbon__index { display: none; }
  .stats-ribbon__item dd {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--type-stat);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }
  .stats-ribbon__item a {
    display: inline-flex;
    align-items: center;
    min-width: var(--tap);
    min-height: var(--tap);
    margin-block: -7px;
    color: inherit;
    text-decoration: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  @media (hover: hover) { .stats-ribbon__item a:hover { text-decoration: underline; } }
  @media (max-width: 767px) {
    .stats-ribbon { padding-top: 16px; }
    .stats-ribbon__list { gap: 28px; }
    .stats-ribbon__item { min-width: 142px; }
  }
  @media (max-width: 560px) {
    .stats-ribbon__item dt { font-size: var(--type-meta); }
  }
</style>
