---
// Первый экран: работа ученика на всю ширину, заголовок поверх неё, сверху «метаданные рендера»
import { Image } from 'astro:assets';
import { workCaption } from '../lib/works';
import type { HeroSlide } from '../lib/hero';

interface Props { work: HeroSlide; slides?: HeroSlide[]; kicker: string; id: string; class?: string }
const { work, slides = [work], kicker, id, class: cls = '' } = Astro.props;
const carousel = slides.length > 1;
// Кинематографичный первый экран: кадр на всю ширину, нужны крупные версии картинки
const cinema = cls.includes('hero--cinema');
const count = String(slides.length).padStart(2, '0');
---
<section class={`hero ${cls}`} aria-labelledby={id} data-hero-carousel={carousel ? 'true' : undefined}>
  <div class="hero__copy">
    {Astro.slots.has('top') && <div class="hero__top"><slot name="top" /></div>}
    <p class="t-overline m-0 !text-ink/80">{kicker}</p>
    <slot name="title" />
    <div class="hero__row">
      <slot name="lead" />
      <div class="hero__cta"><slot name="cta" /></div>
    </div>
  </div>
  <div class="hero__visual">
    <div class="hero__signature">
      <span>АКАДЕМИЯ 3D GRIPINSKY</span>
      {carousel && <span data-hero-count aria-live="off">01 / {count}</span>}
    </div>
    <div class="hero__image" role={carousel ? 'group' : undefined} aria-roledescription={carousel ? 'карусель' : undefined} aria-label={carousel ? 'Работы учеников' : undefined}>
      {slides.map((slide, index) => (
        <figure class="hero__slide" data-hero-slide data-active={index === 0 ? 'true' : undefined} aria-hidden={index === 0 ? undefined : 'true'}>
          <Image src={slide.image} alt={slide.alt} class="hero__img" style={`--hero-focus:${slide.focus};--hero-mobile-focus:${slide.mobileFocus ?? slide.focus}`}
            widths={cinema ? [960, 1440, 1920, 2400] : [640, 960, 1280, 1600]} sizes={cinema ? "100vw" : "(min-width: 1024px) 40vw, 100vw"} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} />
          <figcaption><span>{slide.label ?? 'Работа ученика'}</span>{slide.captionOverride ?? workCaption(slide)}</figcaption>
        </figure>
      ))}
      {carousel && (
        <div class="hero__controls" aria-label="Переключить работу">
          <button type="button" data-hero-prev aria-label="Предыдущая работа"><span aria-hidden="true">←</span></button>
          <button type="button" data-hero-next aria-label="Следующая работа"><span aria-hidden="true">→</span></button>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* Выбранный вариант 03: текстовая панель слева, работа ученика справа (от 1024 px); ниже работа идёт под текстом.
     Кегль заголовка берётся из общей плавной роли --type-hero, высоты привязаны к ширине, а не к точкам перелома. */
  .hero { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr); overflow: hidden; background: radial-gradient(50% 60% at 18% 45%, rgb(241 241 235 / .05), transparent 70%), var(--color-bg); }
  .hero__copy { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(32px, 6vw, 56px) var(--site-gutter) 0; }
  /* Хлебные крошки отделены от надзаголовка: иначе «…/ 3D-визуализация» и «Направление» читаются одной строкой */
  .hero__top { margin-bottom: clamp(20px, 3vw, 36px); }
  .hero__visual { display: flex; min-width: 0; min-height: 0; flex-direction: column; }
  .hero :global(.t-hero) { max-width: 16ch; margin: 22px 0 16px; font-size: var(--type-hero); line-height: 1.02; letter-spacing: -.038em; }
  /* Длинный заголовок направления: в две колонки чуть мельче, чтобы уложиться в четыре строки */
  @media (min-width: 1024px) { .hero :global(.t-hero--long) { font-size: min(var(--type-hero), 3.375rem); } }
  .hero :global(.t-lead) { max-width: 570px; color: var(--color-ink-2); font-size: var(--type-lead); line-height: 1.55; }
  .hero :global(.hero__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--hero-mobile-focus, var(--hero-focus, 50% 50%)); }
  .hero__image { position: relative; flex: 0 0 auto; min-width: 0; margin: 0 var(--site-gutter); aspect-ratio: 4 / 3; max-height: min(520px, 64svh); overflow: hidden; background: var(--color-surface); touch-action: pan-y; }
  .hero__slide { position: absolute; inset: 0; margin: 0; opacity: 0; visibility: hidden; transition: opacity .6s var(--ease-out), visibility .6s; }
  .hero__slide[data-active] { opacity: 1; visibility: visible; }
  .hero__slide[aria-hidden="true"] { pointer-events: none; }
  .hero__image::after { position: absolute; inset: 45% 0 0; background: linear-gradient(transparent, rgb(8 10 10 / .8)); content: ""; pointer-events: none; }
  .hero__image figcaption { position: absolute; z-index: 1; right: 116px; bottom: 16px; left: 16px; display: flex; flex-direction: column; gap: 4px; color: var(--color-ink); font-size: var(--type-small); line-height: 1.4; }
  .hero__image figcaption span { color: rgb(255 255 255 / .72); font-size: var(--type-label); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .hero__controls { position: absolute; z-index: 2; right: 14px; bottom: 14px; display: flex; gap: 6px; }
  .hero__controls button { display: grid; width: var(--tap); height: var(--tap); place-items: center; border: 1px solid rgb(241 241 235 / .64); border-radius: var(--radius-field); background: rgb(17 19 19 / .32); color: var(--color-ink); font-size: var(--type-icon); line-height: 1; transition: color var(--dur) ease, border-color var(--dur) ease, background var(--dur) ease; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .hero__controls button:focus-visible { border-color: var(--color-lime); background: rgb(17 19 19 / .78); color: var(--color-lime); }
  .hero__controls button:active { background: rgb(17 19 19 / .78); }
  @media (hover: hover) { .hero__controls button:hover { border-color: var(--color-lime); background: rgb(17 19 19 / .78); color: var(--color-lime); } }
  .hero__row { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(18px, 2.4vw, 28px); }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .hero__signature { display: flex; flex: 0 0 auto; align-items: center; justify-content: space-between; gap: 20px; box-sizing: border-box; margin: 30px var(--site-gutter) 24px; padding: 13px 0 0; border-top: 1px solid var(--color-line); color: var(--color-muted); font: var(--type-meta) var(--font-mono), monospace; letter-spacing: .09em; }
  /* Телефон: кнопки первого экрана столбцом, ширина по подписи */
  @media (max-width: 559.98px) {
    .hero :global(.t-lead) { font-size: var(--type-body); }
    .hero__cta { align-items: stretch; flex-direction: column; width: 100%; min-width: 0; }
    .hero :global(.hero__cta > *) { width: 100%; }
  }
  /* Широкий экран: две колонки 3:2, кадр на всю высоту первого экрана */
  @media (min-width: 1024px) {
    .hero { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); min-height: clamp(570px, 48vw, 760px); padding-top: var(--header-h); }
    .hero__copy { padding: clamp(48px, 7vw, 104px) clamp(32px, 5vw, 76px) 54px var(--site-gutter); }
    .hero :global(.t-hero) { max-width: 750px; }
    .hero :global(.hero__img) { object-position: var(--hero-focus, 50% 50%); }
    /* Кадр выровнен по правому полю контейнера, как текст по левому: без «приклеивания» к краю экрана */
    .hero__visual { height: clamp(570px, 48vw, 760px); padding-right: var(--site-gutter); }
    .hero__signature { margin: 0; padding: 13px clamp(16px, 2vw, 24px); }
    .hero__image { flex: 1 1 auto; margin: 0; aspect-ratio: auto; max-height: none; }
    .hero__image figcaption { right: 120px; bottom: 23px; left: 24px; }
    .hero__controls { right: 20px; bottom: calc(var(--sticky-bar-h, 0px) + 20px); }
  }
  /* Широкий экран: работа ученика почти на половину ширины, она главная картинка страницы */
  @media (min-width: 1280px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); }
    .hero__copy { padding-right: clamp(40px, 4vw, 72px); }
  }
  /* Кинематографичный вариант (главная, правки 10.10.2026): работа ученика на весь первый экран,
     заголовок и кнопки поверх затемнённой левой части кадра, подпись и стрелки справа внизу */
  @media (max-width: 1023.98px) {
    .hero--cinema .hero__image { margin-inline: 0; aspect-ratio: 4 / 3.4; }
    .hero--cinema .hero__signature { margin-bottom: 14px; }
  }
  @media (min-width: 1024px) {
    /* Высота: экран минус шапка (кадр начинается под ней), чтобы кнопки всегда были видны без прокрутки */
    .hero--cinema { grid-template-columns: minmax(0, 1fr); min-height: clamp(560px, calc(100svh - var(--header-h)), 900px); padding-top: 0; background: var(--color-bg); }
    .hero--cinema .hero__visual { position: absolute; inset: 0; z-index: 0; height: auto; padding: 0; }
    .hero--cinema .hero__image { position: absolute; inset: 0; }
    .hero--cinema .hero__image::after { inset: 0; background: linear-gradient(90deg, rgb(10 12 12 / .9) 0%, rgb(10 12 12 / .62) 34%, rgb(10 12 12 / .08) 66%, transparent 100%), linear-gradient(0deg, rgb(10 12 12 / .85) 0%, transparent 42%); }
    .hero--cinema .hero__signature { position: absolute; top: 28px; right: var(--site-gutter); left: var(--site-gutter); z-index: 2; padding: 0; border-top: 0; color: rgb(241 241 235 / .82); text-shadow: 0 1px 12px rgb(0 0 0 / .45); }
    .hero--cinema .hero__copy { position: relative; z-index: 1; justify-content: flex-end; max-width: calc(820px + var(--site-gutter)); min-height: inherit; padding: clamp(72px, 9vh, 120px) clamp(32px, 4vw, 64px) clamp(48px, 6vw, 88px) var(--site-gutter); }
    .hero--cinema :global(.t-hero) { max-width: 820px; font-size: clamp(3.5rem, 1.6rem + 3.4vw, 5.75rem); text-shadow: 0 2px 30px rgb(0 0 0 / .35); }
    .hero--cinema :global(.t-lead) { color: rgb(241 241 235 / .86); }
    .hero--cinema .hero__image figcaption { right: calc(var(--site-gutter) + 120px); bottom: clamp(48px, 6vw, 88px); left: auto; max-width: 360px; align-items: flex-end; text-align: right; }
    .hero--cinema .hero__controls { right: var(--site-gutter); bottom: calc(clamp(48px, 6vw, 88px) - 4px); }
  }

  /* Смена кадра: лёгкое приближение вместе с проявлением */
  .hero__slide :global(.hero__img) { transform: scale(1.025); transition: transform 6s var(--ease-out); }
  .hero__slide[data-active] :global(.hero__img) { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) { .hero__slide, .hero__controls button, .hero__slide :global(.hero__img) { transition: none; transform: none; } }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-hero-carousel="true"]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const count = carousel.querySelector<HTMLElement>('[data-hero-count]');
    const previous = carousel.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-hero-next]');
    const image = carousel.querySelector<HTMLElement>('.hero__image');
    if (slides.length < 2 || !count || !previous || !next || !image) return;

    let activeIndex = 0;
    let timer: number | undefined;
    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const show = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.toggleAttribute('data-active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
      });
      count.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
    };
    let inViewport = true;
    const start = () => {
      stop();
      if (reducedMotion.matches || document.hidden || !inViewport) return;
      timer = window.setInterval(() => show(activeIndex + 1), 4800);
    };

    previous.addEventListener('click', () => { show(activeIndex - 1); start(); });
    next.addEventListener('click', () => { show(activeIndex + 1); start(); });
    let touchStart: { x: number; y: number } | undefined;
    image.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' || (event.target as HTMLElement).closest('button')) return;
      touchStart = { x: event.clientX, y: event.clientY };
    });
    image.addEventListener('pointerup', (event) => {
      if (!touchStart) return;
      const deltaX = event.clientX - touchStart.x;
      const deltaY = event.clientY - touchStart.y;
      touchStart = undefined;
      if (Math.abs(deltaX) < 48 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
      show(activeIndex + (deltaX < 0 ? 1 : -1));
      start();
    });
    image.addEventListener('pointercancel', () => { touchStart = undefined; });
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });
    new IntersectionObserver(([entry]) => { inViewport = entry.isIntersecting; if (inViewport) start(); else stop(); }).observe(carousel);
    reducedMotion.addEventListener('change', start);
    start();
  });
</script>
