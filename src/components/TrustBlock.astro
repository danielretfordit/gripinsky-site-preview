---
import WhyGripinsky from './WhyGripinsky.astro';
import FounderFeature from './FounderFeature.astro';
import { getCollection } from 'astro:content';
import { personMap } from '../lib/people';
const people = await personMap();
const collection = await getCollection('reviews', r => !r.data.person || people.has(r.data.person.id));
const reviews = ['import-358432c2ea002ddd', 'import-50d9ba80d3a63d36', 'import-fb4c17a43c5fcd68'].map(id => collection.find(r => r.id === id)).filter(Boolean);
---
<div class:list={['trust','trust--journal']}>
 <div class="trust-top"><span class="t-overline">GRIPINSKY / Подход к обучению</span><span class="t-meta">Метод / Основатель / Опыт учеников</span></div>
 <div class="trust-body"><div class="method"><span class="chapter t-overline">01 / Во что мы верим</span><WhyGripinsky/></div><div class="person"><span class="chapter t-overline">02 / Кто за этим стоит</span><FounderFeature refined/></div></div>
 <section id="reviews" class="voices" aria-labelledby="voices-title"><div class="voices-head"><div><p class="t-overline">03 / Подтверждают ученики и заказчики</p><h2 id="voices-title" class="t-h2">Подход виден<br/><span class="text-heading-muted">в их опыте.</span></h2></div><a href="/otzyvy" class="link t-small">Все отзывы →</a></div><div class="review-grid">{reviews.map(r=><figure><blockquote class="t-body">«{r!.data.quote ?? r!.data.text}»</blockquote><figcaption class="t-small"><b>{r!.data.author}</b><span class="text-muted">{r!.data.role}</span></figcaption><a class="link t-small" href="/otzyvy#quotes">Читать отзывы →</a></figure>)}</div></section>
</div>
<style>
.trust :global(#founder .founder__eyebrow){display:block}.trust :global(#founder .founder__copy > h2){font-size:var(--type-section);line-height:1.03;margin:0 0 24px;letter-spacing:-.06em}.trust :global(#founder .founder__quote){line-height:1.5}

.concept-head{padding-top:24px;padding-bottom:40px}.concept-head>p{max-width:800px}.variants{display:flex;flex-wrap:wrap;gap:12px;margin:24px 0}.selected{border-color:var(--color-ink);background:var(--color-surface)}.trust{max-width:1360px;margin:0 auto 80px;padding:40px;background:var(--color-surface);border-top:1px solid var(--color-line-strong)}.trust-top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;padding-bottom:28px;border-bottom:1px solid var(--color-line)}.chapter{display:none}.method :global(.why-gripinsky){width:100%;margin:40px 0 0;padding:0;border:0;gap:40px}.person :global(.founder){width:100%;margin-top:48px;padding:0}.person :global(.founder__copy){padding:32px 32px 32px 0}.voices{margin-top:48px;padding-top:32px;border-top:1px solid var(--color-line)}.voices-head{display:flex;align-items:end;justify-content:space-between;gap:24px}.voices-head h2{margin:18px 0 0}.review-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin-top:32px}.review-grid figure{margin:0;border-top:1px solid var(--color-line);padding-top:20px;display:flex;flex-direction:column}.review-grid blockquote{margin:0 0 24px;color:var(--color-ink-2)}.review-grid figcaption{margin-top:auto;display:flex;flex-direction:column;gap:6px}.trust--journal .method :global(.why-gripinsky){grid-template-columns:1fr 2fr}.trust--journal .method :global(ol){display:grid;grid-template-columns:1fr 1fr;gap:0 28px}.trust--journal .person :global(.founder__composition){grid-template-columns:1fr 1fr}.trust--journal .person :global(.founder__portrait){height:530px;min-height:0}.trust--portrait .trust-body{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px}.trust--portrait .method{grid-column:2;grid-row:1}.trust--portrait .person{grid-column:1;grid-row:1}.trust--portrait .method :global(.why-gripinsky){display:block}.trust--portrait .method :global(ol){margin-top:24px}.trust--portrait .person :global(.founder){margin-top:40px}.trust--portrait .person :global(.founder__composition){display:flex;flex-direction:column-reverse;border:0}.trust--portrait .person :global(.founder__portrait){height:380px;min-height:0}.trust--portrait .person :global(.founder__portrait img){width:100%;height:100%;object-fit:cover;object-position:50% 22%}.trust--portrait .person :global(.founder__copy){min-height:0;padding:32px 0}.trust--chapters{background:var(--color-bg);padding-inline:0}.trust--chapters .chapter{display:block;margin-top:40px}.trust--chapters .method :global(.why-gripinsky){margin-top:20px}.trust--chapters .person{border-top:1px solid var(--color-line);margin-top:40px}.trust--chapters .person :global(.founder){margin-top:20px}.trust--chapters .method :global(ol){display:grid;grid-template-columns:1fr 1fr;gap:0 28px}
@media(max-width:1439px){.trust{margin-inline:24px}.trust--chapters{padding-inline:16px}}
@media(max-width:1023px){.trust{padding:28px}.trust--journal .method :global(.why-gripinsky){grid-template-columns:1fr}.trust--portrait .trust-body{gap:28px}.trust--chapters .method :global(.why-gripinsky){grid-template-columns:1fr}.review-grid{gap:20px}}
@media(max-width:767px){.trust{margin-inline:20px;padding:24px}.trust--chapters{padding-inline:0}.trust-body,.trust--portrait .trust-body{display:block}.trust--journal .method :global(ol),.trust--chapters .method :global(ol){display:block}.method :global(.why-gripinsky){grid-template-columns:1fr;gap:24px}.person :global(.founder__composition),.trust--journal .person :global(.founder__composition){grid-template-columns:1fr}.person :global(.founder__copy){padding:24px 0;min-height:0}.review-grid{grid-template-columns:1fr;gap:28px}.voices-head{display:block}.voices-head>a{display:inline-block;margin-top:20px}.trust-top>span:last-child{display:none}.trust--portrait .person :global(.founder__portrait){height:320px}.trust--journal .person :global(.founder__portrait){height:370px}}
</style>
