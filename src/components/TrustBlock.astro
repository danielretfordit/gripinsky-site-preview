---
import WhyGripinsky from './WhyGripinsky.astro';
import FounderFeature from './FounderFeature.astro';
import { getCollection } from 'astro:content';
import { personMap } from '../lib/people';
const people = await personMap();
const collection = await getCollection('reviews', r => !r.data.person || people.has(r.data.person.id));
// Отзывы выбираются в админке («Главная страница»)
const { reviewIds = ['import-358432c2ea002ddd', 'import-50d9ba80d3a63d36', 'import-fb4c17a43c5fcd68'] } = Astro.props as { reviewIds?: string[] };
const reviews = reviewIds.map(id => collection.find(r => r.id === id)).filter(Boolean);
---
<div class:list={['trust','trust--journal']}>
 <div class="trust-top"><span class="t-overline">GRIPINSKY / Подход к обучению</span><span class="t-meta">Метод / Основатель / Опыт учеников</span></div>
 <div class="trust-body"><div class="method"><span class="chapter t-overline">01 / Во что мы верим</span><WhyGripinsky/></div><div class="person"><span class="chapter t-overline">02 / Кто за этим стоит</span><FounderFeature/></div></div>
 <section id="reviews" class="voices" aria-labelledby="voices-title"><div class="voices-head"><div><p class="t-overline">03 / Подтверждают ученики и заказчики</p><h2 id="voices-title" class="t-h2">Подход виден<br/><span class="text-heading-muted">в их опыте.</span></h2></div><a href="/otzyvy" class="link t-small">Все отзывы →</a></div><div class="review-grid">{reviews.map(r=><figure><blockquote class="t-body">«{r!.data.quote ?? r!.data.text}»</blockquote><figcaption class="t-small"><b>{r!.data.author}</b><span class="text-muted">{r!.data.role}</span></figcaption></figure>)}</div></section>
</div>
<style>
/* Блок доверия главной: метод, основатель, отзывы. Один вариант «журнал» (выбран 08.10.2026). */
.trust{--trust-pad:clamp(24px, 3vw, 40px);position:relative;overflow:hidden;width:min(100% - 2 * var(--gutter), var(--container));box-sizing:border-box;margin:var(--space-section) auto 0;padding:var(--trust-pad);background:var(--glow-studio),var(--color-surface);border-top:1px solid var(--color-line-strong)}
.trust-top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;padding-bottom:28px;border-bottom:1px solid var(--color-line)}
.chapter{display:none}
.method :global(.why-gripinsky){width:100%;margin:40px 0 0;padding:0;border:0;gap:clamp(24px, 3vw, 40px);grid-template-columns:1fr}
.method :global(ol){display:block}
.person{margin-top:clamp(40px, 5vw, 64px)}
.voices{margin-top:48px;padding-top:32px;border-top:1px solid var(--color-line)}
.voices-head{display:block}
.voices-head>a{display:inline-flex;align-items:center;min-height:var(--tap);margin-top:12px}
.voices-head h2{margin:18px 0 0}
.review-grid{display:grid;grid-template-columns:1fr;gap:28px;margin-top:32px}
.review-grid figure{margin:0;border-top:1px solid var(--color-line);padding-top:20px;display:flex;flex-direction:column}
.review-grid blockquote{margin:0 0 20px;color:var(--color-ink-2)}
.review-grid figcaption{display:flex;flex-direction:column;gap:6px}
.trust-top>span:last-child{display:none}
@media(min-width:768px){
  .trust-top>span:last-child{display:inline}
  .method :global(.why-gripinsky){grid-template-columns:1fr 2fr}
  .voices-head{display:flex;align-items:end;justify-content:space-between;gap:24px}
  .voices-head>a{margin-top:0}
  .review-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(20px, 2.4vw, 32px)}
}
@media(min-width:768px){
  /* Заголовок метода остаётся на виду, пока читаются шесть пунктов */
  .method :global(.why-gripinsky__heading){position:sticky;top:calc(var(--header-h) + 24px);align-self:start}
}
@media(min-width:1024px){
  .method :global(ol){display:grid;grid-template-columns:1fr 1fr;gap:0 28px}
  .method :global(li:nth-child(2)){padding-top:0}
}
</style>
