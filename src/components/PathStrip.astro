---
// Полоса под первым экраном: три шага пути с ценами «от …» и короткие цифры школы.
// Активный шаг отмечен лаймовой линией сверху (единственный лайм в полосе)
interface Step { n: string; title: string; sub: string; price: string; href: string }
interface Stat { value: string; label: string; href?: string }
interface Props { label: string; steps: Step[]; stats: Stat[]; active?: number; class?: string }
const { label, steps, stats, active = 0, class: cls = '' } = Astro.props;
---
<section class={`wrap strip ${cls}`} aria-label={label}>
  <div class="strip__head">
    <p class="t-overline t-signal m-0">{label}</p>
    <dl class="strip__stats">
      {stats.map((s) => (
        <div><dt>{s.href ? <a href={s.href} rel="noopener" class="hover:text-ink">{s.label}</a> : s.label}</dt><dd>{s.value}</dd></div>
      ))}
    </dl>
  </div>
  <ol class="strip__list">
    {steps.map((st, i) => (
      <li class={i === active ? 'is-active' : ''}>
        <a href={st.href}>
          <span class="strip__n t-mono" aria-hidden="true">{st.n}</span>
          <span class="strip__t"><b>{st.title}</b><small>{st.sub}</small></span>
          <span class="strip__p">{st.price}</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .strip { padding-top: 40px; }
  @media (min-width: 1024px) { .strip { padding-top: 56px; } }
  .strip__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 32px; margin-bottom: 20px; }
  .strip__stats { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 6px 24px; margin: 0; width: 100%; }
  .strip__stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 2px; }
  @media (min-width: 768px) {
    .strip__stats { display: flex; flex-wrap: wrap; gap: 6px 28px; width: auto; }
    .strip__stats div { flex-direction: row-reverse; align-items: baseline; gap: 8px; }
  }
  .strip__stats dd { margin: 0; font-weight: 700; color: var(--color-ink); }
  .strip__stats dt { font-size: 14px; line-height: 1.3; color: var(--color-muted); }
  .strip__stats a { color: inherit; }
  .strip__list { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--color-line); }
  @media (min-width: 1280px) { .strip__list { grid-template-columns: repeat(3, 1fr); } }
  .strip__list li { position: relative; border-bottom: 1px solid var(--color-line); }
  @media (min-width: 1280px) { .strip__list li { border-bottom: 0; } .strip__list li + li { border-left: 1px solid var(--color-line); } }
  .strip__list li.is-active::before { content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--color-lime); }
  .strip__list a { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; padding: 20px 4px; color: var(--color-ink); transition: background-color .2s ease; }
  @media (min-width: 1280px) { .strip__list a { padding: 28px 28px 28px 0; } .strip__list li + li a { padding-left: 28px; } }
  .strip__list a:hover { background: rgb(236 236 230 / 0.04); }
  .strip__n { font-size: 13px; color: var(--color-muted); }
  .strip__t { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .strip__t b { font-size: 20px; font-weight: 750; line-height: 1.1; letter-spacing: -0.01em; text-transform: uppercase; }
  .strip__t small { font-size: 14px; line-height: 1.35; color: var(--color-muted); }
  .strip__p { font-size: 18px; font-weight: 700; white-space: nowrap; }
</style>
