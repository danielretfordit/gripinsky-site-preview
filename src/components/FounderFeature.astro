---
const { refined = false } = Astro.props;
import { assetPath } from '../lib/deployment';
const portrait = assetPath('/images/evgeny-gripinsky-color.webp');
---

<section id="founder" class:list={["wrap section founder-manifesto founder", refined && "founder--refined"]} aria-labelledby="founder-title">
  <div class="founder__composition">
    <div class="founder__copy">
      <p class="founder__eyebrow">Основатель академии</p>
      <h2 id="founder-title">Евгений <span>Грипинский</span></h2>
      <p class="founder__lead">20 лет назад Евгений создал обучающую систему, в основе которой системный подход к знаниям, высокие стандарты качества и адресная поддержка каждого студента.</p>
      <blockquote class="founder__quote">
        <svg viewBox="0 0 40 32" aria-hidden="true"><path d="M6 25c3-9 6-14 11-18M21 25c3-9 6-14 11-18" /></svg>
        <span>«Основная цель занятий — научить вас <strong>думать</strong>, а не повторять действия»</span>
      </blockquote>
      <a class="founder__link" href="/teachers">Все педагоги <span aria-hidden="true">↗</span></a>
    </div>
    <div class="founder__portrait"><img src={portrait} alt="Евгений Грипинский" width="764" height="1036" loading="lazy" decoding="async" /></div>
  </div>
</section>

<style>
  .founder--refined .founder__lead { font-size: var(--type-body); max-width: 48ch; }
  .founder--refined .founder__quote { display: block; border: 0; padding: 24px 0 0; margin: 24px 0 0; border-top: 1px solid var(--color-line); font-size: var(--type-lead); font-weight: 500; line-height: 1.5; }
  .founder--refined .founder__quote svg { display: none; }
  .founder--refined .founder__quote strong { color: inherit; font-weight: inherit; text-decoration: none; }
  .founder--refined .founder__link { min-width: 0; min-height: 44px; padding: 0; border: 0; border-bottom: 1px solid var(--color-line-strong); font-size: var(--type-small); gap: 40px; margin-top: 24px; }
  .founder--refined .founder__link span { color: inherit; }
  .founder--refined .founder__link:hover, .founder--refined .founder__link:focus-visible { color: var(--color-lime); background: transparent; border-color: var(--color-lime); }
  .founder-manifesto { position: relative; }
  .founder__composition {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(280px, .8fr);
    align-items: stretch;
    min-height: 530px;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: transparent;
  }
  .founder__copy {
    display: flex;
    min-width: 0;
    min-height: 530px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 40px clamp(28px, 4vw, 56px) 40px 0;
  }
  .founder__eyebrow {
    margin: 0 0 16px;
    color: var(--color-muted);
    font: var(--type-meta) var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .founder h2 {
    max-width: 760px;
    margin: 0 0 22px;
    color: var(--color-ink);
    font-size: clamp(54px, 5.6vw, 74px);
    font-weight: 720;
    line-height: .94;
    letter-spacing: -.06em;
    text-transform: uppercase;
  }
  .founder h2 span { display: block; color: var(--color-muted); }
  .founder__lead { max-width: 650px; margin: 0; color: var(--color-ink-2); font-size: var(--type-lead); line-height: 1.55; }
  .founder__quote {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: start;
    gap: 13px;
    max-width: 650px;
    margin: 28px 0 0;
    padding: 0 0 0 17px;
    border-left: 2px solid var(--color-lime);
    color: var(--color-ink);
    font-size: var(--type-lead);
    font-weight: 600;
    line-height: 1.55;
  }
  .founder__quote svg { width: 26px; height: 23px; margin-top: 3px; overflow: visible; fill: none; stroke: var(--color-lime); stroke-width: 2; stroke-linecap: round; }
  .founder__quote strong { color: var(--color-lime); font-weight: 750; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .founder__link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-width: 235px;
    min-height: 48px;
    margin-top: 25px;
    padding: 0 16px;
    border: 1px solid var(--color-lime);
    color: var(--color-ink);
    font-size: var(--type-lead);
    font-weight: 600;
    text-decoration: none;
    transition: background .18s ease, color .18s ease;
  }
  .founder__link:hover, .founder__link:focus-visible { color: var(--color-bg); background: var(--color-lime); }
  .founder__link span { color: var(--color-lime); transition: transform .18s ease; }
  .founder__link:hover span, .founder__link:focus-visible span { color: currentColor; transform: translate(3px, -3px); }
  .founder__portrait { position: relative; min-width: 0; min-height: 530px; overflow: hidden; background: transparent; }
  .founder__portrait::after { position: absolute; inset: 0; background: linear-gradient(0deg, rgb(17 19 19 / .2), rgb(17 19 19 / .2)); content: ''; pointer-events: none; }
  .founder__portrait img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 16%; filter: brightness(.8) saturate(.88); }
  @media (max-width: 820px) {
    .founder__composition { grid-template-columns: 1fr; }
    .founder__copy { min-height: 0; padding: 34px 0 28px; }
    .founder__portrait { min-height: 0; height: clamp(300px, 55vw, 440px); }
  }
  @media (max-width: 560px) {
    .founder h2 { font-size: clamp(50px, 12vw, 72px); }
    .founder__quote { grid-template-columns: 26px minmax(0, 1fr); gap: 9px; font-size: var(--type-body); }
    .founder__quote svg { width: 21px; }
    .founder__portrait { height: 370px; }
  }
</style>
