---
// Основатель академии (главная, внутри TrustBlock): имя со второй строкой серебром, цитата с лаймовой чертой,
// цифры и фото без рамки. По правкам заказчицы 10.10.2026 без полосы работ, боковой колонки и выделенного слова.
import { getEntry } from 'astro:content';
import { assetPath } from '../lib/deployment';

const portrait = assetPath('/images/evgeny-gripinsky-color.webp');
const site = (await getEntry('settings', 'site'))!.data;
const home = (await getEntry('home', 'main'))!.data;
const facts = [
  { value: site.stats.years, label: home.statLabels.years },
  { value: site.stats.graduates, label: home.statLabels.graduates },
  { value: 'Автор методики', label: 'системный подход GRIPINSKY' },
];
---

<section id="founder" class="founder" aria-labelledby="founder-title">
  <div class="founder__composition">
    <div class="founder__copy">
      <p class="founder__eyebrow t-overline">Основатель академии</p>
      <h2 id="founder-title">Евгений <span>Грипинский</span></h2>
      <p class="founder__lead">20 лет назад Евгений создал обучающую систему, в основе которой системный подход к знаниям, высокие стандарты качества и адресная поддержка каждого студента.</p>
      <blockquote class="quote quote--signal founder__quote">
        <p>«Основная цель занятий — научить вас думать, а не повторять действия»</p>
      </blockquote>
      <dl class="facts founder__facts">
        {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value.endsWith('+') ? <>{f.value.slice(0, -1)}<span class="num-plus">+</span></> : f.value}</dd></div>)}
      </dl>
      <a class="btn btn-signal founder__link" href="/teachers">Все педагоги <span class="arrow-long" aria-hidden="true"></span></a>
    </div>
    <div class="founder__portrait"><img src={portrait} alt="Евгений Грипинский" width="764" height="1036" loading="lazy" decoding="async" /></div>
  </div>
</section>

<style>
  .founder { position: relative; }

  .founder__composition { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); }
  .founder__copy { position: relative; z-index: 1; display: flex; min-width: 0; flex-direction: column; align-items: flex-start; padding: clamp(32px, 4vw, 56px) 0 0; }
  .founder__eyebrow { margin: 0 0 18px; }
  .founder h2 { max-width: 760px; margin: 0 0 24px; color: var(--color-ink); font-size: clamp(2.75rem, 1.6rem + 4.6vw, 5.5rem); font-weight: 800; line-height: .94; letter-spacing: -.038em; text-transform: uppercase; }
  .founder h2 span { display: block; }
  /* Мягкий свет за спиной: блок не плоский */
  .founder__composition::before { position: absolute; inset: 0 0 0 30%; background: var(--glow-studio); content: ""; pointer-events: none; }
  .founder__lead { max-width: 52ch; margin: 0; color: var(--color-ink-2); font-size: var(--type-lead); line-height: 1.55; text-wrap: pretty; }

  .founder__quote { max-width: 600px; margin-top: clamp(26px, 3vw, 36px); }
  .founder__facts { width: 100%; max-width: 640px; margin-top: clamp(28px, 3.4vw, 44px); grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .founder__facts > div:last-child dd { font-size: var(--type-title); line-height: 1.2; text-transform: uppercase; letter-spacing: -.01em; }
  .founder__link { margin-top: clamp(28px, 3.4vw, 40px); }

  /* Фото без рамки: растворяется в фоне блока, сзади мягкий студийный свет */
  .founder__portrait { position: relative; min-width: 0; aspect-ratio: 4 / 5; max-height: 560px; margin-top: 32px; overflow: hidden; }
  .founder__portrait::before { position: absolute; inset: 10% 5% 0; background: radial-gradient(closest-side, rgb(236 236 230 / .14), transparent); content: ""; }
  .founder__portrait img { position: relative; display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 14%; -webkit-mask-image: linear-gradient(180deg, black 72%, transparent); mask-image: linear-gradient(180deg, black 72%, transparent); }

  @media (min-width: 768px) {
    .founder__composition { grid-template-columns: minmax(0, 1.25fr) minmax(0, .9fr); align-items: stretch; }
    .founder__copy { padding-bottom: clamp(32px, 4vw, 56px); }
    .founder__portrait { aspect-ratio: auto; max-height: none; margin: 0 calc(-1 * var(--trust-pad, 0px)) 0 0; }
    .founder__portrait img { position: absolute; inset: 0; -webkit-mask-image: linear-gradient(90deg, transparent, black 28%), linear-gradient(180deg, black 78%, transparent); mask-image: linear-gradient(90deg, transparent, black 28%), linear-gradient(180deg, black 78%, transparent); -webkit-mask-composite: source-in; mask-composite: intersect; }
  }
  @media (max-width: 559.98px) {
    .founder__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 20px; }
    .founder__facts > div:nth-child(3) { grid-column: 1 / -1; padding-left: 0; border-left: 0; }
    .founder__link { width: 100%; }
  }
</style>
