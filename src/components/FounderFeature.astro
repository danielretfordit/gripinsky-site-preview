---
// Основатель академии (главная, внутри TrustBlock). По мотивам макета заказчицы от 09.10.2026:
// полоса работ учеников, имя с «металлической» второй строкой, цитата с лаймовой чертой, цифры, фото без рамки.
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { assetPath } from '../lib/deployment';
import { workViews } from '../lib/works';

const portrait = assetPath('/images/evgeny-gripinsky-color.webp');
const site = (await getEntry('settings', 'site'))!.data;
const home = (await getEntry('home', 'main'))!.data;
const wv = await workViews();
// Три работы, которых нет в других блоках главной; показываются только при согласии автора
const works = wv.pick(['budnik-osenniy-dom-1', 'filimonova-spalnya', 'bolshunova-ostrov-2']);
// Подпись как в макете: тип работы и автор, без длинного названия
const KIND: Record<string, string> = { 'budnik-osenniy-dom-1': 'Частный дом', 'filimonova-spalnya': 'Интерьер', 'bolshunova-ostrov-2': 'Экстерьер' };
const facts = [
  { value: site.stats.years, label: home.statLabels.years },
  { value: site.stats.graduates, label: home.statLabels.graduates },
  { value: 'Автор методики', label: 'системный подход GRIPINSKY' },
];
---

<section id="founder" class="founder" aria-labelledby="founder-title">
  {works.length > 0 && (
    <div class="founder__works">
      <p class="founder__works-label">Работы наших<br />учеников</p>
      <ul>
        {works.map((w) => (
          <li>
            <Image src={w.image} alt="" widths={[160, 240]} sizes="120px" loading="lazy" style={`object-position:${w.focus}`} />
            <span><span class="founder__work-title">{KIND[w.id] ?? 'Работа ученика'}</span><span class="founder__work-author">{w.author}</span></span>
          </li>
        ))}
      </ul>
      <a href="/gallery" class="founder__works-link"><span>Реальные люди<br />реальные результаты</span> <span class="arrow-long" aria-hidden="true"></span></a>
    </div>
  )}
  <div class="founder__composition">
    <div class="founder__copy">
      <p class="founder__eyebrow t-overline">Основатель академии</p>
      <h2 id="founder-title">Евгений <span>Грипинский</span></h2>
      <p class="founder__lead">20 лет назад Евгений создал обучающую систему, в основе которой системный подход к знаниям, высокие стандарты качества и адресная поддержка каждого студента.</p>
      <blockquote class="quote quote--signal founder__quote">
        <p>«Основная цель занятий — научить вас <strong>думать</strong>, а не повторять действия»</p>
      </blockquote>
      <dl class="facts founder__facts">
        {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value.endsWith('+') ? <>{f.value.slice(0, -1)}<span class="num-plus">+</span></> : f.value}</dd></div>)}
      </dl>
      <a class="btn btn-signal founder__link" href="/teachers">Все педагоги <span class="arrow-long" aria-hidden="true"></span></a>
    </div>
    <div class="founder__portrait"><img src={portrait} alt="Евгений Грипинский" width="764" height="1036" loading="lazy" decoding="async" /></div>
    <div class="rail founder__rail" aria-hidden="true">
      <p>3D<br />люди<br />знания<br />развитие<br />реальные<br />результаты</p>
      <p><strong>GRIPINSKY<br />academy</strong><br /><br />больше<br />чем обучение</p>
    </div>
  </div>
</section>

<style>
  .founder { position: relative; }

  /* Полоса работ: живое доказательство рядом с человеком */
  .founder__works { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; padding-bottom: 20px; border-bottom: 1px solid var(--color-line); }
  .founder__works-label { margin: 0; color: var(--color-muted); font-size: var(--type-label); font-weight: 600; line-height: 1.6; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .founder__works ul { display: grid; grid-auto-columns: minmax(220px, 1fr); grid-auto-flow: column; gap: 0; margin: 0; padding: 0; overflow-x: auto; list-style: none; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .founder__works li { display: flex; align-items: center; gap: 14px; min-width: 0; padding-right: 18px; scroll-snap-align: start; }
  .founder__works li + li { padding-left: 18px; border-left: 1px solid var(--color-line); }
  .founder__works img { flex-shrink: 0; width: clamp(84px, 7vw, 108px); height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-media); }
  .founder__works li > span { display: flex; flex-direction: column; min-width: 0; color: var(--color-muted); font-size: var(--type-small); line-height: 1.4; }
  .founder__work-title { color: var(--color-ink); white-space: nowrap; }
  .founder__work-author { white-space: nowrap; }
  .founder__works-link { display: inline-flex; align-items: center; gap: 24px; min-height: var(--tap); color: var(--color-ink-2); font-size: var(--type-label); font-weight: 600; line-height: 1.6; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .founder__works-link .arrow-long { transition: translate var(--dur) var(--ease-out); }
  @media (hover: hover) { .founder__works-link:hover { color: var(--color-ink); } .founder__works-link:hover .arrow-long { translate: 5px 0; } }
  @media (min-width: 1024px) {
    .founder__works { grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: clamp(20px, 2.5vw, 40px); }
    .founder__works ul { overflow: visible; }
    .founder__works-link { padding-left: clamp(20px, 2.5vw, 40px); border-left: 1px solid var(--color-line); }
  }

  .founder__composition { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); }
  .founder__copy { position: relative; z-index: 1; display: flex; min-width: 0; flex-direction: column; align-items: flex-start; padding: clamp(32px, 4vw, 56px) 0 0; }
  .founder__eyebrow { margin: 0 0 18px; }
  .founder h2 { max-width: 760px; margin: 0 0 24px; color: var(--color-ink); font-size: clamp(2.75rem, 1.6rem + 4.6vw, 5.5rem); font-weight: 800; line-height: .94; letter-spacing: -.045em; text-transform: uppercase; }
  .founder h2 span { display: block; }
  /* Мягкий свет за спиной: блок не плоский */
  .founder__composition::before { position: absolute; inset: 0 0 0 30%; background: var(--glow-studio); content: ""; pointer-events: none; }
  .founder__lead { max-width: 52ch; margin: 0; color: var(--color-ink-2); font-size: var(--type-lead); line-height: 1.55; text-wrap: pretty; }

  .founder__quote { max-width: 600px; margin-top: clamp(26px, 3vw, 36px); }
  .founder__facts { width: 100%; max-width: 640px; margin-top: clamp(28px, 3.4vw, 44px); grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .founder__facts > div:last-child dd { font-size: var(--type-title); line-height: 1.2; text-transform: uppercase; letter-spacing: -.01em; }
  .founder__link { margin-top: clamp(28px, 3.4vw, 40px); }

  /* Фото без рамки: растворяется в фоне блока, сзади мягкий студийный свет */
  .founder__portrait { position: relative; min-width: 0; aspect-ratio: 4 / 5; max-height: 560px; margin-top: 32px; overflow: hidden; }
  .founder__portrait::before { position: absolute; inset: 10% 5% 0; background: radial-gradient(closest-side, rgb(236 236 230 / .14), transparent); content: ""; }
  .founder__portrait img { position: relative; display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 14%; -webkit-mask-image: linear-gradient(180deg, black 72%, transparent); mask-image: linear-gradient(180deg, black 72%, transparent); }

  @media (min-width: 768px) {
    .founder__composition { grid-template-columns: minmax(0, 1.25fr) minmax(0, .9fr); align-items: stretch; }
    .founder__copy { padding-bottom: clamp(32px, 4vw, 56px); }
    .founder__portrait { aspect-ratio: auto; max-height: none; margin: 0 calc(-1 * var(--trust-pad, 0px)) 0 0; }
    .founder__portrait img { position: absolute; inset: 0; -webkit-mask-image: linear-gradient(90deg, transparent, black 28%), linear-gradient(180deg, black 78%, transparent); mask-image: linear-gradient(90deg, transparent, black 28%), linear-gradient(180deg, black 78%, transparent); -webkit-mask-composite: source-in; mask-composite: intersect; }
  }
  @media (min-width: 1280px) {
    .founder__composition { grid-template-columns: minmax(0, 1.2fr) minmax(0, .85fr) auto; }
    .founder__portrait { margin-right: 0; }
    .founder__rail { padding-block: clamp(32px, 4vw, 56px); }
  }
  @media (max-width: 559.98px) {
    .founder__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 20px; }
    .founder__facts > div:nth-child(3) { grid-column: 1 / -1; padding-left: 0; border-left: 0; }
    .founder__link { width: 100%; }
  }
</style>
