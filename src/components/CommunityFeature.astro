---
interface Text { eyebrow: string; title: string; accent: string; lead: string; cta: string; topics: { title: string; text: string }[] }
// Тексты по умолчанию; на главной приходят из админки («Главная страница», блок «Сообщество»)
const DEFAULT: Text = {
  eyebrow: 'Сообщество академии', title: 'РАСТЁМ В 3D', accent: 'ВМЕСТЕ', cta: 'Узнать о сообществе',
  lead: 'Учёба продолжается и за пределами уроков: встречаемся на эфирах, разбираем работы и следим за успехами друг друга.',
  topics: [
    { title: 'GRIPINSKY TV', text: 'Прямые эфиры по средам: разборы работ учеников и встречи с профессионалами индустрии.' },
    { title: '«Рендер дня»', text: 'Показываем работы учеников и отмечаем лучшие на стримах академии.' },
    { title: 'Люди рядом', text: 'Выпускники, ученики и педагоги остаются на связи и делятся опытом.' },
  ],
};
const { text = DEFAULT } = Astro.props as { text?: Text };
---
<div class="community-feature">
  <div class="community-feature__main">
    <div class="community-feature__copy">
      <p class="community-feature__eyebrow t-overline">{text.eyebrow}</p>
      <h2 id="club-title" class="t-h2">{text.title} <span>{text.accent}</span></h2>
      <p class="community-feature__lead t-lead">{text.lead}</p>
      <a href="/club" class="btn btn-signal">{text.cta} <span class="arrow-long" aria-hidden="true"></span></a>
    </div>
    <div class="community-feature__symbol" aria-hidden="true">
      <span>МЫ</span>
      <small>УЧЕНИКИ / ВЫПУСКНИКИ / ПЕДАГОГИ</small>
    </div>
  </div>
  <div class="community-feature__topics">
    {text.topics.map((t, i) => <div><span class="t-meta">{String(i + 1).padStart(2, '0')}</span><h3 class="t-title">{t.title}</h3><p class="t-body">{t.text}</p></div>)}
  </div>
</div>

<style>
  .community-feature { overflow: hidden; border-block: 1px solid var(--color-line); background: var(--color-bg-2); }
  .community-feature__main { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); }
  .community-feature__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; padding: clamp(24px, 3vw, 40px); }
  .community-feature__eyebrow { color: var(--color-ink-2); }
  .community-feature h2 { max-width: 700px; }
  .community-feature h2 span { display: block; color: var(--color-muted); }
  .community-feature__lead { max-width: 560px; margin-bottom: 6px; }
  .community-feature__symbol { position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; min-height: 320px; border-left: 1px solid var(--color-line); background: var(--color-bg); }
  .community-feature__symbol > span { padding-right: .12em; color: transparent; -webkit-text-stroke: 1px var(--color-dim); font-size: clamp(130px, 17vw, 250px); font-weight: 800; letter-spacing: -.16em; line-height: 1; }
  .community-feature__symbol small { position: absolute; right: 24px; bottom: 20px; color: var(--color-muted); font: 12px/1.5 var(--font-mono); text-align: right; }
  .community-feature__topics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; border-top: 1px solid var(--color-line); padding: 24px clamp(24px, 3vw, 40px) 30px; }
  .community-feature__topics > div { display: grid; align-content: start; gap: 10px; border-top: 1px solid var(--color-line); padding-top: 16px; }
  .community-feature__topics span { color: var(--color-muted); }
  .community-feature__topics h3 { color: var(--color-ink); }
  .community-feature__topics p { max-width: 360px; color: var(--color-ink-2); }
  @media (max-width: 767.98px) {
    .community-feature__main { grid-template-columns: 1fr; }
    .community-feature__symbol { min-height: 180px; border-top: 1px solid var(--color-line); border-left: 0; }
    .community-feature__symbol > span { font-size: clamp(120px, 40vw, 160px); }
  }
  @media (max-width: 559.98px) {
    .community-feature__copy { padding: 24px 20px 30px; }
    .community-feature__topics { grid-template-columns: 1fr; gap: 24px; padding: 24px 20px 30px; }
  }
</style>
