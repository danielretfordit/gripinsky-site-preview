---
// Страница статьи блога. Используется для новых статей (/blog/<id>) и перенесённых с Tilda (/tpost/<slug>).
import { getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CourseCard from './CourseCard.astro';
import { articleLd, ogHref } from '../lib/seo';
import { postHref } from '../lib/blog';

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = (await Promise.all(post.data.related.map((r) => getEntry('courses', r.id)))).filter(Boolean);
const crumbs = [{ name: 'Главная', href: '/' }, { name: 'Блог', href: '/blog' }, { name: post.data.title }];
const og = post.data.cover ? ogHref(`post-${post.id}`) : undefined;
const ld = articleLd({ headline: post.data.title, description: post.data.description, path: postHref(post), image: og ?? ogHref('default'), datePublished: post.data.date });
---
<Base title={`${post.data.title} | Блог GRIPINSKY`} description={post.data.description} ogImage={og} ogType="article" breadcrumbs={crumbs} jsonLd={[ld]} consultContext={`Статья: ${post.data.title}`}>
  <article class="wrap pb-12 pt-5 md:pt-7">
    <Breadcrumbs items={crumbs} class="mb-6" />
    <div class="grid gap-10 md:grid-cols-[8fr_4fr]">
      <div class="post min-w-0 max-w-[760px]">
        <time datetime={post.data.date.toISOString()} class="t-overline">{post.data.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
        <h1 class="t-page-title mb-6 mt-2 normal-case">{post.data.title}</h1>
        <Content />
      </div>
      {headings.length > 2 && (
        <nav aria-label="Содержание статьи" class="hidden self-start md:sticky md:top-[calc(var(--header-h)+16px)] md:block">
          <span class="t-overline">Содержание</span>
          <ul class="t-small m-0 mt-3 flex list-none flex-col gap-2 p-0">{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`} class="text-ink-2 hover:text-white">{h.text}</a></li>)}</ul>
        </nav>
      )}
    </div>
    {related.length > 0 && (
      <section class="mt-14" aria-labelledby="rel-title">
        <h2 id="rel-title" class="t-h3 mb-5">Курсы по теме</h2>
        <div class="grid gap-5 sm:grid-cols-2 md:grid-cols-3">{related.map((c) => <CourseCard course={c!} />)}</div>
      </section>
    )}
  </article>
</Base>
<style is:global>
  .post { overflow-wrap: anywhere; }
  .post h2 { font-size: var(--type-card-title); font-weight: 800; margin: 32px 0 12px; }
  .post h3 { font-size: var(--type-title); font-weight: 700; margin: 24px 0 10px; }
  .post p { margin: 0 0 14px; font-size: var(--type-body); line-height: 1.65; color: var(--color-ink-2); }
  .post ul, .post ol { margin: 0 0 14px; padding-left: 22px; color: var(--color-ink-2); line-height: 1.65; }
  .post p a, .post li a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgb(236 236 230 / 0.45); }
  .post img { display: block; width: 100%; height: auto; margin: 20px 0; border-radius: var(--radius-media); }
  .post hr { margin: 28px 0; border: 0; border-top: 1px solid var(--color-line); }
  .post blockquote { margin: 0 0 14px; padding-left: 16px; border-left: 2px solid var(--color-line-strong); }
</style>
