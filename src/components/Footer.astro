---
import { getEntry } from 'astro:content';
import { assetPath } from '../lib/deployment';

const site = (await getEntry('settings', 'site'))!.data;
// Колонки и подпись редактируются в админке: «Меню и подвал»
const navigation = (await getEntry('navigation', 'main'))!.data;
const cols = navigation.footerColumns;
const external = (href: string) => /^https?:/.test(href);
const social = [
  { href: site.telegramBot, label: 'Telegram: задать вопрос' },
  site.telegramChannel && { href: site.telegramChannel, label: 'Telegram-канал' },
  site.vk && { href: site.vk, label: 'ВКонтакте' },
  site.youtube && { href: site.youtube, label: 'YouTube' },
].filter(Boolean) as { href: string; label: string }[];
const year = new Date().getFullYear();
// На страницах без формы консультации ссылка ведёт к форме на главной
const { consult = true } = Astro.props as { consult?: boolean };
---
<footer id="site-footer" class="wrap t-small border-t border-line pb-10 pt-12 text-muted">
  <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-[1.3fr_1fr_1fr_1fr_1fr]">
    <div class="flex flex-col gap-4">
      <a href="/" aria-label="На главную"><img src={assetPath('/brand/academy.svg')} alt="Академия трёхмерных искусств GRIPINSKY" width="228" height="37" loading="lazy" decoding="async" class="block h-auto w-[228px] max-w-full" /></a>
      <p class="m-0 max-w-[280px] leading-relaxed">{navigation.footerTagline}</p>
      <a href={consult ? '#consult' : '/#consult'} class="link-muted">Бесплатная консультация</a>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.title} class="flex flex-col gap-3">
        <span class="t-overline">{c.title}</span>
        {c.links.map((l) => <a href={l.href} class="text-muted hover:text-white" rel={external(l.href) ? 'noopener' : undefined}>{l.label}</a>)}
      </nav>
    ))}
    <nav aria-label="Связь" class="flex flex-col gap-3">
      <span class="t-overline">Связь</span>
      {social.map((l) => <a href={l.href} class="text-muted hover:text-white" rel="noopener">{l.label}</a>)}
      {site.email && <a href={`mailto:${site.email}`} class="text-muted hover:text-white">{site.email}</a>}
    </nav>
  </div>
  <div class="t-caption mt-10 flex flex-col gap-2 border-t border-line pt-6 leading-relaxed md:flex-row md:justify-between">
    <span>© {year} {site.requisites}</span>
    <span>{site.certificateNote}</span>
  </div>
</footer>
